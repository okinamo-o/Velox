+
+class VeloxSessionRestoreObserver final : public SessionRestoreObserver {
+ public:
+  void OnWillRestoreTab(content::WebContents* web_contents) override {
+    if (!web_contents) {
+      return;
+    }
+    auto& st = GetVeloxState();
+    for (auto it = st.pending_restored_web_contents.begin();
+         it != st.pending_restored_web_contents.end();) {
+      if (!*it) {
+        it = st.pending_restored_web_contents.erase(it);
+      } else {
+        ++it;
+      }
+    }
+    st.pending_restored_web_contents.push_back(web_contents->GetWeakPtr());
+  }
+
+  void OnSessionRestoreFinishedLoadingTabs() override {
+    velox::FlushDeferredSessionRestoreSpacesLayout();
+  }
+};
+
+void EnsureSessionRestoreObserverRegistered() {
+  auto& st = GetVeloxState();
+  if (st.session_restore_observer_registered) {
+    return;
+  }
+  static VeloxSessionRestoreObserver observer;
+  SessionRestore::AddObserver(&observer);
+  st.session_restore_observer_registered = true;
+}
