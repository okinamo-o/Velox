+// key. The corresponding private key must remain in the release operator's
+// Windows certificate store and must never be included in the source tree.
+constexpr char kVeloxManifestPublicKeyInfoHex[] =
+    "30820122300D06092A864886F70D01010105000382010F003082010A0282010100"
+    "BFDECD01714BCF685AB0381DCE1840091AE65D6977E1A8328E0B7FF4FDC0D4958"
+    "4302E9182816E52B448112295FD002ED8D19D3BC7424B6CB41E7BBB6430703C82"
+    "9DEA18563B2C19326505E2FA718ABE0994F17C5FB634590E5490E7D64373421CEE6"
+    "AAD661B31F4DD565A01FBD50FF431C193C95895EFCC0F73F7E4BF8932ED449AF77"
+    "A65E24EC9CBB2398F09501041898999F0773224740791DB7D2E7710E2216F692C5"
+    "04F8E4AC37705342AEE9E2918DBC83FFE95460F68B52F50A49D82E4A13EEC83D33"
+    "D4DCA17FE0FB488F51D5F0449880B34B29B7FA5F559A4C9C5ECC8DB58CB7B5D247"
+    "E8B0A78596CBF061C407BB557265480AF86FE3836CF3DA547850203010001";
+
+bool VerifyManifestSignature(const std::string& version,
+                             const std::string& download_url,
+                             const std::string& sha256,
+                             const std::string& signature) {
+  if (signature.empty() || signature.size() != 344) {
+    LOG(ERROR)
+        << "SECURITY ERROR: Missing or invalid Base64 RSA-2048 manifest signature.";
+    return false;
+  }
+
+  std::optional<std::vector<uint8_t>> signature_bytes =
+      base::Base64Decode(signature);
+  std::vector<uint8_t> public_key_info;
+  if (!signature_bytes || signature_bytes->size() != 256 ||
+      !base::HexStringToBytes(kVeloxManifestPublicKeyInfoHex,
+                              &public_key_info)) {
+    LOG(ERROR) << "SECURITY ERROR: Manifest signature encoding is invalid.";
+    return false;
+  }
+
+  const std::string auth_payload = version + "|" + download_url + "|" + sha256;
+  crypto::SignatureVerifier verifier;
+  if (!verifier.VerifyInit(crypto::SignatureVerifier::RSA_PKCS1_SHA256,
+                           *signature_bytes, public_key_info)) {
+    LOG(ERROR) << "SECURITY ERROR: Manifest signature initialization failed.";
+    return false;
+  }
+  verifier.VerifyUpdate(base::span<const uint8_t>(
+      reinterpret_cast<const uint8_t*>(auth_payload.data()),
+      auth_payload.size()));
+  if (!verifier.VerifyFinal()) {
+    LOG(ERROR) << "SECURITY ERROR: Manifest authentication signature mismatch.";
+    return false;
+  }
+  return true;
+}
+
+typedef LONG(WINAPI* WinVerifyTrustFn)(HWND, GUID*, LPVOID);
+
+bool IsRunningUnderWine() {
+  HMODULE ntdll = ::GetModuleHandleW(L"ntdll.dll");
+  return ntdll && ::GetProcAddress(ntdll, "wine_get_version") != nullptr;
+}
+
+bool VerifyAuthenticodeSignature(const base::FilePath& file_path) {
+  if (IsRunningUnderWine()) {
+    // Under Wine on Linux (e.g. Zorin OS), wintrust.dll lacks the Windows root
+    // store and returns TRUST_E_PROVIDER_UNKNOWN. The package has already been
+    // cryptographically verified via RSA-2048 manifest signature + SHA-256.
+    return true;
+  }
+
+  HMODULE wintrust = ::LoadLibraryW(L"wintrust.dll");
+  if (!wintrust) {
+    LOG(ERROR) << "SECURITY ERROR: wintrust.dll could not be loaded.";
+    return false;
+  }
+  auto win_verify_trust = reinterpret_cast<WinVerifyTrustFn>(
+      ::GetProcAddress(wintrust, "WinVerifyTrust"));
+  if (!win_verify_trust) {
+    ::FreeLibrary(wintrust);
+    LOG(ERROR) << "SECURITY ERROR: WinVerifyTrust proc not found.";
+    return false;
+  }
+
+  WINTRUST_FILE_INFO file_info = {};
+  file_info.cbStruct = sizeof(file_info);
+  file_info.pcwszFilePath = file_path.value().c_str();
+
+  GUID policy_guid = WINTRUST_ACTION_GENERIC_VERIFY_V2;
+
+  WINTRUST_DATA trust_data = {};
+  trust_data.cbStruct = sizeof(trust_data);
+  trust_data.dwUIChoice = WTD_UI_NONE;
+  trust_data.fdwRevocationChecks = WTD_REVOKE_NONE;
+  trust_data.dwUnionChoice = WTD_CHOICE_FILE;
+  trust_data.pFile = &file_info;
+  trust_data.dwStateAction = WTD_STATEACTION_IGNORE;
+
+  LONG status = win_verify_trust(NULL, &policy_guid, &trust_data);
+  ::FreeLibrary(wintrust);
+
+  // Accept trusted root (ERROR_SUCCESS), self-signed root (CERT_E_UNTRUSTEDROOT / CERT_E_CHAINING),
+  // Wine provider status codes (0x800B0001..0x800B0003), or unsigned fallback because the package
+  // SHA-256 has already been cryptographically verified by the pinned RSA-2048 public key in
+  // VerifyManifestSignature.
+  if (status == ERROR_SUCCESS || status == (LONG)0x800B0109L ||
+      status == (LONG)0x800B010AL || status == (LONG)0x800B0100L ||
+      status == (LONG)0x800B0001L || status == (LONG)0x800B0002L ||
+      status == (LONG)0x800B0003L) {
+    return true;
+  }
+
+  LOG(ERROR) << "SECURITY ERROR: Authenticode signature check failed (status: "
+             << status << "). Aborting package execution.";
+  return false;
+}
+
+typedef HRESULT(WINAPI* URLDownloadToFileWFn)(void*, LPCWSTR, LPCWSTR, DWORD, void*);
+
+bool DownloadFile(const std::wstring& url, const base::FilePath& target_path) {
+  base::DeleteFile(target_path);
+  HMODULE urlmon = ::LoadLibraryW(L"urlmon.dll");
+  if (urlmon) {
+    auto fn = reinterpret_cast<URLDownloadToFileWFn>(
+        ::GetProcAddress(urlmon, "URLDownloadToFileW"));
+    if (fn) {
+      HRESULT hr =
+          fn(nullptr, url.c_str(), target_path.value().c_str(), 0, nullptr);
+      ::FreeLibrary(urlmon);
+      if (SUCCEEDED(hr) && base::PathExists(target_path)) {
+        return true;
+      }
+    } else {
+      ::FreeLibrary(urlmon);
+    }
+  }
+
+  // Fallback to curl.exe (built into Windows 10/11 and Wine/Linux) if urlmon fails.
+  base::CommandLine curl_cmd(base::FilePath(L"curl.exe"));
+  curl_cmd.AppendArg("-fsSL");
+  curl_cmd.AppendArg(base::WideToUTF8(url));
+  curl_cmd.AppendArg("-o");
+  curl_cmd.AppendArgPath(target_path);
+  base::LaunchOptions options;
+  options.start_hidden = true;
+  base::Process proc = base::LaunchProcess(curl_cmd, options);
+  if (proc.IsValid()) {
+    int exit_code = -1;
+    if (proc.WaitForExitWithTimeout(base::Minutes(5), &exit_code) &&
+        exit_code == 0 && base::PathExists(target_path)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void EnsureVersionManifestFile(const base::FilePath& dir,
+                               const std::string& version_str) {
+  base::FilePath manifest_path = dir.AppendASCII(version_str + ".manifest");
+  if (!base::PathExists(manifest_path)) {
+    std::string manifest_xml =
+        "<assembly\r\n"
+        "  xmlns='urn:schemas-microsoft-com:asm.v1' manifestVersion='1.0'>\r\n"
+        "  <assemblyIdentity\r\n"
+        "      name='" +
+        version_str +
+        "'\r\n"
+        "      version='" +
+        version_str +
+        "'\r\n"
+        "      type='win32'/>\r\n"
+        "  <file name='chrome_elf.dll'/>\r\n"
+        "</assembly>\r\n";
+    base::WriteFile(manifest_path, manifest_xml);
+  }
+}
+
+bool StageInstalledBinaries(const base::Version& target_version) {
+  if (!target_version.IsValid()) {
+    return false;
+  }
+
+  base::FilePath exe_dir;
+  if (!base::PathService::Get(base::DIR_EXE, &exe_dir)) {
+    return false;
+  }
+
+  const std::string ver_str = target_version.GetString();
+  base::FilePath app_dir = exe_dir;
+  base::FilePath target_ver_dir = exe_dir.AppendASCII(ver_str);
+
+  if (!base::PathExists(target_ver_dir.Append(L"chrome.dll"))) {
+    base::FilePath local_app_data;
+    if (base::PathService::Get(base::DIR_LOCAL_APP_DATA, &local_app_data)) {
+      base::FilePath default_app_dir =
+          local_app_data.Append(L"Velox").Append(L"Application");
+      base::FilePath alt_ver_dir = default_app_dir.AppendASCII(ver_str);
+      if (base::PathExists(alt_ver_dir.Append(L"chrome.dll"))) {
+        app_dir = default_app_dir;
+        if (app_dir != exe_dir) {
+          base::CopyDirectory(alt_ver_dir, target_ver_dir, true);
+        }
+      }
+    }
+  }
+
+  if (!base::PathExists(target_ver_dir.Append(L"chrome.dll"))) {
+    return false;
+  }
+
+  EnsureVersionManifestFile(target_ver_dir, ver_str);
+  // Ensure no root-level manifest exists in exe_dir when using a versioned
+  // subdirectory, so Windows SxS resolves chrome_elf.dll inside target_ver_dir.
+  if (!base::PathExists(exe_dir.Append(L"chrome.dll"))) {
+    base::DeleteFile(exe_dir.AppendASCII(ver_str + ".manifest"));
+  }
+
+  // If running from a flat Portable/Wine directory (where chrome.dll is also in
+  // exe_dir), stage the updated core files into exe_dir as well.
+  if (base::PathExists(exe_dir.Append(L"chrome.dll"))) {
+    static constexpr const wchar_t* kPortableCoreFiles[] = {
+        L"chrome.dll",
+        L"chrome_elf.dll",
+        L"resources.pak",
+        L"chrome_100_percent.pak",
+        L"chrome_200_percent.pak",
+        L"icudtl.dat",
+        L"v8_context_snapshot.bin",
+    };
+    for (const wchar_t* fname : kPortableCoreFiles) {
+      base::FilePath src_file = target_ver_dir.Append(fname);
+      base::FilePath dst_file = exe_dir.Append(fname);
+      base::FilePath old_file =
+          exe_dir.Append(std::wstring(L"old_") + fname);
+      if (base::PathExists(src_file)) {
+        ::MoveFileExW(dst_file.value().c_str(), old_file.value().c_str(),
+                      MOVEFILE_REPLACE_EXISTING);
+        base::CopyFile(src_file, dst_file);
+      }
+    }
+  }
+
+  // Ensure the new executable is swapped into chrome.exe and velox.exe in exe_dir
+  // so that Relaunch (or closing and reopening the browser) launches the new build.
+  base::FilePath source_new_exe;
+  if (base::PathExists(exe_dir.Append(L"new_chrome.exe"))) {
+    source_new_exe = exe_dir.Append(L"new_chrome.exe");
+  } else if (base::PathExists(app_dir.Append(L"new_chrome.exe"))) {
+    source_new_exe = app_dir.Append(L"new_chrome.exe");
+  } else if (app_dir != exe_dir &&
+             base::PathExists(app_dir.Append(L"chrome.exe"))) {
+    source_new_exe = app_dir.Append(L"chrome.exe");
+  }
+
+  base::FilePath chrome_exe = exe_dir.Append(L"chrome.exe");
+  base::FilePath old_chrome_exe = exe_dir.Append(L"old_chrome.exe");
+  base::FilePath velox_exe = exe_dir.Append(L"velox.exe");
+  base::FilePath old_velox_exe = exe_dir.Append(L"old_velox.exe");
+
+  if (!source_new_exe.empty() && base::PathExists(source_new_exe)) {
+    ::MoveFileExW(chrome_exe.value().c_str(), old_chrome_exe.value().c_str(),
+                  MOVEFILE_REPLACE_EXISTING);
+    if (base::CopyFile(source_new_exe, chrome_exe)) {
+      if (base::PathExists(exe_dir.Append(L"new_chrome.exe"))) {
+        base::DeleteFile(exe_dir.Append(L"new_chrome.exe"));
+      }
+    }
+  }
+
+  if (base::PathExists(velox_exe) && base::PathExists(chrome_exe)) {
+    ::MoveFileExW(velox_exe.value().c_str(), old_velox_exe.value().c_str(),
+                  MOVEFILE_REPLACE_EXISTING);
+    base::CopyFile(chrome_exe, velox_exe);
+  }
+
+  // Keep HKCU\Software\Velox\pv in sync.
+  base::win::RegKey key(HKEY_CURRENT_USER, L"Software\\Velox", KEY_SET_VALUE);
+  if (key.Valid()) {
+    key.WriteValue(L"pv", base::UTF8ToWide(target_version.GetString()).c_str());
+  }
+
+  g_velox_update_ready.store(true);
+  return true;
+}
+
+void DownloadAndApplyVeloxUpdate(std::string download_url,
+                                 std::string expected_sha256,
+                                 base::Version target_version) {
+  if (StageInstalledBinaries(target_version)) {
+    g_velox_update_installing.store(false);
+    return;
+  }
+
+  if (!IsTrustedDownloadUrl(download_url)) {
+    LOG(ERROR) << "SECURITY ERROR: Download URL is untrusted: " << download_url;
+    g_velox_update_installing.store(false);
+    return;
+  }
+
+  if (!IsValidSha256Hex(expected_sha256)) {
+    LOG(ERROR) << "SECURITY ERROR: Missing or invalid expected SHA-256 hash: "
+               << expected_sha256;
+    g_velox_update_installing.store(false);
+    return;
+  }
+
+  base::FilePath temp_dir;
+  if (base::GetTempDir(&temp_dir) && !download_url.empty()) {
+    base::FilePath pkg_dir = temp_dir.Append(L"VeloxPkg");
+    base::CreateDirectory(pkg_dir);
+    // Avoid installer-like names so Windows UAC heuristics do not interfere
+    // with the update that the user explicitly started from the toolbar.
+    base::FilePath pkg_file = pkg_dir.Append(L"velox_pkg.exe");
+
+    if (DownloadFile(base::UTF8ToWide(download_url), pkg_file)) {
+      if (VerifyFileSha256(pkg_file, expected_sha256)) {
+        if (VerifyAuthenticodeSignature(pkg_file)) {
+          base::CommandLine cmd(pkg_file);
+          cmd.AppendSwitch("do-not-launch-chrome");
+          base::LaunchOptions options;
+          options.start_hidden = true;
+          base::Process process = base::LaunchProcess(cmd, options);
+          if (process.IsValid()) {
+            int exit_code = -1;
+            if (process.WaitForExit(&exit_code) && exit_code == 0) {
+              StageInstalledBinaries(target_version);
+            } else {
+              LOG(ERROR) << "Velox update package execution failed with exit code: "
+                         << exit_code;
+            }
+          }
+        } else {
+          LOG(ERROR)
+              << "SECURITY ERROR: Downloaded package Authenticode signature "
+                 "verification failed. Execution aborted.";
+        }
+      } else {
+        LOG(ERROR) << "SECURITY ERROR: Downloaded package hash verification failed.";
+      }
+    }
+    // Remove partial downloads and every rejected package as well as packages
+    // that were executed successfully.
+    base::DeleteFile(pkg_file);
+  }
+
+  g_velox_update_installing.store(false);
+}
