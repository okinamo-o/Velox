+                            int render_process_id) override {
+    return url.SchemeIs(content::kVeloxUIScheme) &&
+           url.host() == chrome::kVeloxUIMediaHost;
+  }
+
+  void StartDataRequest(
+      const GURL& url,
+      const content::WebContents::Getter& wc_getter,
+      content::URLDataSource::GotDataCallback callback) override {
+    if (url.path() == "/media.js") {
+      ServeJavaScript(std::move(callback));
+      return;
+    }
+    ServeHtml(std::move(callback));
+  }
+
+ private:
+  void ServeJavaScript(content::URLDataSource::GotDataCallback callback) {
+    std::ostringstream js;
+    js << R"JS(
+(function() {
+  'use strict';
+
+  function badgeHtml(status) {
+    const map = {
+      'Active': 'badge-active',
+      'Available': 'badge-available',
+      'Unsupported': 'badge-unsupported',
+      'Failed': 'badge-failed',
+      'Unknown': 'badge-unknown'
+    };
+    const cls = map[status] || 'badge-unknown';
+    return '<span class="badge ' + cls + '">' + status + '</span>';
+  }
+
+  const probeSpecs = [
+    { name: 'H.264 High 1080p60 SDR', codec: 'video/mp4; codecs="avc1.64002a"', width: 1920, height: 1080, fps: 60 },
+    { name: 'H.264 High 4K60 SDR', codec: 'video/mp4; codecs="avc1.640033"', width: 3840, height: 2160, fps: 60 },
+    { name: 'VP8 1080p30 SDR', codec: 'video/webm; codecs="vp8"', width: 1920, height: 1080, fps: 30 },
+    { name: 'VP9 Profile 0 1080p60 SDR', codec: 'video/webm; codecs="vp09.00.41.08"', width: 1920, height: 1080, fps: 60 },
+    { name: 'VP9 Profile 0 1440p60 SDR', codec: 'video/webm; codecs="vp09.00.50.08"', width: 2560, height: 1440, fps: 60 },
+    { name: 'VP9 Profile 0 4K60 SDR', codec: 'video/webm; codecs="vp09.00.51.08"', width: 3840, height: 2160, fps: 60 },
+    { name: 'VP9 Profile 2 4K60 HDR10 (10-bit)', codec: 'video/webm; codecs="vp09.02.51.10.01.09.16.09.01"', width: 3840, height: 2160, fps: 60 },
+    { name: 'AV1 Main 1080p60 SDR (8-bit)', codec: 'video/mp4; codecs="av01.0.08M.08"', width: 1920, height: 1080, fps: 60 },
+    { name: 'AV1 Main 4K60 SDR (8-bit)', codec: 'video/mp4; codecs="av01.0.13M.08"', width: 3840, height: 2160, fps: 60 },
+    { name: 'AV1 Main 4K60 HDR10 (10-bit)', codec: 'video/mp4; codecs="av01.0.13M.10.0.110.09.16.09.0"', width: 3840, height: 2160, fps: 60 },
+    { name: 'HEVC Main 1080p60 SDR (8-bit)', codec: 'video/mp4; codecs="hev1.1.6.L123.B0"', width: 1920, height: 1080, fps: 60 },
+    { name: 'HEVC Main10 4K60 HDR10 (10-bit)', codec: 'video/mp4; codecs="hev1.2.4.L153.B0"', width: 3840, height: 2160, fps: 60 }
+  ];
+
+  const liveCapabilities = [];
+  const emeCapabilities = [];
+  let latestPlaybackStats = {
+    state: 'Available',
+    source: 'Idle (Ready for test stream or local video)',
+    activeDecoder: 'D3D11VideoDecoder (Standby >= 360p) / Software Fallback',
+    resolution: '0x0',
+    measuredFps: 0,
+    decodedFrames: 0,
+    droppedFrames: 0,
+    corruptedFrames: 0,
+    dropRatePct: 0,
+    fallbackStatus: 'None (Hardware Path Ready)',
+    pipelineError: 'None'
+  };
+
+  async function runMediaCapabilitiesProbes() {
+    const tbody = document.getElementById('mc-probe-body');
+    if (!tbody) return;
+    tbody.innerHTML = '';
+
+    for (const spec of probeSpecs) {
+      const mseSupported = (typeof MediaSource !== 'undefined' && MediaSource.isTypeSupported)
+        ? MediaSource.isTypeSupported(spec.codec)
+        : false;
+      let supported = false;
+      let smooth = false;
+      let powerEfficient = false;
+      let statusLabel = 'Unknown';
+      let decoderPath = 'Unknown';
+
+      if (navigator.mediaCapabilities && navigator.mediaCapabilities.decodingInfo) {
+        try {
+          const info = await navigator.mediaCapabilities.decodingInfo({
+            type: 'media-source',
+            video: {
+              contentType: spec.codec,
+              width: spec.width,
+              height: spec.height,
+              bitrate: spec.width >= 3840 ? 25000000 : 8000000,
+              framerate: spec.fps
+            }
+          });
+          supported = !!info.supported;
+          smooth = !!info.smooth;
+          powerEfficient = !!info.powerEfficient;
+          if (supported) {
+            statusLabel = 'Available';
+            decoderPath = powerEfficient
+              ? 'Hardware (D3D11VideoDecoder / DXVA)'
+              : 'Software Fallback (FFmpeg / libvpx / dav1d)';
+          } else {
+            statusLabel = 'Unsupported';
+            decoderPath = 'None (Not supported on current GPU/build)';
+          }
+        } catch (err) {
+          statusLabel = 'Failed';
+          decoderPath = 'Error: ' + (err && err.message ? err.message : String(err));
+        }
+      }
+
+      liveCapabilities.push({
+        name: spec.name,
+        codec: spec.codec,
+        resolution: spec.width + 'x' + spec.height + '@' + spec.fps,
+        mseSupported: mseSupported,
+        supported: supported,
+        smooth: smooth,
+        powerEfficient: powerEfficient,
+        status: statusLabel,
+        decoderPath: decoderPath
+      });
+
+      const tr = document.createElement('tr');
+      tr.innerHTML =
+        '<td><strong>' + spec.name + '</strong><div class="mono-sub">' + spec.codec + '</div></td>' +
+        '<td>' + spec.width + '&times;' + spec.height + ' @ ' + spec.fps + ' fps</td>' +
+        '<td>' + badgeHtml(mseSupported ? 'Available' : 'Unsupported') + '</td>' +
+        '<td>' + badgeHtml(statusLabel) + '</td>' +
+        '<td>' + (smooth ? '<span class="text-ok">Yes (Smooth)</span>' : '<span class="text-warn">No</span>') + '</td>' +
+        '<td>' + (powerEfficient ? '<span class="text-ok">Yes (HW Power-Efficient)</span>' : '<span class="text-muted">No (SW CPU)</span>') + '</td>' +
+        '<td>' + decoderPath + '</td>';
+      tbody.appendChild(tr);
+    }
+  }
+
+  async function runEmeProbes() {
+    const tbody = document.getElementById('eme-probe-body');
+    if (!tbody) return;
+    tbody.innerHTML = '';
+
+    const systems = [
+      { name: 'W3C ClearKey CDM', keySystem: 'org.w3.clearkey', robustness: '' },
+      { name: 'Google Widevine CDM (SW_SECURE_CRYPTO / L3)', keySystem: 'com.widevine.alpha', robustness: 'SW_SECURE_CRYPTO' },
+      { name: 'Google Widevine CDM (HW_SECURE_ALL / L1)', keySystem: 'com.widevine.alpha', robustness: 'HW_SECURE_ALL' }
+    ];
+
+    for (const sys of systems) {
+      let status = 'Unsupported';
+      let detail = 'CDM not registered or unavailable';
+      if (navigator.requestMediaKeySystemAccess) {
+        try {
+          const config = [{
+            initDataTypes: ['cenc', 'webm'],
+            videoCapabilities: [
+              { contentType: 'video/mp4; codecs="avc1.640028"', robustness: sys.robustness },
+              { contentType: 'video/webm; codecs="vp09.00.41.08"', robustness: sys.robustness }
+            ]
+          }];
+          await navigator.requestMediaKeySystemAccess(sys.keySystem, config);
+          status = 'Available';
+          detail = 'KeySystem access granted (' + (sys.robustness || 'Standard') + ')';
+        } catch (e) {
+          status = 'Unsupported';
+          detail = e && e.message ? e.message : 'Not supported on this system/build';
+        }
+      } else {
+        status = 'Failed';
+        detail = 'Encrypted Media Extensions API unavailable';
+      }
+      emeCapabilities.push({ name: sys.name, keySystem: sys.keySystem, robustness: sys.robustness, status: status, detail: detail });
+      const tr = document.createElement('tr');
+      tr.innerHTML =
+        '<td><strong>' + sys.name + '</strong></td>' +
+        '<td><code>' + sys.keySystem + '</code></td>' +
+        '<td><code>' + (sys.robustness || 'Default') + '</code></td>' +
+        '<td>' + badgeHtml(status) + '</td>' +
+        '<td>' + detail + '</td>';
+      tbody.appendChild(tr);
+    }
+  }
+
+  function initLivePlaybackInspector() {
+    const video = document.getElementById('diag-video');
+    const btnSynth = document.getElementById('btn-start-synth');
+    const btnStop = document.getElementById('btn-stop-probe');
+    const fileInput = document.getElementById('file-video-input');
+    if (!video) return;
+
+    let animId = null;
+    let statsTimer = null;
+    let lastFrames = 0;
+    let lastTime = performance.now();
+    let mediaRecorder = null;
+
+    function updateInspectorUI() {
+      const elState = document.getElementById('live-state');
+      const elDecoder = document.getElementById('live-decoder');
+      const elRes = document.getElementById('live-res');
+      const elFrames = document.getElementById('live-frames');
+      const elDropped = document.getElementById('live-dropped');
+      const elFallback = document.getElementById('live-fallback');
+      const elError = document.getElementById('live-error');
+
+      if (elState) elState.innerHTML = badgeHtml(latestPlaybackStats.state) + ' <span class="mono-sub">' + latestPlaybackStats.source + '</span>';
+      if (elDecoder) elDecoder.textContent = latestPlaybackStats.activeDecoder;
+      if (elRes) elRes.textContent = latestPlaybackStats.resolution + ' @ ' + latestPlaybackStats.measuredFps + ' fps';
+      if (elFrames) elFrames.textContent = latestPlaybackStats.decodedFrames + ' total (' + latestPlaybackStats.corruptedFrames + ' corrupted)';
+      if (elDropped) elDropped.textContent = latestPlaybackStats.droppedFrames + ' dropped (' + latestPlaybackStats.dropRatePct.toFixed(2) + '%)';
+      if (elFallback) elFallback.textContent = latestPlaybackStats.fallbackStatus;
+      if (elError) elError.textContent = latestPlaybackStats.pipelineError;
+    }
+
+    function startStatsLoop(sourceLabel) {
+      if (statsTimer) clearInterval(statsTimer);
+      lastFrames = 0;
+      lastTime = performance.now();
+      statsTimer = setInterval(function() {
+        if (video.error) {
+          latestPlaybackStats.state = 'Failed';
+          latestPlaybackStats.pipelineError = 'MediaError code ' + video.error.code + ': ' + (video.error.message || 'Decode/demux error');
+          latestPlaybackStats.fallbackStatus = 'Fallback triggered or stream failed';
+          updateInspectorUI();
+          return;
+        }
+        const q = video.getVideoPlaybackQuality ? video.getVideoPlaybackQuality() : null;
+        const total = q ? q.totalVideoFrames : (video.webkitDecodedFrameCount || 0);
+        const dropped = q ? q.droppedVideoFrames : (video.webkitDroppedFrameCount || 0);
+        const corrupted = q ? (q.corruptedVideoFrames || 0) : 0;
+        const now = performance.now();
+        const dt = (now - lastTime) / 1000.0;
+        const fps = dt > 0.2 ? Math.round((total - lastFrames) / dt) : latestPlaybackStats.measuredFps;
+        lastFrames = total;
+        lastTime = now;
+
+        const w = video.videoWidth || 0;
+        const h = video.videoHeight || 0;
+        const hwAccelAvailable = window.__VELOX_DIAG_SERVER__ && window.__VELOX_DIAG_SERVER__.gpu && window.__VELOX_DIAG_SERVER__.gpu.videoDecodeStatus === 'Active';
+
+        latestPlaybackStats.state = (!video.paused && !video.ended && total > 0) ? 'Active' : 'Available';
+        latestPlaybackStats.source = sourceLabel;
+        latestPlaybackStats.resolution = w + 'x' + h;
+        latestPlaybackStats.measuredFps = Math.max(0, fps);
+        latestPlaybackStats.decodedFrames = total;
+        latestPlaybackStats.droppedFrames = dropped;
+        latestPlaybackStats.corruptedFrames = corrupted;
+        latestPlaybackStats.dropRatePct = total > 0 ? (100.0 * dropped / total) : 0.0;
+
+        if (h > 0 && h < 360) {
+          latestPlaybackStats.activeDecoder = 'Software Decoder (Resolution < 360p cutoff via ResolutionBasedDecoderPriority)';
+          latestPlaybackStats.fallbackStatus = 'Intentional Software Selection (< 360p efficiency policy)';
+        } else if (hwAccelAvailable) {
+          latestPlaybackStats.activeDecoder = 'D3D11VideoDecoder (Hardware Accelerated >= 360p)';
+          latestPlaybackStats.fallbackStatus = 'None (Primary Hardware Path Active)';
+        } else {
+          latestPlaybackStats.activeDecoder = 'Software Decoder (FFmpeg / libvpx / dav1d)';
+          latestPlaybackStats.fallbackStatus = 'Active Software Fallback (GPU Hardware Decode Unavailable)';
+        }
+        latestPlaybackStats.pipelineError = 'None';
+        updateInspectorUI();
+      }, 500);
+    }
+
+    if (btnSynth) {
+      btnSynth.addEventListener('click', function() {
+        if (animId) cancelAnimationFrame(animId);
+        const canvas = document.createElement('canvas');
+        canvas.width = 1280;
+        canvas.height = 720;
+        const ctx = canvas.getContext('2d');
+        let frame = 0;
+
+        function draw() {
+          frame++;
+          ctx.fillStyle = '#0f172a';
+          ctx.fillRect(0, 0, canvas.width, canvas.height);
+          const x = (frame * 8) % (canvas.width - 160);
+          const grad = ctx.createLinearGradient(x, 0, x + 160, 160);
+          grad.addColorStop(0, '#38bdf8');
+          grad.addColorStop(1, '#818cf8');
+          ctx.fillStyle = grad;
+          ctx.fillRect(x, 220, 160, 160);
+          ctx.fillStyle = '#f8fafc';
+          ctx.font = 'bold 28px Segoe UI, sans-serif';
+          ctx.fillText('VELOX 720p60 Diagnostic Test Stream — Frame #' + frame, 48, 100);
+          ctx.font = '18px monospace';
+          ctx.fillStyle = '#34d399';
+          ctx.fillText('Pipeline: HTMLVideoElement -> CompositorFrameSink -> DirectComposition', 48, 145);
+          animId = requestAnimationFrame(draw);
+        }
+        draw();
+
+        const stream = canvas.captureStream(60);
+        let mime = 'video/webm;codecs=vp9';
+        if (typeof MediaRecorder !== 'undefined') {
+          if (MediaRecorder.isTypeSupported('video/webm;codecs=vp9')) mime = 'video/webm;codecs=vp9';
+          else if (MediaRecorder.isTypeSupported('video/webm;codecs=vp8')) mime = 'video/webm;codecs=vp8';
+          const chunks = [];
+          mediaRecorder = new MediaRecorder(stream, { mimeType: mime, videoBitsPerSecond: 6000000 });
+          mediaRecorder.ondataavailable = function(e) {
+            if (e.data && e.data.size > 0) chunks.push(e.data);
+          };
+          mediaRecorder.onstop = function() {
+            if (animId) { cancelAnimationFrame(animId); animId = null; }
+            const blob = new Blob(chunks, { type: mime });
+            video.srcObject = null;
+            video.src = URL.createObjectURL(blob);
+            video.loop = true;
+            video.play().catch(function(){});
+            startStatsLoop('Synthesized 720p60 Encoded Video (' + mime + ')');
+          };
+          mediaRecorder.start();
+          latestPlaybackStats.source = 'Encoding 2s 720p60 test clip (' + mime + ')...';
+          updateInspectorUI();
+          setTimeout(function() {
+            if (mediaRecorder && mediaRecorder.state === 'recording') {
+              mediaRecorder.stop();
+            }
+          }, 1800);
+        } else {
+          video.srcObject = stream;
+          video.play().catch(function(){});
+          startStatsLoop('Live 720p60 Canvas CaptureStream');
+        }
+      });
+    }
+
+    if (btnStop) {
+      btnStop.addEventListener('click', function() {
+        if (animId) { cancelAnimationFrame(animId); animId = null; }
+        if (statsTimer) { clearInterval(statsTimer); statsTimer = null; }
+        video.pause();
+        video.srcObject = null;
+        video.removeAttribute('src');
+        latestPlaybackStats.state = 'Available';
+        latestPlaybackStats.source = 'Stopped by user';
+        latestPlaybackStats.measuredFps = 0;
+        updateInspectorUI();
+      });
+    }
+
+    if (fileInput) {
+      fileInput.addEventListener('change', function(e) {
+        const file = e.target.files && e.target.files[0];
+        if (!file) return;
+        if (animId) { cancelAnimationFrame(animId); animId = null; }
+        video.srcObject = null;
+        video.src = URL.createObjectURL(file);
+        video.loop = false;
+        video.play().catch(function(){});
+        startStatsLoop('Local File: ' + file.name + ' (' + (file.type || 'video') + ')');
+      });
+    }
+
+    video.addEventListener('error', function() {
+      if (video.error) {
+        latestPlaybackStats.state = 'Failed';
+        latestPlaybackStats.pipelineError = 'MediaError code ' + video.error.code + ': ' + (video.error.message || 'Playback failed');
+        updateInspectorUI();
+      }
+    });
+
+    updateInspectorUI();
+  }
+
+  function buildDiagnosticsPayload() {
+    return {
+      schemaVersion: '1.0.0',
+      generatedAt: new Date().toISOString(),
+      diagnosticUrl: 'velox://media',
+      serverRuntime: window.__VELOX_DIAG_SERVER__ || {},
+      clientRuntime: {
+        userAgent: navigator.userAgent,
+        hardwareConcurrency: navigator.hardwareConcurrency,
+        deviceMemoryGb: navigator.deviceMemory || null,
+        windowDevicePixelRatio: window.devicePixelRatio || 1,
+        colorGamutP3: window.matchMedia ? window.matchMedia('(color-gamut: p3)').matches : false,
+        dynamicRangeHigh: window.matchMedia ? window.matchMedia('(dynamic-range: high)').matches : false,
+        mediaCapabilitiesProbes: liveCapabilities,
+        emeProbes: emeCapabilities,
+        livePlaybackInspector: latestPlaybackStats
+      }
+    };
+  }
+
+  function initExportButtons() {
+    const btnCopy = document.getElementById('btn-copy-json');
+    const btnExport = document.getElementById('btn-export-json');
+    const statusEl = document.getElementById('export-status');
+
+    if (btnCopy) {
+      btnCopy.addEventListener('click', async function() {
+        const json = JSON.stringify(buildDiagnosticsPayload(), null, 2);
+        try {
+          await navigator.clipboard.writeText(json);
+          if (statusEl) statusEl.textContent = 'Copied diagnostic JSON (' + json.length + ' bytes) to clipboard.';
+        } catch (err) {
+          const ta = document.createElement('textarea');
+          ta.value = json;
+          document.body.appendChild(ta);
+          ta.select();
+          document.execCommand('copy');
+          document.body.removeChild(ta);
+          if (statusEl) statusEl.textContent = 'Copied diagnostic JSON to clipboard.';
+        }
+      });
+    }
+
+    if (btnExport) {
+      btnExport.addEventListener('click', function() {
+        const json = JSON.stringify(buildDiagnosticsPayload(), null, 2);
+        const blob = new Blob([json], { type: 'application/json' });
+        const a = document.createElement('a');
+        a.href = URL.createObjectURL(blob);
+        a.download = 'velox-media-diagnostics.json';
+        document.body.appendChild(a);
+        a.click();
+        document.body.removeChild(a);
+        if (statusEl) statusEl.textContent = 'Exported velox-media-diagnostics.json locally.';
+      });
+    }
+  }
+
+  document.addEventListener('DOMContentLoaded', function() {
+    runMediaCapabilitiesProbes();
+    runEmeProbes();
+    initLivePlaybackInspector();
+    initExportButtons();
+  });
+})();
+)JS";
+    std::move(callback).Run(
+        base::MakeRefCounted<base::RefCountedString>(js.str()));
+  }
+
+  void ServeHtml(content::URLDataSource::GotDataCallback callback) {
+    auto* gpu_mgr = content::GpuDataManager::GetInstance();
+    bool gpu_init = gpu_mgr ? gpu_mgr->IsEssentialGpuInfoAvailable() : false;
+    bool hw_accel_enabled =
+        gpu_mgr ? gpu_mgr->HardwareAccelerationEnabled() : false;
+    gpu::GPUInfo gpu_info = gpu_mgr ? gpu_mgr->GetGPUInfo() : gpu::GPUInfo();
+    const auto& active_gpu = gpu_info.active_gpu();
+
+    std::string gpu_vendor_name =
+        GpuVendorNameFromId(active_gpu.vendor_id, gpu_info.gl_vendor);
+    std::string gpu_device_str =
+        !active_gpu.device_string.empty()
+            ? active_gpu.device_string
+            : (!gpu_info.gl_renderer.empty()
+                   ? gpu_info.gl_renderer
+                   : base::StringPrintf("Device 0x%04x", active_gpu.device_id));
+    std::string driver_version = !active_gpu.driver_version.empty()
+                                     ? active_gpu.driver_version
+                                     : "Unknown";
+    std::string driver_vendor = !active_gpu.driver_vendor.empty()
+                                    ? active_gpu.driver_vendor
+                                    : gpu_vendor_name;
+
+    auto status_vdec =
+        gpu_mgr ? gpu_mgr->GetFeatureStatus(
+                      gpu::GPU_FEATURE_TYPE_ACCELERATED_VIDEO_DECODE)
+                : gpu::kGpuFeatureStatusUndefined;
+    auto status_venc =
+        gpu_mgr ? gpu_mgr->GetFeatureStatus(
+                      gpu::GPU_FEATURE_TYPE_ACCELERATED_VIDEO_ENCODE)
+                : gpu::kGpuFeatureStatusUndefined;
+    auto status_gl =
+        gpu_mgr
+            ? gpu_mgr->GetFeatureStatus(gpu::GPU_FEATURE_TYPE_ACCELERATED_GL)
+            : gpu::kGpuFeatureStatusUndefined;
+    auto status_raster =
+        gpu_mgr ? gpu_mgr->GetFeatureStatus(
+                      gpu::GPU_FEATURE_TYPE_GPU_TILE_RASTERIZATION)
+                : gpu::kGpuFeatureStatusUndefined;
+    auto status_canvas =
+        gpu_mgr ? gpu_mgr->GetFeatureStatus(
+                      gpu::GPU_FEATURE_TYPE_CANVAS_OOP_RASTERIZATION)
+                : gpu::kGpuFeatureStatusUndefined;
+    auto status_webgl2 =
+        gpu_mgr ? gpu_mgr->GetFeatureStatus(
+                      gpu::GPU_FEATURE_TYPE_ACCELERATED_WEBGL2)
+                : gpu::kGpuFeatureStatusUndefined;
+    auto status_webgpu =
+        gpu_mgr ? gpu_mgr->GetFeatureStatus(
+                      gpu::GPU_FEATURE_TYPE_ACCELERATED_WEBGPU)
+                : gpu::kGpuFeatureStatusUndefined;
+
+    bool vdec_has_profiles =
+        !gpu_info.video_decode_accelerator_supported_profiles.empty();
+    DiagnosticBadge badge_vdec = FeatureStatusToDiagnostic(
+        status_vdec, gpu_init, hw_accel_enabled && vdec_has_profiles);
+    DiagnosticBadge badge_venc = FeatureStatusToDiagnostic(
+        status_venc, gpu_init,
+        hw_accel_enabled &&
+            !gpu_info.video_encode_accelerator_supported_profiles.empty());
+    DiagnosticBadge badge_gl =
+        FeatureStatusToDiagnostic(status_gl, gpu_init, hw_accel_enabled);
+    DiagnosticBadge badge_raster =
+        FeatureStatusToDiagnostic(status_raster, gpu_init, hw_accel_enabled);
+    DiagnosticBadge badge_canvas =
+        FeatureStatusToDiagnostic(status_canvas, gpu_init, hw_accel_enabled);
+    DiagnosticBadge badge_webgl2 =
+        FeatureStatusToDiagnostic(status_webgl2, gpu_init, hw_accel_enabled);
+    DiagnosticBadge badge_webgpu =
+        FeatureStatusToDiagnostic(status_webgpu, gpu_init, false);
+
+    // Inspect hardware decode profiles per codec family.
+    bool hw_h264 = false, hw_vp8 = false, hw_vp9 = false, hw_av1 = false,
+         hw_hevc = false;
+    gfx::Size max_h264, max_vp8, max_vp9, max_av1, max_hevc;
+    for (const auto& p : gpu_info.video_decode_accelerator_supported_profiles) {
+      std::string fam = ProfileToCodecFamily(p.profile);
+      if (fam == "H.264 / AVC") {
+        hw_h264 = true;
+        if (p.max_resolution.GetArea() > max_h264.GetArea())
+          max_h264 = p.max_resolution;
+      } else if (fam == "VP8") {
+        hw_vp8 = true;
+        if (p.max_resolution.GetArea() > max_vp8.GetArea())
+          max_vp8 = p.max_resolution;
+      } else if (fam == "VP9") {
+        hw_vp9 = true;
+        if (p.max_resolution.GetArea() > max_vp9.GetArea())
+          max_vp9 = p.max_resolution;
+      } else if (fam == "AV1") {
