diff --git a/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc b/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
index f5c0db2d1b..3959336464 100644
--- a/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
+++ b/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
@@ -9,7 +9,25 @@
 namespace blink {
 
 unsigned NavigatorConcurrentHardware::hardwareConcurrency() const {
-  return static_cast<unsigned>(base::SysInfo::NumberOfProcessors());
+  // VELOX Adaptive Hardware Concurrency: Bucket actual logical processor count
+  // into standard hardware tiers {2, 4, 8, 12, 16}. This prevents low-end 2/4
+  // core CPUs from being oversubscribed by 8 media/WASM worker threads, allows
+  // high-end CPUs to scale 4K60 MSE/decode pools, and still normalizes odd core
+  // counts to limit fingerprinting entropy.
+  int procs = base::SysInfo::NumberOfProcessors();
+  if (procs <= 2) {
+    return 2u;
+  }
+  if (procs <= 4) {
+    return 4u;
+  }
+  if (procs <= 8) {
+    return 8u;
+  }
+  if (procs <= 12) {
+    return 12u;
+  }
+  return 16u;
 }
 
 }  // namespace blink
