+  std::string detail;
+};
+
+DiagnosticBadge FeatureStatusToDiagnostic(gpu::GpuFeatureStatus status,
+                                          bool gpu_initialized,
+                                          bool is_currently_active = false) {
+  if (!gpu_initialized) {
+    return {"Unknown", "badge-unknown",
+            "GPU info collection pending initialization"};
+  }
+  switch (status) {
+    case gpu::kGpuFeatureStatusEnabled:
+      if (is_currently_active) {
+        return {"Active", "badge-active",
+                "Hardware acceleration active in GPU process"};
+      }
+      return {"Available", "badge-available",
+              "Hardware path verified and ready"};
+    case gpu::kGpuFeatureStatusBlocklisted:
+      return {"Failed", "badge-failed",
+              "Blocklisted by GPU driver compatibility rules (software fallback)"};
+    case gpu::kGpuFeatureStatusDisabled:
+      return {"Unsupported", "badge-unsupported",
+              "Disabled by configuration or unsupported on platform"};
+    case gpu::kGpuFeatureStatusSoftware:
+      return {"Unsupported", "badge-warning",
+              "Software-only path active (hardware acceleration unavailable)"};
+    case gpu::kGpuFeatureStatusUndefined:
+    case gpu::kGpuFeatureStatusMax:
+      return {"Unknown", "badge-unknown", "Status not reported by GPU manager"};
+  }
+  return {"Unknown", "badge-unknown", "Unrecognized status"};
+}
