+std::string ProfileToCodecFamily(gpu::VideoCodecProfile profile) {
+  if (profile >= gpu::H264PROFILE_BASELINE &&
+      profile <= gpu::H264PROFILE_MULTIVIEWHIGH) {
+    return "H.264 / AVC";
+  }
+  if (profile == gpu::VP8PROFILE_ANY) {
+    return "VP8";
+  }
+  if (profile >= gpu::VP9PROFILE_PROFILE0 &&
+      profile <= gpu::VP9PROFILE_PROFILE3) {
+    return "VP9";
+  }
+  if (profile >= gpu::AV1PROFILE_PROFILE_MAIN &&
+      profile <= gpu::AV1PROFILE_PROFILE_PRO) {
+    return "AV1";
+  }
+  if ((profile >= gpu::HEVCPROFILE_MAIN &&
+       profile <= gpu::HEVCPROFILE_MAIN_STILL_PICTURE) ||
+      (profile >= gpu::HEVCPROFILE_REXT &&
+       profile <= gpu::HEVCPROFILE_HIGH_THROUGHPUT_SCREEN_EXTENDED)) {
+    return "HEVC / H.265";
+  }
+  if (profile == gpu::DOLBYVISION_PROFILE0 ||
+      profile == gpu::DOLBYVISION_PROFILE5 ||
+      profile == gpu::DOLBYVISION_PROFILE7 ||
+      profile == gpu::DOLBYVISION_PROFILE8 ||
+      profile == gpu::DOLBYVISION_PROFILE9) {
+    return "Dolby Vision";
+  }
+  if (profile >= gpu::VVCPROFILE_MAIN10 &&
+      profile <= gpu::VVCPROFILE_MAIN16_444_STILL_PICTURE) {
+    return "VVC / H.266";
+  }
+  return "Other";
+}
