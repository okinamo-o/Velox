+std::string GpuVendorNameFromId(uint32_t vendor_id,
+                                const std::string& fallback) {
+  switch (vendor_id) {
+    case 0x10de:
+      return "NVIDIA Corporation";
+    case 0x1002:
+    case 0x1022:
+      return "AMD / ATI Technologies";
+    case 0x8086:
+      return "Intel Corporation";
+    case 0x1414:
+      return "Microsoft (WARP / Basic Render)";
+    case 0x5143:
+    case 0x4d4f4351:
+      return "Qualcomm";
+    case 0x106b:
+      return "Apple";
+    default:
+      if (!fallback.empty()) {
+        return fallback;
+      }
+      return vendor_id ? base::StringPrintf("Vendor 0x%04x", vendor_id)
+                       : "Unknown Vendor";
+  }
+}
