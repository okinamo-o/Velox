+#include "ui/views/focus/focus_manager.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_delegate.h"
+
+namespace {
+
+constexpr int kTopBarOvershootBuffer = 10;  // 10px buffer below top bar before hiding
+constexpr int kSlideDurationMs = 280;       // Buttery-smooth slide animation speed
+constexpr int kHideDebounceDelayMs = 280;   // Debounce before sliding back up
+constexpr int kNotificationPeekDurationMs = 3500;  // Notification peek duration (3.5s)
+}  // namespace
+
+VeloxAutoHideController::VeloxAutoHideController(BrowserView* browser_view)
+    : browser_view_(browser_view) {
+  slide_animation_ = std::make_unique<gfx::SlideAnimation>(this);
+  slide_animation_->SetSlideDuration(base::Milliseconds(kSlideDurationMs));
+  slide_animation_->SetTweenType(gfx::Tween::FAST_OUT_SLOW_IN);
+  slide_animation_->Reset(0.0);
+  reveal_fraction_ = 0.0;
+}
+
+VeloxAutoHideController::~VeloxAutoHideController() {
+  CleanUp();
+}
+
+void VeloxAutoHideController::Init() {
+  if (!browser_view_ || !browser_view_->GetWidget()) {
+    return;
+  }
+
+  views::Widget* widget = browser_view_->GetWidget();
+  if (widget && !widget_observation_.IsObserving()) {
+    widget_observation_.Observe(widget);
+  }
+  if (widget && widget->GetNativeView()) {
+    views::Widget::Widgets owned_widgets;
+    views::Widget::GetAllOwnedWidgets(widget->GetNativeView(), &owned_widgets);
+    for (views::Widget* owned : owned_widgets) {
+      ObserveChildWidget(owned);
+    }
+  }
+
+  // Create event monitor for mouse movements across the application.
+  if (!event_monitor_ && browser_view_->GetNativeWindow()) {
+    event_monitor_ = views::EventMonitor::CreateApplicationMonitor(
+        this, browser_view_->GetNativeWindow(),
+        {ui::EventType::kMouseMoved, ui::EventType::kMousePressed,
+         ui::EventType::kMouseReleased, ui::EventType::kMouseExited,
+         ui::EventType::kKeyPressed});
+  }
+
+  // Register focus change listener to keep the bar revealed while typing.
+  if (!focus_manager_ && widget) {
+    focus_manager_ = widget->GetFocusManager();
+    if (focus_manager_) {
+      focus_manager_->AddFocusChangeListener(this);
+    }
+  }
+
+  // Register notification service observer (only for non-OTR profiles).
+  if (browser_view_->browser() && browser_view_->browser()->profile() &&
+      !browser_view_->browser()->profile()->IsOffTheRecord()) {
+    auto* notif_service = NotificationDisplayServiceFactory::GetForProfile(
+        browser_view_->browser()->profile());
+    if (notif_service && !notification_observation_.IsObserving()) {
+      notification_observation_.Observe(notif_service);
+    }
+  }
+
+  // Normal browser window initialized: enable auto-hide.
+  is_enabled_ = true;
+
+  // Continuously poll mouse position to detect top edge hover reliably.
+  if (is_enabled_ && !mouse_poll_timer_.IsRunning()) {
+    mouse_poll_timer_.Start(
+        FROM_HERE, base::Milliseconds(60),
+        base::BindRepeating(&VeloxAutoHideController::CheckMousePosition,
+                            weak_factory_.GetWeakPtr()));
+  }
+}
+
+void VeloxAutoHideController::CleanUp() {
+  is_enabled_ = false;
+  mouse_poll_timer_.Stop();
+  notification_peek_timer_.Stop();
+  hide_debounce_timer_.Stop();
+  toast_dismiss_timer_.Stop();
+  DismissFullscreenVideoToast();
+  notification_observation_.Reset();
+  event_monitor_.reset();
+  if (focus_manager_) {
+    focus_manager_->RemoveFocusChangeListener(this);
+    focus_manager_ = nullptr;
+  }
+  child_widget_observations_.RemoveAllObservations();
+  child_widgets_.clear();
+  widget_observation_.Reset();
+}
+
+bool VeloxAutoHideController::IsEnabled() const {
+  return is_enabled_;
+}
+
+void VeloxAutoHideController::SetEnabled(bool enabled) {
+  if (is_enabled_ == enabled) {
+    return;
+  }
+  is_enabled_ = enabled;
+  notification_peek_in_progress_ = false;
+  notification_peek_timer_.Stop();
+  hide_debounce_timer_.Stop();
+
+  if (!is_enabled_) {
+    mouse_poll_timer_.Stop();
+    slide_animation_->Reset(1.0);
+    reveal_fraction_ = 1.0;
+  } else {
+    if (!mouse_poll_timer_.IsRunning()) {
+      mouse_poll_timer_.Start(
+          FROM_HERE, base::Milliseconds(60),
+          base::BindRepeating(&VeloxAutoHideController::CheckMousePosition,
+                              weak_factory_.GetWeakPtr()));
+    }
+    slide_animation_->Reset(0.0);
+    reveal_fraction_ = 0.0;
+    mouse_hovering_ = false;
+  }
+
+  if (browser_view_ && browser_view_->GetWidget()) {
+    browser_view_->InvalidateLayout();
+    browser_view_->GetWidget()->GetRootView()->DeprecatedLayoutImmediately();
+    if (browser_view_->top_container()) {
+      browser_view_->top_container()->SchedulePaint();
+    }
+  }
+}
+
+void VeloxAutoHideController::ToggleEnabled() {
+  SetEnabled(!is_enabled_);
+}
+
+double VeloxAutoHideController::GetRevealFraction() const {
+  return is_enabled_ ? reveal_fraction_ : 1.0;
+}
+
+bool VeloxAutoHideController::IsRevealed() const {
+  return !is_enabled_ || reveal_fraction_ > 0.0;
+}
+
+void VeloxAutoHideController::Reveal(bool animate) {
+  if (!is_enabled_) {
+    return;
+  }
+  hide_debounce_timer_.Stop();
+
+  if (browser_view_ && browser_view_->top_container() &&
+      browser_view_->top_container()->layer() &&
+      browser_view_->top_container()->layer()->parent()) {
+    browser_view_->top_container()->layer()->parent()->StackAtTop(
+        browser_view_->top_container()->layer());
+    if (browser_view_->frame() && browser_view_->frame()->GetFrameView()) {
+      browser_view_->frame()->GetFrameView()->EnsureCaptionButtonsOnTop();
+    }
+  }
+
+  if (!mouse_poll_timer_.IsRunning()) {
+    mouse_poll_timer_.Start(
+        FROM_HERE, base::Milliseconds(60),
+        base::BindRepeating(&VeloxAutoHideController::CheckMousePosition,
+                            weak_factory_.GetWeakPtr()));
+  }
+
+  if (!animate) {
+    slide_animation_->Reset(1.0);
+    reveal_fraction_ = 1.0;
+    UpdateTopContainerPosition();
+    if (browser_view_) {
+      browser_view_->InvalidateLayout();
+    }
+    return;
+  }
+
+  if (slide_animation_->IsShowing() || reveal_fraction_ >= 1.0) {
+    return;
+  }
+  slide_animation_->Show();
+}
+
+void VeloxAutoHideController::Hide(bool animate) {
+  if (!is_enabled_ || !CanHide()) {
+    return;
+  }
+
+  if (!animate) {
+    slide_animation_->Reset(0.0);
+    reveal_fraction_ = 0.0;
+    UpdateTopContainerPosition();
+    if (browser_view_) {
+      browser_view_->InvalidateLayout();
+    }
+    return;
+  }
+
+  if (slide_animation_->IsClosing() || reveal_fraction_ <= 0.0) {
+    return;
+  }
+  slide_animation_->Hide();
+}
+
+bool VeloxAutoHideController::CanHide() const {
+  if (!is_enabled_) {
+    return false;
+  }
+  if (notification_peek_in_progress_) {
+    return false;
+  }
+  if (mouse_hovering_) {
+    return false;
+  }
+  // Keep revealed if user is actively interacting with the top bar (tabs, toolbar, omnibox)
+  if (browser_view_ && browser_view_->top_container()) {
+    views::FocusManager* fm = browser_view_->GetFocusManager();
+    views::View* focused = fm ? fm->GetFocusedView() : nullptr;
+    if (focused && browser_view_->top_container()->Contains(focused)) {
+      return false;
+    }
+  }
+  // If a context menu or popup menu is active, keep top bar visible
+  if (views::MenuController::GetActiveInstance()) {
+    return false;
+  }
+  // If tabs are currently being dragged, keep top bar visible
+  if (browser_view_ && browser_view_->tabstrip()) {
+    auto* drag_context = browser_view_->tabstrip()->GetDragContext();
+    if (drag_context && drag_context->IsDragSessionActive()) {
+      return false;
+    }
+  }
+  // Keep top bar visible while user is selecting the second tab for split view
+  if (browser_view_ && browser_view_->browser() &&
+      browser_view_->browser()->tab_strip_model() &&
+      browser_view_->browser()->tab_strip_model()->IsSplitSelectionActive()) {
+    return false;
+  }
+  // Keep top bar revealed while a header-anchored bubble, popup, or omnibox
+  // dropdown is open so interacting with it never leaves it floating alone.
+  if (HasActiveHeaderPopupOrBubble()) {
+    return false;
+  }
+  return true;
+}
+
+void VeloxAutoHideController::ObserveChildWidget(views::Widget* child_widget) {
+  if (!child_widget || child_widget == fullscreen_toast_widget_ ||
+      (browser_view_ && child_widget == browser_view_->GetWidget()) ||
+      child_widget->IsClosed()) {
+    return;
+  }
+  if (!child_widget_observations_.IsObservingSource(child_widget)) {
+    child_widget_observations_.AddObservation(child_widget);
+  }
+  child_widgets_.insert(child_widget);
+}
+
+void VeloxAutoHideController::UnobserveChildWidget(
+    views::Widget* child_widget) {
+  if (!child_widget) {
+    return;
+  }
+  child_widgets_.erase(child_widget);
+  if (child_widget_observations_.IsObservingSource(child_widget)) {
+    child_widget_observations_.RemoveObservation(child_widget);
+  }
+}
+
+bool VeloxAutoHideController::IsHeaderRelatedWidget(const views::Widget* widget,
+                                                    int depth) const {
+  if (depth > 8 || !widget || !browser_view_ ||
+      widget == fullscreen_toast_widget_ ||
+      widget == browser_view_->GetWidget() || widget->IsClosed() ||
+      !widget->IsVisible()) {
+    return false;
+  }
+
+  // Exclude non-header browser overlays so link hover previews and in-page
+  // find don't pin the auto-hide bar open.
+  const std::string& name = widget->GetName();
+  if (name == "StatusBubble" || name == "FindBarHost") {
+    return false;
+  }
+
+  // Exclude web-contents modal dialogs (alert(), HTTP auth, file prompts).
+  const views::WidgetDelegate* delegate = widget->widget_delegate();
+  if (delegate && delegate->GetModalType() == ui::mojom::ModalType::kChild) {
+    return false;
+  }
+
+  if (name == "RoundedOmniboxResultsFrame") {
+    return true;
+  }
+
+  if (widget->GetNativeWindow() &&
+      widget->GetNativeWindow()->GetType() == aura::client::WINDOW_TYPE_MENU) {
+    return true;
+  }
+
+  if (delegate) {
+    if (auto* bubble = const_cast<views::WidgetDelegate*>(delegate)
+                           ->AsBubbleDialogDelegate()) {
+      const views::View* anchor = bubble->GetAnchorView();
+      if (anchor) {
+        if (browser_view_->top_container() &&
+            browser_view_->top_container()->Contains(anchor)) {
+          return true;
+        }
+        const views::Widget* anchor_widget = anchor->GetWidget();
+        if (anchor_widget && anchor_widget != browser_view_->GetWidget() &&
+            child_widgets_.contains(
+                const_cast<views::Widget*>(anchor_widget))) {
+          return IsHeaderRelatedWidget(anchor_widget, depth + 1);
+        }
+      } else if (bubble->anchor_widget() == browser_view_->GetWidget() &&
+                 browser_view_->top_container()) {
+        gfx::Rect top_bounds =
+            browser_view_->top_container()->GetBoundsInScreen();
+        top_bounds.Inset(gfx::Insets::TLBR(-8, 0, -24, 0));
+        if (bubble->GetAnchorRect().Intersects(top_bounds)) {
+          return true;
+        }
+      }
+    }
+  }
+
+  // Inherit header affinity for nested popups (e.g., <select> or sub-dialogs)
+  // opened from inside a tracked header bubble.
+  const views::Widget* parent = const_cast<views::Widget*>(widget)->parent();
+  if (parent && parent != browser_view_->GetWidget() &&
+      child_widgets_.contains(const_cast<views::Widget*>(parent))) {
+    return IsHeaderRelatedWidget(parent, depth + 1);
+  }
+
+  return false;
+}
+
+bool VeloxAutoHideController::HasActiveHeaderPopupOrBubble() const {
+  if (browser_view_) {
+    if (LocationBarView* location_bar = browser_view_->GetLocationBarView()) {
+      if (const OmniboxViewViews* omnibox = location_bar->omnibox_view();
+          omnibox && omnibox->model() && omnibox->model()->PopupIsOpen()) {
+        return true;
+      }
+    }
+  }
+
+  for (views::Widget* child : child_widgets_) {
+    if (IsHeaderRelatedWidget(child)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool VeloxAutoHideController::IsCursorOverHeaderPopup(
+    const gfx::Point& screen_loc) const {
+  for (views::Widget* child : child_widgets_) {
+    if (IsHeaderRelatedWidget(child) &&
+        child->GetWindowBoundsInScreen().Contains(screen_loc)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool VeloxAutoHideController::IsCursorOverTopBar(const gfx::Point& screen_loc,
+                                                 bool* out_at_top_edge) const {
+  display::Screen* screen = display::Screen::GetScreen();
+  if (!browser_view_ || !screen || !browser_view_->GetNativeWindow()) {
+    if (out_at_top_edge) {
+      *out_at_top_edge = false;
+    }
+    return false;
+  }
+
+  gfx::Point view_loc = screen_loc;
+  views::View::ConvertPointFromScreen(browser_view_, &view_loc);
+
+  int width = browser_view_->width();
+  int bar_height = browser_view_->top_container()
+                       ? browser_view_->top_container()->height()
+                       : 70;
+
+  display::Display display =
+      screen->GetDisplayNearestWindow(browser_view_->GetNativeWindow());
+  int monitor_top = display.bounds().y();
+
+  bool is_maximized = browser_view_->IsMaximized();
+  bool within_x = view_loc.x() >= -15 && view_loc.x() <= width + 15;
+  bool at_top_edge = false;
+  if (is_maximized) {
+    at_top_edge = within_x && (screen_loc.y() <= monitor_top + 1 &&
+                               screen_loc.y() >= monitor_top - 5);
+  } else {
+    at_top_edge = within_x && (view_loc.y() >= -10 && view_loc.y() <= 1);
+  }
+  if (out_at_top_edge) {
+    *out_at_top_edge = at_top_edge;
+  }
+
+  int visible_bar_height = static_cast<int>(bar_height * reveal_fraction_);
+  bool over_top_bar = within_x && view_loc.y() >= -25 &&
+                      view_loc.y() <= visible_bar_height + kTopBarOvershootBuffer;
+  return at_top_edge || (reveal_fraction_ > 0.0 && over_top_bar);
+}
+
+void VeloxAutoHideController::ScheduleHideIfNeeded() {
+  if (!is_enabled_ || reveal_fraction_ <= 0.0) {
+    return;
+  }
+  if (!hide_debounce_timer_.IsRunning() && CanHide()) {
+    hide_debounce_timer_.Start(
+        FROM_HERE, base::Milliseconds(kHideDebounceDelayMs),
+        base::BindOnce(&VeloxAutoHideController::Hide,
+                       weak_factory_.GetWeakPtr(), true));
+  }
+}
+
+void VeloxAutoHideController::CheckMousePosition() {
+  if (!is_enabled_ || !browser_view_ || !browser_view_->GetWidget() ||
+      !display::Screen::GetScreen()) {
+    return;
+  }
+  // Only check if window is visible and not minimized
+  if (!browser_view_->GetWidget()->IsVisible() ||
+      browser_view_->GetWidget()->IsMinimized()) {
+    return;
+  }
+  if (browser_view_->IsFullscreen()) {
+    return;
+  }
+
+  gfx::Point screen_loc =
+      display::Screen::GetScreen()->GetCursorScreenPoint();
+  bool at_top_edge = false;
+  bool over_top_bar = IsCursorOverTopBar(screen_loc, &at_top_edge);
+  bool over_header_popup =
+      reveal_fraction_ > 0.0 && IsCursorOverHeaderPopup(screen_loc);
+
+  if (over_top_bar || over_header_popup) {
+    mouse_hovering_ = true;
+    hide_debounce_timer_.Stop();
+    if (at_top_edge && reveal_fraction_ < 1.0) {
+      Reveal(true);
+    }
+  } else {
+    mouse_hovering_ = false;
+    ScheduleHideIfNeeded();
+  }
+}
+
+void VeloxAutoHideController::OnEvent(const ui::Event& event) {
+  if (!browser_view_ || !browser_view_->GetWidget() ||
+      !display::Screen::GetScreen()) {
+    return;
+  }
+
+  // Intercept F10 application-wide before child views or WebContents consume it.
+  if (event.type() == ui::EventType::kKeyPressed) {
+    const ui::KeyEvent* key_event = event.AsKeyEvent();
+    if (key_event && key_event->key_code() == ui::VKEY_F10) {
+      ToggleEnabled();
+      return;
+    }
+  }
+
+  if (!is_enabled_) {
+    return;
+  }
+
+  if (browser_view_->IsFullscreen()) {
+    return;
+  }
+
+  if (event.type() == ui::EventType::kMouseExited) {
+    gfx::Point screen_loc =
+        display::Screen::GetScreen()->GetCursorScreenPoint();
+    if (IsCursorOverTopBar(screen_loc) ||
+        (reveal_fraction_ > 0.0 && IsCursorOverHeaderPopup(screen_loc))) {
+      // Moving from the browser HWND into a header-anchored popup/bubble HWND
+      // fires kMouseExited on the browser window; keep the header revealed.
+      mouse_hovering_ = true;
+      hide_debounce_timer_.Stop();
+      return;
+    }
+    mouse_hovering_ = false;
+    ScheduleHideIfNeeded();
+    return;
+  }
+
+  if (!event.IsMouseEvent()) {
+    return;
+  }
+
+  display::Screen* screen = display::Screen::GetScreen();
+  gfx::Point screen_loc = screen->GetCursorScreenPoint();
+  if (reveal_fraction_ > 0.0 && IsCursorOverHeaderPopup(screen_loc)) {
+    mouse_hovering_ = true;
+    hide_debounce_timer_.Stop();
+    return;
+  }
+
+  gfx::Point view_loc = screen_loc;
+  views::View::ConvertPointFromScreen(browser_view_, &view_loc);
+
+  int width = browser_view_->width();
+  if (view_loc.x() < -15 || view_loc.x() > width + 15) {
+    return;
+  }
+
+  int bar_height = browser_view_->top_container()
+                       ? browser_view_->top_container()->height()
+                       : 70;
+  int visible_bar_height = static_cast<int>(bar_height * reveal_fraction_);
+
+  bool at_top_edge = false;
+  bool over_top_bar = IsCursorOverTopBar(screen_loc, &at_top_edge);
+
+  if (at_top_edge) {
+    mouse_hovering_ = true;
+    hide_debounce_timer_.Stop();
+    Reveal(true);
+  } else if (reveal_fraction_ > 0.0) {
+    // If clicking directly into the web contents below visible top bar, hide immediately.
+    if (event.type() == ui::EventType::kMousePressed &&
+        view_loc.y() > visible_bar_height) {
+      mouse_hovering_ = false;
+      if (CanHide()) {
+        Hide(true);
+      }
+      return;
+    }
+
+    if (over_top_bar) {
+      mouse_hovering_ = true;
+      hide_debounce_timer_.Stop();
+    } else {
+      mouse_hovering_ = false;
+      ScheduleHideIfNeeded();
+    }
+  }
+}
+
+void VeloxAutoHideController::UpdateTopContainerPosition() {
+  if (!browser_view_ || !browser_view_->top_container()) {
+    return;
+  }
+  views::View* top_container = browser_view_->top_container();
+  const int height = top_container->height() > 0
+                         ? top_container->height()
+                         : top_container->GetPreferredSize().height();
+  const int width = browser_view_->width();
+  const int target_y =
+      static_cast<int>(std::round(height * (reveal_fraction_ - 1.0)));
+  top_container->SetBounds(0, target_y, width, height);
+  if (browser_view_->frame() && browser_view_->frame()->GetFrameView()) {
+    browser_view_->frame()->GetFrameView()->InvalidateLayout();
+    browser_view_->frame()->GetFrameView()->SchedulePaint();
+    browser_view_->frame()->GetFrameView()->EnsureCaptionButtonsOnTop();
+  }
+}
+
+void VeloxAutoHideController::AnimationProgressed(
+    const gfx::Animation* animation) {
+  reveal_fraction_ = slide_animation_->GetCurrentValue();
+  UpdateTopContainerPosition();
+}
+
+void VeloxAutoHideController::AnimationEnded(const gfx::Animation* animation) {
+  reveal_fraction_ = slide_animation_->GetCurrentValue();
+  UpdateTopContainerPosition();
+  if (browser_view_ && browser_view_->GetWidget()) {
+    browser_view_->InvalidateLayout();
+  }
+}
+
+void VeloxAutoHideController::OnDidChangeFocus(views::View* focused_before,
+                                              views::View* focused_now) {
+  if (!browser_view_ || !browser_view_->top_container()) {
+    return;
+  }
+  // Keep revealed while user is actively focused on any element in the top bar (tabs, toolbar, omnibox).
+  bool is_top_bar_focused =
+      focused_now && browser_view_->top_container()->Contains(focused_now);
+
+  if (is_top_bar_focused) {
+    hide_debounce_timer_.Stop();
+    Reveal(true);
+  } else if (!mouse_hovering_ && CanHide()) {
+    hide_debounce_timer_.Start(
+        FROM_HERE, base::Milliseconds(kHideDebounceDelayMs),
+        base::BindOnce(&VeloxAutoHideController::Hide,
+                       weak_factory_.GetWeakPtr(), true));
+  }
+}
+
+void VeloxAutoHideController::OnNotificationDisplayed(
+    const message_center::Notification& notification,
+    const NotificationCommon::Metadata* const metadata) {
+  OnNotificationReceived(notification.title(), notification.origin_url(),
+                         notification.message());
+}
+
+void VeloxAutoHideController::OnNotificationDisplayServiceDestroyed(
+    NotificationDisplayService* service) {
+  notification_observation_.Reset();
+}
+
+void VeloxAutoHideController::OnBackgroundTabActivity(
+    content::WebContents* contents) {
+  if (!contents) {
+    return;
+  }
+  std::u16string title = contents->GetTitle();
+  if (title.empty()) {
+    return;
+  }
+
+  // Detect unread notification markers like "(1)", "(2)", "[1]" in background tabs
+  bool has_badge = false;
+  size_t open_pos = title.find_first_of(u"([");
+  if (open_pos != std::u16string::npos) {
+    size_t close_pos = title.find_first_of(u")]", open_pos);
+    if (close_pos != std::u16string::npos && close_pos > open_pos + 1) {
+      bool all_digits = true;
+      for (size_t i = open_pos + 1; i < close_pos; ++i) {
+        if (!base::IsAsciiDigit(title[i]) && title[i] != u'+') {
+          all_digits = false;
+          break;
+        }
+      }
+      if (all_digits) {
+        has_badge = true;
+      }
+    }
+  }
+
+  const GURL& url = contents->GetVisibleURL();
+  if (has_badge) {
+    if (title != last_notified_background_title_) {
+      last_notified_background_title_ = title;
+      OnNotificationReceived(title, url);
+    }
+  }
+}
+
+void VeloxAutoHideController::OnNotificationReceived(
+    const std::u16string& title,
+    const GURL& origin,
+    const std::u16string& message) {
+  if (!is_enabled_ || !browser_view_) {
+    return;
+  }
+
+  if (IsVideoFullscreen()) {
+    // CRITICAL: User is watching fullscreen video!
+    // Never drop down the top bar over their video.
+    // Show the sleek subtle fullscreen notification toast instead.
+    ShowFullscreenVideoToast(title, message);
+    return;
+  }
+
+  // Normal browsing mode: drop down top bar for a couple seconds
+  notification_peek_in_progress_ = true;
+  Reveal(true);
+
+  notification_peek_timer_.Start(
+      FROM_HERE, base::Milliseconds(kNotificationPeekDurationMs),
+      base::BindOnce(&VeloxAutoHideController::OnNotificationPeekTimerExpired,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void VeloxAutoHideController::OnNewTabOpened() {
+  if (!is_enabled_ || !browser_view_) {
+    return;
+  }
+  // Drop down header for a couple seconds then slide back up
+  notification_peek_in_progress_ = true;
+  Reveal(true);
+
+  notification_peek_timer_.Start(
+      FROM_HERE, base::Milliseconds(2500),
+      base::BindOnce(&VeloxAutoHideController::OnNotificationPeekTimerExpired,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void VeloxAutoHideController::OnNotificationPeekTimerExpired() {
+  notification_peek_in_progress_ = false;
+  if (CanHide()) {
+    Hide(true);
+  }
+}
+
+bool VeloxAutoHideController::IsVideoFullscreen() const {
+  return browser_view_ && browser_view_->IsFullscreen();
+}
+
+void VeloxAutoHideController::ShowFullscreenVideoToast(
+    const std::u16string& title,
+    const std::u16string& message) {
+  DismissFullscreenVideoToast();
+  if (!browser_view_ || !browser_view_->GetWidget() ||
+      !browser_view_->GetWidget()->GetNativeView()) {
+    return;
+  }
+
+  std::u16string display_text = title;
+  if (!message.empty()) {
+    display_text += u": " + message;
+  }
+  if (display_text.empty()) {
+    display_text = u"New notification";
+  }
+
+  auto subtle_view = std::make_unique<SubtleNotificationView>();
+  subtle_view->UpdateContent(display_text);
+
+  gfx::Size preferred = subtle_view->GetPreferredSize();
+  fullscreen_toast_widget_ = SubtleNotificationView::CreatePopupWidget(
+      browser_view_->GetWidget()->GetNativeView(), std::move(subtle_view));
+  fullscreen_toast_widget_->AddObserver(this);
+
+  gfx::Rect host_bounds = browser_view_->GetBoundsInScreen();
+  int x = host_bounds.right() - preferred.width() - 24;
+  int y = host_bounds.y() + 24;
+  fullscreen_toast_widget_->SetBounds(
+      gfx::Rect(x, y, preferred.width(), preferred.height()));
+  fullscreen_toast_widget_->SetZOrderLevel(ui::ZOrderLevel::kSecuritySurface);
+  fullscreen_toast_widget_->Show();
+
+  toast_dismiss_timer_.Start(
+      FROM_HERE, base::Milliseconds(kNotificationPeekDurationMs),
+      base::BindOnce(&VeloxAutoHideController::DismissFullscreenVideoToast,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void VeloxAutoHideController::DismissFullscreenVideoToast() {
+  toast_dismiss_timer_.Stop();
+  if (fullscreen_toast_widget_) {
+    views::Widget* toast = fullscreen_toast_widget_;
+    fullscreen_toast_widget_ = nullptr;
+    toast->RemoveObserver(this);
+    toast->CloseWithReason(views::Widget::ClosedReason::kUnspecified);
+  }
+}
+
+void VeloxAutoHideController::OnWidgetDestroying(views::Widget* widget) {
+  if (widget == fullscreen_toast_widget_) {
+    fullscreen_toast_widget_ = nullptr;
+    return;
+  }
+  if (browser_view_ && widget == browser_view_->GetWidget()) {
+    CleanUp();
+    return;
+  }
+  if (child_widget_observations_.IsObservingSource(widget) ||
+      child_widgets_.contains(widget)) {
+    UnobserveChildWidget(widget);
+    CheckMousePosition();
+  }
+}
+
+void VeloxAutoHideController::OnWidgetVisibilityChanged(views::Widget* widget,
+                                                        bool visible) {
+  if (!browser_view_ || widget == fullscreen_toast_widget_ ||
+      widget == browser_view_->GetWidget()) {
+    return;
+  }
+  if (visible) {
+    if (IsHeaderRelatedWidget(widget) && is_enabled_ && !IsVideoFullscreen()) {
+      hide_debounce_timer_.Stop();
+      Reveal(true);
+    }
+  } else {
+    CheckMousePosition();
+  }
+}
+
+void VeloxAutoHideController::OnWidgetActivationChanged(views::Widget* widget,
+                                                        bool active) {
+  if (!browser_view_ || widget == fullscreen_toast_widget_ ||
+      widget == browser_view_->GetWidget()) {
+    return;
+  }
+  if (active) {
+    if (IsHeaderRelatedWidget(widget) && is_enabled_ && !IsVideoFullscreen()) {
+      hide_debounce_timer_.Stop();
+      Reveal(true);
+    }
+  } else {
+    CheckMousePosition();
+  }
+}
+
+void VeloxAutoHideController::OnWidgetChildAdded(views::Widget* widget,
+                                                 views::Widget* child_widget) {
+  if (!browser_view_ || !child_widget) {
+    return;
+  }
+  if (widget == browser_view_->GetWidget() ||
+      child_widget_observations_.IsObservingSource(widget)) {
+    ObserveChildWidget(child_widget);
+    if (child_widget->IsVisible() && IsHeaderRelatedWidget(child_widget) &&
+        is_enabled_ && !IsVideoFullscreen()) {
+      hide_debounce_timer_.Stop();
+      Reveal(true);
+    }
+  }
+}
+
+void VeloxAutoHideController::OnWidgetChildRemoved(
+    views::Widget* widget,
+    views::Widget* child_widget) {
+  if (!browser_view_ || !child_widget) {
+    return;
+  }
+  if (widget == browser_view_->GetWidget() ||
+      child_widget_observations_.IsObservingSource(widget)) {
+    UnobserveChildWidget(child_widget);
+    CheckMousePosition();
+  }
+}
