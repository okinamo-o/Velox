+inline uint64_t VeloxSplitMix64(uint64_t z) {
+  z += 0x9e3779b97f4a7c15ULL;
+  z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+  z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+  return z ^ (z >> 31);
+}
+
+inline void TweakGreenByte(uint8_t* pixel) {
+  const uint8_t alpha = pixel[3];
+  if (alpha == 255u) {
+    pixel[1] ^= 1u;
+  } else if (alpha > 0u) {
+    if (pixel[1] > 0u) {
+      pixel[1] -= 1u;
+    } else {
+      pixel[1] = 1u;
+    }
+  }
+}
+
+thread_local uint64_t g_velox_scoped_canvas_farbling_key = 0;
+
+}  // namespace
+
+PLATFORM_EXPORT void VeloxSetScopedCanvasFarblingKey(uint64_t key) {
+  g_velox_scoped_canvas_farbling_key = key;
+}
+
+PLATFORM_EXPORT uint64_t VeloxGetScopedCanvasFarblingKey() {
+  return g_velox_scoped_canvas_farbling_key;
+}
+
+PLATFORM_EXPORT uint64_t VeloxGetSessionFarblingSeed() {
+  static const uint64_t kSeed = []() {
+    uint64_t parsed = 0;
+    if (const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess()) {
+      const std::string val = cmd->GetSwitchValueASCII("velox-farbling-seed");
+      if (!val.empty() && base::StringToUint64(val, &parsed) && parsed != 0) {
+        return parsed;
+      }
+    }
+    uint64_t fallback = base::RandUint64();
+    return fallback ? fallback : 0x6a09e667f3bcc908ULL;
+  }();
+  return kSeed;
+}
+
+PLATFORM_EXPORT uint64_t VeloxDeriveDomainFarblingKey(
+    const String& domain_or_origin,
+    uint64_t domain_salt) {
+  std::string utf8 = domain_or_origin.Utf8();
+  uint64_t h = VeloxSplitMix64(VeloxGetSessionFarblingSeed() ^ domain_salt);
+  for (unsigned char c : utf8) {
+    h = VeloxSplitMix64(h ^ static_cast<uint64_t>(c));
+  }
+  return h ? h : 0xbb67ae8584caa73bULL;
+}
+
+PLATFORM_EXPORT void VeloxFarbleRgbaBytes(base::span<uint8_t> rgba_bytes,
+                                          int width,
+                                          int height,
+                                          size_t row_bytes,
+                                          uint64_t domain_key) {
+  if (domain_key == 0 || width <= 0 || height <= 0 ||
+      static_cast<int64_t>(width) * static_cast<int64_t>(height) < 64) {
+    return;
+  }
+  const size_t min_row_bytes = static_cast<size_t>(width) * 4u;
+  if (row_bytes < min_row_bytes ||
+      rgba_bytes.size() <
+          static_cast<size_t>(height - 1) * row_bytes + min_row_bytes) {
+    return;
+  }
+
+  uint8_t* base_ptr = rgba_bytes.data();
+  bool mutated_any = false;
+  uint8_t* fallback_pixel = nullptr;
+
+  for (int y = 0; y < height; ++y) {
+    uint8_t* row = base_ptr + static_cast<size_t>(y) * row_bytes;
+    for (int x = 0; x < width; ++x) {
+      uint8_t* px = row + static_cast<size_t>(x) * 4u;
+      if (px[3] == 0u) {
+        continue;
+      }
+      fallback_pixel = px;
+      const uint64_t coord =
+          static_cast<uint64_t>(y) * 0x100000001b3ULL + static_cast<uint64_t>(x);
+      if ((VeloxSplitMix64(domain_key ^ coord) & 0x1FULL) == 0ULL) {
+        TweakGreenByte(px);
+        mutated_any = true;
+      }
+    }
+  }
+
+  if (!mutated_any && fallback_pixel) {
+    TweakGreenByte(fallback_pixel);
+  }
+}
+
+PLATFORM_EXPORT void VeloxFarblePixmap(const SkPixmap& pixmap,
+                                       uint64_t domain_key) {
+  if (domain_key == 0 || !pixmap.writable_addr()) {
+    return;
+  }
+  const SkColorType ct = pixmap.colorType();
+  if (ct != kRGBA_8888_SkColorType && ct != kBGRA_8888_SkColorType) {
+    return;
+  }
+  const size_t total_bytes = pixmap.computeByteSize();
+  if (total_bytes == 0) {
+    return;
+  }
+  VeloxFarbleRgbaBytes(
+      base::span<uint8_t>(static_cast<uint8_t*>(pixmap.writable_addr()),
+                          total_bytes),
+      pixmap.width(), pixmap.height(), pixmap.rowBytes(), domain_key);
+}
+
+PLATFORM_EXPORT void VeloxFarbleAudioSpan(base::span<float> samples,
+                                          unsigned channel_index,
+                                          uint64_t domain_key) {
+  if (domain_key == 0 || samples.empty()) {
+    return;
+  }
+  const uint64_t mixed =
+      VeloxSplitMix64(domain_key ^ static_cast<uint64_t>(channel_index));
+  const double factor =
+      1.0 + static_cast<double>((mixed % 4093ULL) + 1ULL) * 1e-6;
+  for (float& sample : samples) {
+    if (sample != 0.0f && std::isfinite(sample)) {
+      sample = static_cast<float>(static_cast<double>(sample) * factor);
+    }
+  }
+}
+
+PLATFORM_EXPORT void VeloxFarbleAnalyserFloatSpan(base::span<float> values,
+                                                  uint64_t domain_key) {
+  if (domain_key == 0 || values.empty()) {
+    return;
+  }
+  for (size_t i = 0; i < values.size(); ++i) {
+    float& v = values[i];
+    if (v != 0.0f && std::isfinite(v)) {
+      const uint64_t h = VeloxSplitMix64(domain_key ^ static_cast<uint64_t>(i));
+      const float delta =
+          static_cast<float>((h % 127ULL) + 1ULL) * 1e-5f;
+      v += delta;
+    }
+  }
+}
