+    uint64_t domain_salt);
+
+CORE_EXPORT uint64_t VeloxGetExecutionContextFarblingKey(
+    const ExecutionContext* context,
+    uint64_t domain_salt) {
+  if (!context) {
+    return 0;
+  }
+  const SecurityOrigin* target_origin = nullptr;
+  if (const auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    if (LocalFrame* frame = window->GetFrame()) {
+      Frame& top_frame = frame->Tree().Top();
+      if (const SecurityContext* top_sc = top_frame.GetSecurityContext()) {
+        const SecurityOrigin* top_origin = top_sc->GetSecurityOrigin();
+        if (top_origin && !top_origin->IsOpaque()) {
+          target_origin = top_origin;
+        }
+      }
+    }
+  }
+  if (!target_origin) {
+    target_origin = context->GetSecurityOrigin();
+  }
+
+  String site_key = "opaque";
+  if (target_origin && !target_origin->IsOpaque()) {
+    String reg_domain = target_origin->RegistrableDomain();
+    if (!reg_domain.empty()) {
+      site_key = reg_domain;
+    } else if (!target_origin->Host().empty()) {
+      site_key = target_origin->Host();
+    } else {
+      site_key = target_origin->ToString();
+    }
+  } else if (!context->Url().IsEmpty()) {
+    site_key = context->Url().GetString();
+  }
+
+  return VeloxDeriveDomainFarblingKey(site_key, domain_salt);
+}
+
 }  // namespace blink
