+  void HandleGetVeloxSystemStats(const base::Value::List& args) {
+    AllowJavascript();
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    std::string callback_id = args[0].GetString();
+
+    int total_tabs = 0;
+    int active_tabs = 0;
+    int sleeping_tabs = 0;
+    int pinned_tabs = 0;
+    int tab_groups_count = 0;
+
+    if (web_ui() && web_ui()->GetWebContents()) {
+      Browser* browser = chrome::FindBrowserWithTab(web_ui()->GetWebContents());
+      if (browser && browser->tab_strip_model()) {
+        TabStripModel* model = browser->tab_strip_model();
+        total_tabs = model->count();
+        for (int i = 0; i < total_tabs; ++i) {
+          if (model->IsTabPinned(i)) {
+            pinned_tabs++;
+          }
+          content::WebContents* tc = model->GetWebContentsAt(i);
+          if (tc && (tc->WasDiscarded() || tc->GetController().NeedsReload())) {
+            sleeping_tabs++;
+          } else {
+            active_tabs++;
+          }
+        }
+        if (model->SupportsTabGroups() && model->group_model()) {
+          tab_groups_count =
+              static_cast<int>(model->group_model()->ListTabGroups().size());
+        }
+      }
+    }
+
+    int browser_memory_mb = 180;
+    if (auto metrics = base::ProcessMetrics::CreateCurrentProcessMetrics()) {
+      auto mem_info = metrics->GetMemoryInfo();
+      if (mem_info.has_value() && mem_info->resident_set_bytes > 0) {
+        browser_memory_mb =
+            static_cast<int>(mem_info->resident_set_bytes / (1024 * 1024));
+      }
+    }
+
+    base::Value::Dict stats;
+    stats.Set("totalTabs", total_tabs);
+    stats.Set("activeTabs", active_tabs);
+    stats.Set("sleepingTabs", sleeping_tabs);
+    stats.Set("pinnedTabs", pinned_tabs);
+    stats.Set("tabGroupsCount", tab_groups_count);
+    stats.Set("browserMemoryMb", browser_memory_mb);
+    stats.Set("estimatedSavedMb", sleeping_tabs * 85);
+    ResolveJavascriptCallback(base::Value(callback_id), stats);
+  }
+
+  void HandleSleepVeloxInactiveTabs(const base::Value::List& args) {
+    AllowJavascript();
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    std::string callback_id = args[0].GetString();
+
+    int discarded_count = 0;
+    int active_tabs = 0;
+    int sleeping_tabs = 0;
+
+    if (web_ui() && web_ui()->GetWebContents()) {
+      Browser* browser = chrome::FindBrowserWithTab(web_ui()->GetWebContents());
+      if (browser && browser->tab_strip_model()) {
+        TabStripModel* model = browser->tab_strip_model();
+        int active_index = model->active_index();
+        for (int i = 0; i < model->count(); ++i) {
+          content::WebContents* tc = model->GetWebContentsAt(i);
+          if (!tc) {
+            continue;
+          }
+          if (i != active_index && !model->IsTabPinned(i) &&
+              !tc->WasDiscarded() && !tc->GetController().NeedsReload()) {
+            if (auto* lifecycle_unit =
+                    resource_coordinator::TabLifecycleUnitExternal::
+                        FromWebContents(tc)) {
+              if (lifecycle_unit->DiscardTab(
+                      ::mojom::LifecycleUnitDiscardReason::EXTERNAL)) {
+                discarded_count++;
+              }
+            }
+          }
+          if (tc->WasDiscarded() || tc->GetController().NeedsReload()) {
+            sleeping_tabs++;
+          } else {
+            active_tabs++;
+          }
+        }
+      }
+    }
+
+    base::Value::Dict result;
+    result.Set("discardedCount", discarded_count);
+    result.Set("activeTabs", active_tabs);
+    result.Set("sleepingTabs", sleeping_tabs);
+    result.Set("estimatedSavedMb", sleeping_tabs * 85);
+    ResolveJavascriptCallback(base::Value(callback_id), result);
+  }
