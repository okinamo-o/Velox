+  static std::string DecodeXmlEntities(std::string text) {
+    base::ReplaceSubstringsAfterOffset(&text, 0, "&lt;", "<");
+    base::ReplaceSubstringsAfterOffset(&text, 0, "&gt;", ">");
+    base::ReplaceSubstringsAfterOffset(&text, 0, "&quot;", "\"");
+    base::ReplaceSubstringsAfterOffset(&text, 0, "&#39;", "'");
+    base::ReplaceSubstringsAfterOffset(&text, 0, "&#x27;", "'");
+    base::ReplaceSubstringsAfterOffset(&text, 0, "&apos;", "'");
+    base::ReplaceSubstringsAfterOffset(&text, 0, "&amp;", "&");
+    return text;
+  }
+
+  static std::string ExtractXmlTag(std::string_view xml, std::string_view tag) {
+    std::string open_exact = base::StrCat({"<", tag, ">"});
+    std::string open_attr = base::StrCat({"<", tag, " "});
+    size_t start = xml.find(open_exact);
+    if (start == std::string_view::npos) {
+      start = xml.find(open_attr);
+    }
+    if (start == std::string_view::npos) {
+      return "";
+    }
+    size_t gt = xml.find('>', start);
+    if (gt == std::string_view::npos) {
+      return "";
+    }
+    size_t content_start = gt + 1;
+    std::string close_tag = base::StrCat({"</", tag, ">"});
+    size_t content_end = xml.find(close_tag, content_start);
+    if (content_end == std::string_view::npos) {
+      return "";
+    }
+    std::string_view inner =
+        xml.substr(content_start, content_end - content_start);
+    std::string trimmed(
+        base::TrimWhitespaceASCII(inner, base::TRIM_ALL));
+    return DecodeXmlEntities(std::move(trimmed));
+  }
+
+  static std::string ExtractXmlLinkHref(std::string_view xml) {
+    size_t link_pos = xml.find("<link");
+    if (link_pos == std::string_view::npos) {
+      return "";
+    }
+    size_t tag_end = xml.find('>', link_pos);
+    if (tag_end == std::string_view::npos) {
+      return "";
+    }
+    std::string_view link_tag = xml.substr(link_pos, tag_end - link_pos);
+    size_t href_pos = link_tag.find("href=");
+    if (href_pos == std::string_view::npos) {
+      return "";
+    }
+    size_t quote_pos = href_pos + 5;
+    if (quote_pos >= link_tag.size()) {
+      return "";
+    }
+    char quote = link_tag[quote_pos];
+    if (quote != '"' && quote != '\'') {
+      return "";
+    }
+    size_t val_start = quote_pos + 1;
+    size_t val_end = link_tag.find(quote, val_start);
+    if (val_end == std::string_view::npos) {
+      return "";
+    }
+    return DecodeXmlEntities(
+        std::string(link_tag.substr(val_start, val_end - val_start)));
+  }
