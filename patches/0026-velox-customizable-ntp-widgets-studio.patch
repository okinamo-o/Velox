+
+  protected getWidgetCardClass_(id: string, baseClasses: string = ''): string {
+    const classes = baseClasses ? [baseClasses] : [];
+    if (this.widgetPositions_[id]) {
+      classes.push('velox-floating-widget');
+    }
+    if (this.dragWidgetId_ === id) {
+      classes.push('velox-dragging');
+    }
+    if (this.dropTargetWidgetId_ === id) {
+      classes.push('velox-drop-target');
+    }
+    return classes.join(' ');
+  }
+
+  protected getWidgetPositionStyle_(id: string): string {
+    const pos = this.widgetPositions_[id];
+    if (!pos) {
+      return '';
+    }
+    const maxW = (id === 'hero' || id === 'clock') ? 260 : 680;
+    const defaultW = (id === 'hero' || id === 'clock') ? 220 : 330;
+    const w = pos.widthPx ? Math.min(Math.max(pos.widthPx, 170), maxW) : defaultW;
+    return `position: fixed !important; left: clamp(4px, ${pos.xPct}%, calc(100% - ${w + 4}px)) !important; top: clamp(4px, ${pos.yPct}%, calc(100% - 60px)) !important; right: auto !important; bottom: auto !important; width: min(${w}px, calc(100% - 8px)) !important; max-width: none !important; z-index: 18 !important; margin: 0 !important;`;
+  }
+
+  private syncWidgetPositionStyles_() {
+    const cards = this.shadowRoot?.querySelectorAll('[data-widget-id]');
+    if (!cards) {
+      return;
+    }
+    const draggingId = this.activeDrag_?.started ? this.activeDrag_.id : '';
+    for (const node of Array.from(cards)) {
+      const el = node as HTMLElement;
+      const id = el.dataset['widgetId'];
+      if (!id || id === draggingId) {
+        continue;
+      }
+      if (this.widgetPositions_[id]) {
+        el.style.cssText = this.getWidgetPositionStyle_(id);
+      } else {
+        el.removeAttribute('style');
+      }
+    }
+  }
+
+  protected onRedockWidget_(e: Event) {
+    e.stopPropagation();
+    const id = (e.currentTarget as HTMLElement).dataset['id'];
+    if (!id || !this.widgetPositions_[id]) {
+      return;
+    }
+    const el = this.shadowRoot?.querySelector(
+        `[data-widget-id="${id}"]`) as HTMLElement | null;
+    el?.removeAttribute('style');
+    const next = {...this.widgetPositions_};
+    delete next[id];
+    this.widgetPositions_ = next;
+    this.saveWidgetPositions_();
