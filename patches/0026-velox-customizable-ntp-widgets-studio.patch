+  private initHabitsState_(todayKey: string) {
+    const defaultHabits: VeloxHabitItem[] = [
+      {text: '25m Deep Focus Block', done: false},
+      {text: 'Hydrate & Stretch', done: false},
+      {text: 'Clear Open Tabs', done: false},
+    ];
+    try {
