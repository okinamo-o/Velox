+    const btn = e.currentTarget as HTMLElement;
+    const id = btn.dataset['id'] as VeloxWidgetId | undefined;
+    const dir = btn.dataset['dir'];
+    if (!id || !dir) {
+      return;
+    }
+    const idx = this.enabledWidgets_.indexOf(id);
+    if (idx < 0) {
+      return;
+    }
+    const swapIdx = dir === 'prev' ? idx - 1 : idx + 1;
+    if (swapIdx < 0 || swapIdx >= this.enabledWidgets_.length) {
+      return;
+    }
+    const updated = [...this.enabledWidgets_];
+    const tmp = updated[idx]!;
+    updated[idx] = updated[swapIdx]!;
+    updated[swapIdx] = tmp;
+    this.enabledWidgets_ = updated;
+    this.saveWidgetPreferences_();
