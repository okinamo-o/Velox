+      if (!saved) {
+        this.habitsList_ = defaultHabits;
+        this.habitStreak_ = 0;
+        this.saveHabitsState_(false);
+        return;
+      }
+      const parsed = JSON.parse(saved) as {
+        date?: string,
+        streak?: number,
+        streakCountedToday?: boolean,
+        items?: VeloxHabitItem[],
+      };
+      this.habitStreak_ = parsed.streak || 0;
+      const items = Array.isArray(parsed.items) ? parsed.items : defaultHabits;
+      if (parsed.date === todayKey) {
+        this.habitsList_ = items;
+      } else {
+        this.habitsList_ = items.map(h => ({text: h.text, done: false}));
+        this.saveHabitsState_(false);
