+  // =========================================================================
+  // Widget: Pomodoro Focus Timer
+  // =========================================================================
+
+  protected onSelectPomoMode_(e: Event) {
+    const mode = (e.currentTarget as HTMLElement).dataset['mode'] as
+        'focus' | 'short' | 'long' | undefined;
+    if (!mode) {
+      return;
+    }
+    this.stopPomoTimer_();
+    this.pomoMode_ = mode;
+    const mins = mode === 'focus' ? 25 : (mode === 'short' ? 5 : 15);
+    this.pomoTotalSeconds_ = mins * 60;
+    this.pomoSecondsLeft_ = mins * 60;
+  }
+
+  protected onTogglePomoRun_() {
+    if (this.pomoRunning_) {
+      this.stopPomoTimer_();
+      return;
+    }
+    this.pomoRunning_ = true;
+    if (this.pomoInterval_) {
+      clearInterval(this.pomoInterval_);
+    }
+    this.pomoInterval_ = window.setInterval(() => {
+      if (this.pomoSecondsLeft_ <= 1) {
+        this.handlePomoComplete_();
+      } else {
+        this.pomoSecondsLeft_ -= 1;
+      }
+    }, 1000);
+  }
+
+  protected onResetPomo_() {
+    this.stopPomoTimer_();
+    this.pomoSecondsLeft_ = this.pomoTotalSeconds_;
+  }
+
+  private stopPomoTimer_() {
+    this.pomoRunning_ = false;
+    if (this.pomoInterval_) {
+      clearInterval(this.pomoInterval_);
+      this.pomoInterval_ = undefined;
+    }
+  }
+
+  private handlePomoComplete_() {
+    const completedFocus = this.pomoMode_ === 'focus';
+    this.stopPomoTimer_();
+    this.playCompletionChime_();
+    if (completedFocus) {
+      this.pomoSessionsToday_ += 1;
+      try {
+        window.localStorage.setItem(
+            'velox_pomo_sessions_v1',
+            JSON.stringify(
+                {date: this.getTodayKey_(), count: this.pomoSessionsToday_}));
+      } catch {}
+      this.pomoMode_ = 'short';
+      this.pomoTotalSeconds_ = 5 * 60;
+      this.pomoSecondsLeft_ = 5 * 60;
+    } else {
+      this.pomoMode_ = 'focus';
+      this.pomoTotalSeconds_ = 25 * 60;
+      this.pomoSecondsLeft_ = 25 * 60;
+    }
+  }
+
+  private playCompletionChime_() {
+    try {
+      const ctx = new AudioContext();
+      const now = ctx.currentTime;
+      const playNote = (freq: number, start: number, dur: number) => {
+        const osc = ctx.createOscillator();
+        const gain = ctx.createGain();
+        osc.type = 'sine';
+        osc.frequency.value = freq;
+        gain.gain.setValueAtTime(0.001, start);
+        gain.gain.exponentialRampToValueAtTime(0.16, start + 0.03);
+        gain.gain.exponentialRampToValueAtTime(0.001, start + dur);
+        osc.connect(gain);
+        gain.connect(ctx.destination);
+        osc.start(start);
+        osc.stop(start + dur);
+      };
+      playNote(587.33, now, 0.25);
+      playNote(880.0, now + 0.2, 0.45);
+      window.setTimeout(() => {
+        ctx.close().catch(() => {});
+      }, 900);
+    } catch {}
+  }
+
+  protected formatPomoTime_(): string {
+    const mins = Math.floor(this.pomoSecondsLeft_ / 60);
+    const secs = this.pomoSecondsLeft_ % 60;
+    return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
+  }
+
+  protected getPomoProgressPercent_(): number {
+    if (this.pomoTotalSeconds_ <= 0) {
+      return 0;
+    }
+    const elapsed = this.pomoTotalSeconds_ - this.pomoSecondsLeft_;
+    return Math.max(0, Math.min(100, Math.round((elapsed / this.pomoTotalSeconds_) * 100)));
+  }
