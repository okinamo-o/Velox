+
+  private cleanupWidgetDragListeners_() {
+    window.removeEventListener('pointermove', this.boundWidgetPointerMove_);
+    window.removeEventListener('pointerup', this.boundWidgetPointerUp_);
+    window.removeEventListener('pointercancel', this.boundWidgetPointerUp_);
+    this.style.removeProperty('--velox-drag-left');
+    this.style.removeProperty('--velox-drag-top');
+    this.style.removeProperty('--velox-drag-width');
+  }
+
+  protected onWidgetHeaderPointerDown_(e: PointerEvent) {
+    if (e.button !== 0) {
+      return;
+    }
+    const target = e.target as HTMLElement | null;
+    if (!target ||
+        target.closest(
+            'button, input, textarea, select, a, .velox-clock-clickable')) {
+      return;
+    }
+    const cardEl = (e.currentTarget as HTMLElement).closest('[data-widget-id]') as
+        HTMLElement | null;
+    const id = cardEl?.dataset['widgetId'];
+    if (!cardEl || !id) {
+      return;
+    }
+    e.preventDefault();
+    const rect = cardEl.getBoundingClientRect();
+    const vw = Math.max(1, document.documentElement.clientWidth || window.innerWidth);
+    const maxViewportW = Math.max(170, vw - 16);
+    const isCorner = id === 'hero' || id === 'clock';
+    const dragWidth = isCorner ?
+        Math.min(Math.max(Math.round(rect.width), 170), Math.min(260, maxViewportW)) :
+        Math.min(Math.max(Math.round(rect.width), 260), Math.min(350, maxViewportW));
+
+    const rawOffsetX = e.clientX - rect.left;
+    const ratioX = rect.width > 0 ? rawOffsetX / rect.width : 0.5;
+    const offsetX = dragWidth < rect.width ?
+        Math.min(Math.max(24, Math.round(ratioX * dragWidth)), dragWidth - 24) :
+        Math.min(Math.max(12, rawOffsetX), Math.max(12, dragWidth - 12));
+    const offsetY = Math.min(
+        Math.max(8, e.clientY - rect.top), Math.max(16, Math.round(rect.height) - 8));
+    const startLeft = dragWidth < rect.width ?
+        Math.round(e.clientX - offsetX) :
+        Math.round(rect.left);
+    const startTop = Math.round(rect.top);
+
+    this.cleanupWidgetDragListeners_();
+    this.activeDrag_ = {
+      id,
+      cardEl,
+      startX: e.clientX,
+      startY: e.clientY,
+      startLeft,
+      startTop,
+      offsetX,
+      offsetY,
+      width: dragWidth,
+      height: Math.round(rect.height),
+      started: false,
+      currentLeft: startLeft,
+      currentTop: startTop,
+    };
+    window.addEventListener('pointermove', this.boundWidgetPointerMove_);
+    window.addEventListener('pointerup', this.boundWidgetPointerUp_);
+    window.addEventListener('pointercancel', this.boundWidgetPointerUp_);
+  }
+
+  private onWindowWidgetPointerMove_(e: PointerEvent) {
+    const drag = this.activeDrag_;
+    if (!drag) {
+      return;
+    }
+    const dx = e.clientX - drag.startX;
+    const dy = e.clientY - drag.startY;
+    if (!drag.started) {
+      if (Math.hypot(dx, dy) < 4) {
+        return;
+      }
+      drag.started = true;
+      window.getSelection()?.removeAllRanges();
+      drag.cardEl.classList.add('velox-dragging');
+      drag.cardEl.style.setProperty('position', 'fixed', 'important');
+      drag.cardEl.style.setProperty('right', 'auto', 'important');
+      drag.cardEl.style.setProperty('bottom', 'auto', 'important');
+      drag.cardEl.style.setProperty('margin', '0', 'important');
+      drag.cardEl.style.setProperty('max-width', 'none', 'important');
+      drag.cardEl.style.setProperty('width', `${drag.width}px`, 'important');
+      drag.cardEl.style.setProperty('z-index', '600', 'important');
+    }
+
+    const vw = Math.max(1, document.documentElement.clientWidth || window.innerWidth);
+    const vh = Math.max(1, document.documentElement.clientHeight || window.innerHeight);
+    const maxLeft = Math.max(4, vw - drag.width - 4);
+    const maxTop = Math.max(4, vh - 60);
+    const nextLeft = Math.round(Math.min(maxLeft, Math.max(4, e.clientX - drag.offsetX)));
+    const nextTop = Math.round(Math.min(maxTop, Math.max(4, e.clientY - drag.offsetY)));
+    drag.currentLeft = nextLeft;
+    drag.currentTop = nextTop;
+
+    drag.cardEl.style.setProperty('left', `${nextLeft}px`, 'important');
+    drag.cardEl.style.setProperty('top', `${nextTop}px`, 'important');
+  }
+
+  private onWindowWidgetPointerUp_(_e: PointerEvent) {
+    const drag = this.activeDrag_;
+    this.activeDrag_ = null;
+    this.cleanupWidgetDragListeners_();
+    if (!drag || !drag.started) {
+      return;
+    }
+
+    drag.cardEl.classList.remove('velox-dragging');
+    drag.cardEl.style.setProperty('z-index', '18', 'important');
+
+    const vw = Math.max(1, document.documentElement.clientWidth || window.innerWidth);
+    const vh = Math.max(1, document.documentElement.clientHeight || window.innerHeight);
+
+    const nextPositions = {...this.widgetPositions_};
+    nextPositions[drag.id] = {
+      xPct: Number(((drag.currentLeft / vw) * 100).toFixed(3)),
+      yPct: Number(((drag.currentTop / vh) * 100).toFixed(3)),
+      widthPx: Math.round(drag.width),
+    };
+    this.widgetPositions_ = nextPositions;
+    this.saveWidgetPositions_();
+  }
+
+  protected onStudioCardDragStart_(e: DragEvent) {
+    const id = (e.currentTarget as HTMLElement).dataset['id'] || '';
+    if (!id || !this.enabledWidgets_.includes(id as VeloxWidgetId)) {
+      e.preventDefault();
+      return;
+    }
+    this.studioDragId_ = id;
+    if (e.dataTransfer) {
+      e.dataTransfer.effectAllowed = 'move';
+      e.dataTransfer.setData('text/plain', id);
+    }
+  }
+
+  protected onStudioCardDragOver_(e: DragEvent) {
+    const targetId = (e.currentTarget as HTMLElement).dataset['id'] || '';
+    if (this.studioDragId_ && targetId && targetId !== this.studioDragId_ &&
+        this.enabledWidgets_.includes(targetId as VeloxWidgetId)) {
+      e.preventDefault();
+      if (e.dataTransfer) {
+        e.dataTransfer.dropEffect = 'move';
+      }
+    }
+  }
+
+  protected onStudioCardDrop_(e: DragEvent) {
+    e.preventDefault();
+    const targetId = (e.currentTarget as HTMLElement).dataset['id'] || '';
+    const sourceId = this.studioDragId_;
+    this.studioDragId_ = '';
+    if (!sourceId || !targetId || sourceId === targetId) {
+      return;
+    }
+    const srcIdx = this.enabledWidgets_.indexOf(sourceId as VeloxWidgetId);
+    const dstIdx = this.enabledWidgets_.indexOf(targetId as VeloxWidgetId);
+    if (srcIdx < 0 || dstIdx < 0) {
+      return;
+    }
+    const updated = [...this.enabledWidgets_];
+    const tmp = updated[srcIdx]!;
+    updated[srcIdx] = updated[dstIdx]!;
+    updated[dstIdx] = tmp;
+    this.enabledWidgets_ = updated;
+    this.saveWidgetPreferences_();
+  }
+
+  protected onStudioCardDragEnd_() {
+    this.studioDragId_ = '';
+  }
