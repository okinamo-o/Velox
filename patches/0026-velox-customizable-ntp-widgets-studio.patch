+  // =========================================================================
+  // Widget: Weather & Forecast
+  // =========================================================================
+
+  private getDefaultCityFromTimezone_(): string {
+    try {
+      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
+      const parts = tz.split('/');
+      if (parts.length >= 2) {
+        const candidate = parts[parts.length - 1]!.replace(/_/g, ' ').trim();
+        if (candidate && candidate.toUpperCase() !== 'UTC' &&
+            candidate.toUpperCase() !== 'GMT') {
+          return candidate;
+        }
+      }
+    } catch {}
+    return 'Algiers';
+  }
+
+  private decodeWeatherCode_(code: number): {label: string, icon: string} {
+    if (code === 0) {
+      return {label: 'Clear Sky', icon: '☀️'};
+    }
+    if (code <= 3) {
+      return {label: 'Partly Cloudy', icon: '⛅'};
+    }
+    if (code <= 48) {
+      return {label: 'Foggy', icon: '🌫️'};
+    }
+    if (code <= 67) {
+      return {label: 'Rainy', icon: '🌧️'};
+    }
+    if (code <= 77) {
+      return {label: 'Snow', icon: '❄️'};
+    }
+    if (code <= 82) {
+      return {label: 'Showers', icon: '🌦️'};
+    }
+    return {label: 'Thunderstorm', icon: '⛈️'};
+  }
+
+  protected formatTemp_(tempC: number): string {
+    const val = this.weatherUnit_ === 'F' ? (tempC * 9) / 5 + 32 : tempC;
+    return `${Math.round(val)}°`;
+  }
+
+  protected onToggleWeatherUnit_() {
+    this.weatherUnit_ = this.weatherUnit_ === 'C' ? 'F' : 'C';
+    try {
+      window.localStorage.setItem('velox_weather_unit_v1', this.weatherUnit_);
+    } catch {}
+  }
+
+  protected onToggleWeatherEdit_() {
+    this.weatherEditingCity_ = !this.weatherEditingCity_;
+    if (this.weatherEditingCity_ && this.weatherData_) {
+      this.weatherCityInput_ = this.weatherData_.city;
+    }
+  }
+
+  protected onWeatherCityInput_(e: Event) {
+    this.weatherCityInput_ = (e.target as HTMLInputElement).value;
+  }
+
+  protected onWeatherCityKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Enter') {
+      this.onSaveWeatherCity_();
+    }
+  }
+
+  protected onSaveWeatherCity_() {
+    const city = this.weatherCityInput_.trim();
+    if (!city) {
+      return;
+    }
+    this.weatherEditingCity_ = false;
+    try {
+      window.localStorage.setItem('velox_weather_city_v1', city);
+    } catch {}
+    this.fetchWeatherForCity_(city, true);
+  }
+
+  protected onRefreshWeather_() {
+    const city = (this.weatherData_?.city || this.weatherCityInput_ ||
+                  this.getDefaultCityFromTimezone_()).trim();
+    this.fetchWeatherForCity_(city, true);
+  }
+
+  private async fetchWeatherForCity_(city: string, force: boolean) {
+    if (this.weatherLoading_ && !force) {
+      return;
+    }
+    this.weatherLoading_ = true;
+    this.weatherError_ = '';
+    try {
+      const res = await sendWithPromise('getVeloxWeather', city) as {
+        ok?: boolean,
+        error?: string,
+        city?: string,
+        tempC?: number,
+        highC?: number,
+        lowC?: number,
+        weatherCode?: number,
+        windKmh?: number,
+      };
+      if (!res || !res.ok) {
+        this.weatherError_ = (res && res.error) ? String(res.error) : 'Weather unavailable';
+        return;
+      }
+      const code = Number(res.weatherCode ?? 0);
+      const decoded = this.decodeWeatherCode_(code);
+      const resolvedCity = String(res.city || city);
+      const data: VeloxWeatherData = {
+        city: resolvedCity,
+        tempC: Math.round(Number(res.tempC ?? 20)),
+        highC: Math.round(Number(res.highC ?? res.tempC ?? 24)),
+        lowC: Math.round(Number(res.lowC ?? res.tempC ?? 15)),
+        windKmh: Math.round(Number(res.windKmh ?? 0)),
+        condition: decoded.label,
+        icon: decoded.icon,
+        updatedAt: Date.now(),
+      };
+      this.weatherData_ = data;
+      this.weatherCityInput_ = resolvedCity;
+      try {
+        window.localStorage.setItem('velox_weather_city_v1', resolvedCity);
+        window.localStorage.setItem('velox_weather_cache_v1', JSON.stringify(data));
+      } catch {}
+    } catch {
+      this.weatherError_ = 'Weather unavailable';
+    } finally {
+      this.weatherLoading_ = false;
+    }
+  }
