+  protected onSelectAmbientSound_(e: Event) {
+    const sound = (e.currentTarget as HTMLElement).dataset['sound'] as
+        'rain' | 'brown' | 'pink' | 'drone' | undefined;
+    if (!sound) {
+      return;
+    }
+    this.ambientSound_ = sound;
+    if (this.ambientPlaying_) {
+      this.stopAmbientAudio_();
+      this.startAmbientAudio_();
+    }
+  }
+
+  protected onToggleAmbientPlay_() {
+    if (this.ambientPlaying_) {
+      this.stopAmbientAudio_();
+      this.ambientPlaying_ = false;
+    } else {
+      this.startAmbientAudio_();
+      this.ambientPlaying_ = true;
+    }
+  }
+
+  protected onAmbientVolumeInput_(e: Event) {
+    const val = parseInt((e.target as HTMLInputElement).value, 10);
+    if (!isNaN(val)) {
+      this.ambientVolume_ = val;
+      if (this.ambientGain_ && this.audioCtx_) {
+        this.ambientGain_.gain.setTargetAtTime(
+            (val / 100) * 0.35, this.audioCtx_.currentTime, 0.05);
+      }
+    }
+  }
+
+  private startAmbientAudio_() {
+    this.stopAmbientAudio_();
+    try {
+      const ctx = new AudioContext();
+      this.audioCtx_ = ctx;
+      const masterGain = ctx.createGain();
+      masterGain.gain.value = (this.ambientVolume_ / 100) * 0.35;
+      masterGain.connect(ctx.destination);
+      this.ambientGain_ = masterGain;
+
+      if (this.ambientSound_ === 'drone') {
+        const filter = ctx.createBiquadFilter();
+        filter.type = 'lowpass';
+        filter.frequency.value = 380;
+        filter.connect(masterGain);
+        const freqs = [110, 164.81, 220];
+        const oscs = freqs.map((freq, idx) => {
+          const osc = ctx.createOscillator();
+          const g = ctx.createGain();
+          osc.type = idx === 2 ? 'triangle' : 'sine';
+          osc.frequency.value = freq;
+          g.gain.value = idx === 0 ? 0.38 : 0.22;
+          osc.connect(g);
+          g.connect(filter);
+          osc.start();
+          return osc;
+        });
+        this.ambientStopper_ = () => {
+          oscs.forEach(o => {
+            try {
+              o.stop();
+            } catch {}
+          });
+        };
+      } else {
+        const bufferSize = ctx.sampleRate * 3;
+        const buffer = ctx.createBuffer(2, bufferSize, ctx.sampleRate);
+        for (let ch = 0; ch < 2; ch++) {
+          const data = buffer.getChannelData(ch);
+          let lastOut = 0;
+          let b0 = 0;
+          let b1 = 0;
+          let b2 = 0;
+          for (let i = 0; i < bufferSize; i++) {
+            const white = Math.random() * 2 - 1;
+            if (this.ambientSound_ === 'brown') {
+              lastOut = (lastOut + 0.02 * white) / 1.02;
+              data[i] = lastOut * 3.0;
+            } else {
+              b0 = 0.99765 * b0 + white * 0.0990460;
+              b1 = 0.96300 * b1 + white * 0.2965164;
+              b2 = 0.57000 * b2 + white * 1.0526913;
+              data[i] = (b0 + b1 + b2 + white * 0.1848) * 0.09;
+            }
+          }
+        }
+        const source = ctx.createBufferSource();
+        source.buffer = buffer;
+        source.loop = true;
+        const filter = ctx.createBiquadFilter();
+        filter.type = 'lowpass';
+        filter.frequency.value = this.ambientSound_ === 'rain' ? 1150 :
+            (this.ambientSound_ === 'brown' ? 340 : 1850);
+        source.connect(filter);
+        filter.connect(masterGain);
+        source.start();
+        this.ambientStopper_ = () => {
+          try {
+            source.stop();
+          } catch {}
+        };
+      }
+    } catch {}
+  }
+
+  private stopAmbientAudio_() {
+    if (this.ambientStopper_) {
+      this.ambientStopper_();
+      this.ambientStopper_ = null;
+    }
+    this.ambientGain_ = null;
+    if (this.audioCtx_) {
+      this.audioCtx_.close().catch(() => {});
+      this.audioCtx_ = null;
+    }
+  }
