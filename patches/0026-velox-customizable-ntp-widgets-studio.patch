+    }
+    const idx = parseInt(idxStr, 10);
+    if (idx >= 0 && idx < this.habitsList_.length) {
+      this.habitsList_ = this.habitsList_.filter((_, i) => i !== idx);
+      this.saveHabitsState_();
+    }
+  }
+
+  private saveHabitsState_(allowStreakBump: boolean = true) {
+    try {
+      const todayKey = this.getTodayKey_();
+      const raw = window.localStorage.getItem('velox_habits_v1');
+      let alreadyCounted = false;
+      if (raw) {
+        const prev = JSON.parse(raw) as {date?: string, streakCountedToday?: boolean};
+        alreadyCounted = prev.date === todayKey && !!prev.streakCountedToday;
+      }
+      const allDone = this.habitsList_.length > 0 &&
+          this.habitsList_.every(h => h.done);
+      if (allowStreakBump && allDone && !alreadyCounted) {
+        this.habitStreak_ += 1;
+        alreadyCounted = true;
+      }
+      window.localStorage.setItem(
+          'velox_habits_v1',
+          JSON.stringify({
+            date: todayKey,
+            streak: this.habitStreak_,
+            streakCountedToday: alreadyCounted,
+            items: this.habitsList_,
+          }));
+    } catch {}
+  }
