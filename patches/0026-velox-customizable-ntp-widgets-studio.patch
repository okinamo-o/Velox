+    const idx = parseInt(idxStr, 10);
+    if (idx >= 0 && idx < this.habitsList_.length) {
+      this.habitsList_ = this.habitsList_.map(
+          (h, i) => (i === idx ? {text: h.text, done: !h.done} : h));
