+
+  protected getSelectedWorldClocks_(): Array<{
+    id: string,
+    name: string,
+    timeStr: string,
+    dayLabel: string,
+    isNight: boolean,
+  }> {
+    void this.worldClockTick_;
+    const now = new Date();
+    const localDay = new Intl.DateTimeFormat('en-CA', {
+      year: 'numeric',
+      month: '2-digit',
+      day: '2-digit',
+    }).format(now);
+
+    return this.worldClockCities_
+        .map(id => VELOX_WORLD_CLOCK_OPTIONS.find(c => c.id === id))
+        .filter((c): c is VeloxWorldClockCity => !!c)
+        .map(city => {
+          const timeStr = new Intl.DateTimeFormat([], {
+            timeZone: city.timeZone,
+            hour: '2-digit',
+            minute: '2-digit',
+            hour12: !this.clockUse24Hour_,
+          }).format(now);
+          const hour24 = parseInt(
+              new Intl.DateTimeFormat('en-US', {
+                timeZone: city.timeZone,
+                hour: 'numeric',
+                hour12: false,
+              }).format(now),
+              10);
+          const cityDay = new Intl.DateTimeFormat('en-CA', {
+            timeZone: city.timeZone,
+            year: 'numeric',
+            month: '2-digit',
+            day: '2-digit',
+          }).format(now);
+          const dayLabel = cityDay === localDay ? 'Today' :
+              (cityDay > localDay ? 'Tomorrow' : 'Yesterday');
+          const isNight = hour24 < 6 || hour24 >= 20;
+          return {id: city.id, name: city.name, timeStr, dayLabel, isNight};
+        });
+  }
