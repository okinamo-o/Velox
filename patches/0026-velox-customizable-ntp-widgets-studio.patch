+  protected onCalcKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Enter') {
+      this.onEvaluateCalc_();
+    }
+  }
+
+  protected onCalcButtonClick_(e: Event) {
+    const key = (e.currentTarget as HTMLElement).dataset['key'];
+    if (!key) {
+      return;
+    }
+    if (key === 'C') {
+      this.calcExpr_ = '';
+      this.calcResult_ = '0';
+      return;
+    }
+    if (key === 'DEL') {
+      this.calcExpr_ = this.calcExpr_.slice(0, -1);
+      const live = this.safeEvalMath_(this.calcExpr_.trim());
+      this.calcResult_ = live ?? (this.calcExpr_.trim() ? this.calcResult_ : '0');
+      return;
+    }
+    if (key === '=') {
+      this.onEvaluateCalc_();
+      return;
+    }
+    this.calcExpr_ = `${this.calcExpr_}${key}`;
+    const live = this.safeEvalMath_(this.calcExpr_.trim());
+    if (live !== null) {
+      this.calcResult_ = live;
+    }
+  }
+
+  protected onEvaluateCalc_() {
+    const expr = this.calcExpr_.trim();
+    if (!expr) {
+      return;
+    }
+    const res = this.safeEvalMath_(expr);
+    if (res !== null) {
+      this.calcResult_ = res;
+      this.calcHistory_ = [`${expr} = ${res}`, ...this.calcHistory_].slice(0, 3);
+      this.calcExpr_ = res;
+    } else {
+      this.calcResult_ = 'Error';
+    }
+  }
+
+  protected onUseCalcHistory_(e: Event) {
+    const entry = (e.currentTarget as HTMLElement).dataset['entry'];
+    if (!entry) {
+      return;
+    }
+    const parts = entry.split('=');
+    const expr = parts[0]?.trim() || '';
+    const res = parts[1]?.trim() || '0';
+    this.calcExpr_ = expr;
+    this.calcResult_ = res;
+  }
+
+  protected onSelectConvCategory_(e: Event) {
+    const cat = (e.currentTarget as HTMLElement).dataset['cat'] as
+        'length' | 'weight' | 'temp' | 'data' | undefined;
+    if (cat) {
+      this.convCategory_ = cat;
+    }
+  }
+
+  protected onConvInput_(e: Event) {
+    this.convInput_ = (e.target as HTMLInputElement).value;
+  }
+
+  protected onSwapConvDir_() {
+    this.convDir_ = this.convDir_ === 'fwd' ? 'rev' : 'fwd';
+  }
+
+  protected getConvUnits_(): {from: string, to: string} {
+    const map: Record<string, [string, string]> = {
+      length: ['km', 'mi'],
+      weight: ['kg', 'lb'],
+      temp: ['°C', '°F'],
+      data: ['GB', 'MB'],
+    };
+    const pair = map[this.convCategory_] || ['km', 'mi'];
+    return this.convDir_ === 'fwd' ? {from: pair[0], to: pair[1]} :
+                                     {from: pair[1], to: pair[0]};
+  }
+
+  protected getConvOutput_(): string {
+    const num = parseFloat(this.convInput_);
+    if (!Number.isFinite(num)) {
+      return '—';
+    }
+    let out = 0;
+    const fwd = this.convDir_ === 'fwd';
+    switch (this.convCategory_) {
+      case 'length':
+        out = fwd ? num * 0.621371 : num / 0.621371;
+        break;
+      case 'weight':
+        out = fwd ? num * 2.20462 : num / 2.20462;
+        break;
+      case 'temp':
+        out = fwd ? (num * 9) / 5 + 32 : ((num - 32) * 5) / 9;
+        break;
+      case 'data':
+        out = fwd ? num * 1024 : num / 1024;
+        break;
+    }
+    return Number.isInteger(out) ? String(out) : Number(out.toFixed(3)).toString();
+  }
