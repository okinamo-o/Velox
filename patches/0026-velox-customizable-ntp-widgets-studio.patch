+  void HandleGetVeloxBookmarks(const base::Value::List& args) {
+    AllowJavascript();
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    std::string callback_id = args[0].GetString();
+    base::Value::List bookmarks_list;
+    Profile* profile = Profile::FromWebUI(web_ui());
+    if (profile) {
+      bookmarks::BookmarkModel* model =
+          BookmarkModelFactory::GetForBrowserContext(profile);
+      if (model && model->loaded()) {
+        ui::TreeNodeIterator<const bookmarks::BookmarkNode> iterator(
+            model->root_node());
+        while (iterator.has_next() && bookmarks_list.size() < 12) {
+          const bookmarks::BookmarkNode* node = iterator.Next();
+          if (!node || !node->is_url()) {
+            continue;
+          }
+          const GURL& url = node->url();
+          if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+            continue;
+          }
+          base::Value::Dict dict;
+          std::string title = base::UTF16ToUTF8(node->GetTitle());
+          if (title.empty()) {
+            title = url.host();
+          }
+          std::string folder;
+          if (node->parent() && !node->parent()->is_root()) {
+            folder = base::UTF16ToUTF8(node->parent()->GetTitle());
+          }
+          dict.Set("title", title);
+          dict.Set("url", url.spec());
+          dict.Set("folder", folder);
+          bookmarks_list.Append(std::move(dict));
+        }
+      }
+    }
+    ResolveJavascriptCallback(base::Value(callback_id), bookmarks_list);
+  }
