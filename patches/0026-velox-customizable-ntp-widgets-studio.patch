+  void OnWeatherGeoLoaded(std::string callback_id,
+                          std::string requested_city,
+                          std::unique_ptr<network::SimpleURLLoader> loader,
+                          std::unique_ptr<std::string> body) {
+    if (!IsJavascriptAllowed()) {
+      return;
+    }
+
+    int response_code = 0;
+    if (loader->ResponseInfo() && loader->ResponseInfo()->headers) {
+      response_code = loader->ResponseInfo()->headers->response_code();
+    }
+    if (loader->NetError() != net::OK || !body || response_code != 200) {
+      FetchWttrFallback(callback_id, requested_city);
+      return;
+    }
+
+    auto parsed = base::JSONReader::Read(*body);
+    if (!parsed || !parsed->is_dict()) {
+      FetchWttrFallback(callback_id, requested_city);
+      return;
+    }
+    const base::Value::List* results = parsed->GetDict().FindList("results");
+    if (!results || results->empty() || !(*results)[0].is_dict()) {
+      FetchWttrFallback(callback_id, requested_city);
+      return;
+    }
+    const base::Value::Dict& loc = (*results)[0].GetDict();
+    std::optional<double> lat = loc.FindDouble("latitude");
+    std::optional<double> lon = loc.FindDouble("longitude");
+    if (!lat.has_value() || !lon.has_value()) {
+      FetchWttrFallback(callback_id, requested_city);
+      return;
+    }
+    std::string resolved_city = requested_city;
+    if (const std::string* name = loc.FindString("name"); name && !name->empty()) {
+      resolved_city = *name;
+    }
+
+    Profile* profile = Profile::FromWebUI(web_ui());
+    if (!profile || !profile->GetDefaultStoragePartition()) {
+      ResolveWeatherError(callback_id, "Weather unavailable");
+      return;
+    }
+
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = GURL(base::StrCat({
+        "https://api.open-meteo.com/v1/forecast?latitude=",
+        base::NumberToString(*lat),
+        "&longitude=",
+        base::NumberToString(*lon),
+        "&current=temperature_2m,weather_code,wind_speed_10m,relative_humidity_2m"
+        "&daily=temperature_2m_max,temperature_2m_min&timezone=auto&forecast_days=1"}));
+    request->method = "GET";
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    request->load_flags = net::LOAD_BYPASS_CACHE | net::LOAD_DISABLE_CACHE;
+
+    auto loader_forecast = network::SimpleURLLoader::Create(
+        std::move(request), WeatherTrafficAnnotation());
+    auto* loader_ptr = loader_forecast.get();
+    loader_ptr->DownloadToString(
+        profile->GetDefaultStoragePartition()
+            ->GetURLLoaderFactoryForBrowserProcess()
+            .get(),
+        base::BindOnce(&VeloxNtpTabGroupsHandler::OnWeatherForecastLoaded,
+                       weak_ptr_factory_.GetWeakPtr(), callback_id,
+                       resolved_city, std::move(loader_forecast)),
+        128 * 1024);
+  }
+
+  void OnWeatherForecastLoaded(std::string callback_id,
+                               std::string resolved_city,
+                               std::unique_ptr<network::SimpleURLLoader> loader,
+                               std::unique_ptr<std::string> body) {
+    if (!IsJavascriptAllowed()) {
+      return;
+    }
+
+    int response_code = 0;
+    if (loader->ResponseInfo() && loader->ResponseInfo()->headers) {
+      response_code = loader->ResponseInfo()->headers->response_code();
+    }
+    if (loader->NetError() != net::OK || !body || response_code != 200) {
+      FetchWttrFallback(callback_id, resolved_city);
+      return;
+    }
+
+    auto parsed = base::JSONReader::Read(*body);
+    if (!parsed || !parsed->is_dict()) {
+      FetchWttrFallback(callback_id, resolved_city);
+      return;
+    }
+    const base::Value::Dict& root = parsed->GetDict();
+    const base::Value::Dict* current = root.FindDict("current");
+    if (!current) {
+      FetchWttrFallback(callback_id, resolved_city);
+      return;
+    }
+
+    double temp_c = current->FindDouble("temperature_2m").value_or(20.0);
+    double weather_code = current->FindDouble("weather_code").value_or(0.0);
+    double wind_kmh = current->FindDouble("wind_speed_10m").value_or(0.0);
+    double humidity = current->FindDouble("relative_humidity_2m").value_or(0.0);
+
+    double high_c = temp_c;
+    double low_c = temp_c;
+    if (const base::Value::Dict* daily = root.FindDict("daily")) {
+      if (const base::Value::List* max_list = daily->FindList("temperature_2m_max");
+          max_list && !max_list->empty() && (*max_list)[0].GetIfDouble()) {
+        high_c = *(*max_list)[0].GetIfDouble();
+      }
+      if (const base::Value::List* min_list = daily->FindList("temperature_2m_min");
+          min_list && !min_list->empty() && (*min_list)[0].GetIfDouble()) {
+        low_c = *(*min_list)[0].GetIfDouble();
+      }
+    }
+
+    base::Value::Dict out;
+    out.Set("ok", true);
+    out.Set("city", resolved_city);
+    out.Set("tempC", static_cast<int>(std::round(temp_c)));
+    out.Set("highC", static_cast<int>(std::round(high_c)));
+    out.Set("lowC", static_cast<int>(std::round(low_c)));
+    out.Set("weatherCode", static_cast<int>(std::round(weather_code)));
+    out.Set("windKmh", static_cast<int>(std::round(wind_kmh)));
+    out.Set("humidity", static_cast<int>(std::round(humidity)));
+    ResolveJavascriptCallback(base::Value(callback_id), out);
+  }
+
+  void FetchWttrFallback(const std::string& callback_id,
+                         const std::string& city) {
+    Profile* profile = Profile::FromWebUI(web_ui());
+    if (!profile || !profile->GetDefaultStoragePartition()) {
+      ResolveWeatherError(callback_id, "Weather unavailable");
+      return;
+    }
+
+    url::RawCanonOutputT<char> encoded_city;
+    url::EncodeURIComponent(city, &encoded_city);
+
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = GURL(base::StrCat(
+        {"https://wttr.in/", encoded_city.view(), "?format=j1"}));
+    request->method = "GET";
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    request->load_flags = net::LOAD_BYPASS_CACHE | net::LOAD_DISABLE_CACHE;
+
+    auto loader = network::SimpleURLLoader::Create(std::move(request),
+                                                   WeatherTrafficAnnotation());
+    auto* loader_ptr = loader.get();
+    loader_ptr->DownloadToString(
+        profile->GetDefaultStoragePartition()
+            ->GetURLLoaderFactoryForBrowserProcess()
+            .get(),
+        base::BindOnce(&VeloxNtpTabGroupsHandler::OnWttrLoaded,
+                       weak_ptr_factory_.GetWeakPtr(), callback_id, city,
+                       std::move(loader)),
+        512 * 1024);
+  }
+
+  void OnWttrLoaded(std::string callback_id,
+                    std::string requested_city,
+                    std::unique_ptr<network::SimpleURLLoader> loader,
+                    std::unique_ptr<std::string> body) {
+    if (!IsJavascriptAllowed()) {
+      return;
+    }
+
+    int response_code = 0;
+    if (loader->ResponseInfo() && loader->ResponseInfo()->headers) {
+      response_code = loader->ResponseInfo()->headers->response_code();
+    }
+    if (loader->NetError() != net::OK || !body || response_code != 200) {
+      ResolveWeatherError(callback_id, "Weather service unreachable");
+      return;
+    }
+
+    auto parsed = base::JSONReader::Read(*body);
+    if (!parsed || !parsed->is_dict()) {
+      ResolveWeatherError(callback_id, "Weather data unavailable");
+      return;
+    }
+    const base::Value::Dict& root = parsed->GetDict();
+    const base::Value::List* cond_list = root.FindList("current_condition");
+    if (!cond_list || cond_list->empty() || !(*cond_list)[0].is_dict()) {
+      ResolveWeatherError(callback_id, "City not found");
+      return;
+    }
+    const base::Value::Dict& cond = (*cond_list)[0].GetDict();
+
+    auto parse_str_or_num = [](const base::Value::Dict& d,
+                               std::string_view key,
+                               double fallback) -> double {
+      if (std::optional<double> num = d.FindDouble(key)) {
+        return *num;
+      }
+      if (const std::string* s = d.FindString(key)) {
+        double v = fallback;
+        if (base::StringToDouble(*s, &v)) {
+          return v;
+        }
+      }
+      return fallback;
+    };
+
+    double temp_c = parse_str_or_num(cond, "temp_C", 20.0);
+    double wind_kmh = parse_str_or_num(cond, "windspeedKmph", 0.0);
+    double humidity = parse_str_or_num(cond, "humidity", 0.0);
+    int wwo_code = static_cast<int>(
+        std::round(parse_str_or_num(cond, "weatherCode", 116.0)));
+
+    double high_c = temp_c;
+    double low_c = temp_c;
+    if (const base::Value::List* weather_list = root.FindList("weather");
+        weather_list && !weather_list->empty() &&
+        (*weather_list)[0].is_dict()) {
+      const base::Value::Dict& day = (*weather_list)[0].GetDict();
+      high_c = parse_str_or_num(day, "maxtempC", temp_c);
+      low_c = parse_str_or_num(day, "mintempC", temp_c);
+    }
+
+    std::string city_name = requested_city;
+    if (const base::Value::List* area_list = root.FindList("nearest_area");
+        area_list && !area_list->empty() && (*area_list)[0].is_dict()) {
+      if (const base::Value::List* name_list =
+              (*area_list)[0].GetDict().FindList("areaName");
+          name_list && !name_list->empty() && (*name_list)[0].is_dict()) {
+        if (const std::string* val =
+                (*name_list)[0].GetDict().FindString("value");
+            val && !val->empty()) {
+          city_name = *val;
+        }
+      }
+    }
+
+    base::Value::Dict out;
+    out.Set("ok", true);
+    out.Set("city", city_name);
+    out.Set("tempC", static_cast<int>(std::round(temp_c)));
+    out.Set("highC", static_cast<int>(std::round(high_c)));
+    out.Set("lowC", static_cast<int>(std::round(low_c)));
+    out.Set("weatherCode", MapWwoCodeToWmo(wwo_code));
+    out.Set("windKmh", static_cast<int>(std::round(wind_kmh)));
+    out.Set("humidity", static_cast<int>(std::round(humidity)));
+    ResolveJavascriptCallback(base::Value(callback_id), out);
+  }
+
+  void HandleActivateVeloxTabGroup(const base::Value::List& args) {
+    if (args.empty()) {
+      return;
+    }
+    std::string group_id_str;
+    if (args[0].is_string()) {
+      group_id_str = args[0].GetString();
+    }
+    Browser* browser = chrome::FindBrowserWithTab(web_ui()->GetWebContents());
+    if (browser && browser->tab_strip_model()) {
+      TabStripModel* model = browser->tab_strip_model();
+      if (model->SupportsTabGroups() && model->group_model()) {
+        TabGroupModel* group_model = model->group_model();
+        for (const tab_groups::TabGroupId& group_id :
+             group_model->ListTabGroups()) {
+          if (group_id.ToString() == group_id_str) {
+            TabGroup* group = group_model->GetTabGroup(group_id);
+            if (group) {
+              std::optional<int> first_tab = group->GetFirstTab();
+              if (first_tab.has_value()) {
+                if (group->visual_data()->is_collapsed()) {
+                  group->SetVisualData(
+                      tab_groups::TabGroupVisualData(
+                          group->visual_data()->title(),
+                          group->visual_data()->color(),
+                          /*is_collapsed=*/false),
+                      true);
+                }
+                model->ActivateTabAt(first_tab.value());
+                browser->window()->Activate();
+              }
+            }
+            break;
+          }
+        }
+      }
+    }
+  }
+
+ private:
+  base::CancelableTaskTracker cancelable_task_tracker_;
+  base::WeakPtrFactory<VeloxNtpTabGroupsHandler> weak_ptr_factory_{this};
+};
