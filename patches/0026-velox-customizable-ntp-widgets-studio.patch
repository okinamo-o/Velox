+  void HandleGetVeloxGmailLatest(const base::Value::List& args) {
+    AllowJavascript();
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    std::string callback_id = args[0].GetString();
+    int account_index = 0;
+    if (args.size() > 1 && args[1].is_int()) {
+      account_index = std::clamp(args[1].GetInt(), 0, 5);
+    }
+
+    Profile* profile = Profile::FromWebUI(web_ui());
+    if (!profile || !profile->GetDefaultStoragePartition()) {
+      base::Value::Dict disconnected;
+      disconnected.Set("connected", false);
+      disconnected.Set("accountIndex", account_index);
+      ResolveJavascriptCallback(base::Value(callback_id), disconnected);
+      return;
+    }
+
+    net::NetworkTrafficAnnotationTag traffic_annotation =
+        net::DefineNetworkTrafficAnnotation("velox_ntp_gmail_feed", R"(
+          semantics {
+            sender: "Velox New Tab Page Gmail Widget"
+            description:
+              "Fetches the user's latest Gmail Atom feed summary so the New "
+              "Tab Page Gmail widget can show unread count and latest email."
+            trigger:
+              "User enables the Gmail Inbox Pulse widget on the New Tab Page."
+            data: "Google session cookies stored in the browser profile."
+            destination: WEBSITE
+          }
+          policy {
+            cookies_allowed: YES
+            cookies_store: "user"
+            setting:
+              "Controlled by enabling or hiding the Gmail widget in Velox "
+              "Widget Studio."
+            policy_exception_justification:
+              "Requires explicit user opt-in by enabling the Gmail widget."
+          })");
+
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = GURL(base::StringPrintf(
+        "https://mail.google.com/mail/u/%d/feed/atom", account_index));
+    request->method = "GET";
+    request->credentials_mode = network::mojom::CredentialsMode::kInclude;
+    request->load_flags = net::LOAD_BYPASS_CACHE | net::LOAD_DISABLE_CACHE;
+    const url::Origin mail_origin = url::Origin::Create(request->url);
+    request->site_for_cookies = net::SiteForCookies::FromOrigin(mail_origin);
+    request->update_first_party_url_on_redirect = true;
+    request->trusted_params = network::ResourceRequest::TrustedParams();
+    request->trusted_params->isolation_info = net::IsolationInfo::Create(
+        net::IsolationInfo::RequestType::kMainFrame, mail_origin, mail_origin,
+        request->site_for_cookies);
+
+    auto loader =
+        network::SimpleURLLoader::Create(std::move(request), traffic_annotation);
+    auto* loader_ptr = loader.get();
+    loader_ptr->SetAllowHttpErrorResults(true);
+    loader_ptr->SetRetryOptions(
+        3, network::SimpleURLLoader::RETRY_ON_NETWORK_CHANGE);
+    loader_ptr->DownloadToString(
+        profile->GetDefaultStoragePartition()
+            ->GetURLLoaderFactoryForBrowserProcess()
+            .get(),
+        base::BindOnce(&VeloxNtpTabGroupsHandler::OnGmailFeedLoaded,
+                       weak_ptr_factory_.GetWeakPtr(), callback_id,
+                       account_index, std::move(loader)),
+        64 * 1024);
+  }
+
+  void OnGmailFeedLoaded(std::string callback_id,
+                         int account_index,
+                         std::unique_ptr<network::SimpleURLLoader> loader,
+                         std::unique_ptr<std::string> body) {
+    if (!IsJavascriptAllowed()) {
+      return;
+    }
+
+    int response_code = 0;
+    if (loader->ResponseInfo() && loader->ResponseInfo()->headers) {
+      response_code = loader->ResponseInfo()->headers->response_code();
+    }
+
+    base::Value::Dict result;
+    result.Set("accountIndex", account_index);
+
+    const bool transient_error =
+        loader->NetError() != net::OK || response_code == 0 ||
+        response_code == 429 || response_code >= 500;
+    if (transient_error) {
+      result.Set("transientError", true);
+      ResolveJavascriptCallback(base::Value(callback_id), result);
+      return;
+    }
+
+    if (!body || response_code != 200 ||
+        body->find("<feed") == std::string::npos) {
+      result.Set("connected", false);
+      result.Set("accountEmail", "");
+      result.Set("unreadCount", 0);
+      result.Set("hasMail", false);
+      result.Set("subject", "");
+      result.Set("summary", "");
+      result.Set("senderName", "");
+      result.Set("senderEmail", "");
+      result.Set("link", "");
+      result.Set("issued", "");
+      ResolveJavascriptCallback(base::Value(callback_id), result);
+      return;
+    }
+
+    std::string_view xml(*body);
+    size_t first_entry = xml.find("<entry");
+    std::string_view header_xml =
+        first_entry == std::string_view::npos ? xml : xml.substr(0, first_entry);
+
+    std::string feed_title = ExtractXmlTag(header_xml, "title");
+    std::string account_email;
+    size_t for_pos = feed_title.find(" for ");
+    if (for_pos != std::string::npos && for_pos + 5 < feed_title.size()) {
+      account_email = feed_title.substr(for_pos + 5);
+    }
+
+    int unread_count = 0;
+    std::string fullcount_str = ExtractXmlTag(header_xml, "fullcount");
+    if (!fullcount_str.empty()) {
+      base::StringToInt(fullcount_str, &unread_count);
+    }
+
+    bool has_mail = false;
+    std::string subject;
+    std::string summary;
+    std::string issued;
+    std::string link = base::StringPrintf(
+        "https://mail.google.com/mail/u/%d/#inbox", account_index);
+    std::string sender_name;
+    std::string sender_email;
+
+    if (first_entry != std::string_view::npos) {
+      size_t entry_end = xml.find("</entry>", first_entry);
+      if (entry_end != std::string_view::npos) {
+        std::string_view entry_xml =
+            xml.substr(first_entry, entry_end - first_entry + 8);
+        has_mail = true;
+        subject = ExtractXmlTag(entry_xml, "title");
+        if (subject.empty()) {
+          subject = "(No subject)";
+        }
+        summary = ExtractXmlTag(entry_xml, "summary");
+        issued = ExtractXmlTag(entry_xml, "issued");
+        if (issued.empty()) {
+          issued = ExtractXmlTag(entry_xml, "modified");
+        }
+        std::string parsed_link = ExtractXmlLinkHref(entry_xml);
+        if (!parsed_link.empty()) {
+          link = parsed_link;
+        }
+        size_t author_pos = entry_xml.find("<author");
+        size_t author_end = author_pos == std::string_view::npos
+                                ? std::string_view::npos
+                                : entry_xml.find("</author>", author_pos);
+        if (author_pos != std::string_view::npos &&
+            author_end != std::string_view::npos) {
+          std::string_view author_xml =
+              entry_xml.substr(author_pos, author_end - author_pos + 9);
+          sender_name = ExtractXmlTag(author_xml, "name");
+          sender_email = ExtractXmlTag(author_xml, "email");
+        }
+      }
+    }
+
+    result.Set("connected", true);
+    result.Set("accountEmail", account_email);
+    result.Set("unreadCount", unread_count);
+    result.Set("hasMail", has_mail);
+    result.Set("subject", subject);
+    result.Set("summary", summary);
+    result.Set("senderName", sender_name);
+    result.Set("senderEmail", sender_email);
+    result.Set("link", link);
+    result.Set("issued", issued);
+    ResolveJavascriptCallback(base::Value(callback_id), result);
+  }
