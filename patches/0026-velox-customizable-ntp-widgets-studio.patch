+
+  protected hasFloatingWidgets_(): boolean {
+    return Object.keys(this.widgetPositions_).some(
+        id => (id === 'hero' && this.showHeroWidget_) ||
+            (id === 'clock' && this.showClockWidget_) ||
+            this.enabledWidgets_.includes(id as VeloxWidgetId));
+  }
+
+  protected getDockedWidgetCount_(): number {
+    return this.enabledWidgets_.filter(id => !this.widgetPositions_[id]).length;
