+class VeloxSpaceTabRowView : public views::Button {
+  METADATA_HEADER(VeloxSpaceTabRowView, views::Button)
+
+ public:
+  VeloxSpaceTabRowView(Browser* browser,
+                       int space_index,
+                       int model_index,
+                       const std::u16string& title,
+                       const GURL& url,
+                       const ui::ImageModel& favicon,
+                       bool is_active,
+                       bool is_audio,
+                       base::RepeatingClosure click_cb)
+      : views::Button(base::BindRepeating(&VeloxSpaceTabRowView::OnRowClicked,
+                                          base::Unretained(this))),
+        browser_(browser),
+        space_index_(space_index),
+        model_index_(model_index),
+        is_active_(is_active),
+        click_cb_(std::move(click_cb)) {
+    SetFocusBehavior(views::View::FocusBehavior::NEVER);
+    SetPreferredSize(gfx::Size(270, 34));
+
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets::VH(3, 8), 8));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+
+    // 1. Favicon
+    auto* icon_view = AddChildView(std::make_unique<views::ImageView>());
+    icon_view->SetImageSize(gfx::Size(16, 16));
+    if (!favicon.IsEmpty()) {
+      icon_view->SetImage(favicon);
+    } else {
+      icon_view->SetImage(ui::ImageModel::FromVectorIcon(
+          vector_icons::kGlobeIcon, SkColorSetRGB(148, 163, 184), 16));
+    }
+
+    // 2. Title & Domain container (Vertical)
+    auto* text_col = AddChildView(std::make_unique<views::View>());
+    auto* text_layout = text_col->SetLayoutManager(
+        std::make_unique<views::BoxLayout>(
+            views::BoxLayout::Orientation::kVertical, gfx::Insets(), 1));
+    text_layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kStart);
+    layout->SetFlexForView(text_col, 1);
+
+    std::u16string disp_title = title.empty() ? u"New Tab" : title;
+    auto* title_lbl = text_col->AddChildView(std::make_unique<views::Label>(
+        disp_title, views::style::CONTEXT_LABEL, views::style::STYLE_PRIMARY));
+    title_lbl->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    title_lbl->SetElideBehavior(gfx::ELIDE_TAIL);
+    title_lbl->SetMaximumWidthSingleLine(180);
+    title_lbl->SetEnabledColor(is_active_ ? SkColorSetRGB(255, 255, 255)
+                                          : SkColorSetRGB(226, 232, 240));
+    title_lbl->SetFontList(title_lbl->font_list().Derive(
+        -1, gfx::Font::NORMAL,
+        is_active_ ? gfx::Font::Weight::BOLD : gfx::Font::Weight::NORMAL));
+
+    std::string host = url.host();
+    if (host.empty() && url.SchemeIs("chrome")) {
+      host = "velox";
+    }
+    if (!host.empty()) {
+      auto* host_lbl = text_col->AddChildView(std::make_unique<views::Label>(
+          base::UTF8ToUTF16(host), views::style::CONTEXT_LABEL,
+          views::style::STYLE_SECONDARY));
+      host_lbl->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      host_lbl->SetElideBehavior(gfx::ELIDE_TAIL);
+      host_lbl->SetMaximumWidthSingleLine(180);
+      host_lbl->SetEnabledColor(SkColorSetRGB(100, 116, 139));
+      host_lbl->SetFontList(host_lbl->font_list().Derive(
+          -2, gfx::Font::NORMAL, gfx::Font::Weight::NORMAL));
+    }
+
+    // 3. Audio Indicator if playing
+    if (is_audio) {
+      auto* audio_lbl = AddChildView(std::make_unique<views::Label>(
+          u"🔊", views::style::CONTEXT_LABEL, views::style::STYLE_PRIMARY));
+      audio_lbl->SetTooltipText(u"Playing Audio");
+    }
+
+    // 4. Active tab indicator
+    if (is_active_) {
+      auto* active_badge = AddChildView(std::make_unique<views::Label>(
+          u"• Active", views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+      active_badge->SetEnabledColor(SkColorSetRGB(59, 130, 246));
+      active_badge->SetFontList(active_badge->font_list().Derive(
+          -2, gfx::Font::NORMAL, gfx::Font::Weight::SEMIBOLD));
+    }
+  }
+
+  void OnPaintBackground(gfx::Canvas* canvas) override {
+    const bool is_hovered = GetState() == views::Button::STATE_HOVERED ||
+                            GetState() == views::Button::STATE_PRESSED;
+    if (is_hovered || is_active_) {
+      gfx::ScopedCanvas scoped(canvas);
+      const float s = canvas->UndoDeviceScaleFactor();
+      gfx::RectF rf(GetLocalBounds());
+      rf.Scale(s);
+      rf.Inset(1.0f * s);
+      SkRRect rrect;
+      rrect.setRectXY(gfx::RectFToSkRect(rf), 6.0f * s, 6.0f * s);
+
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setStyle(cc::PaintFlags::kFill_Style);
+      if (is_hovered) {
+        flags.setColor(is_active_ ? SkColorSetARGB(80, 59, 130, 246)
+                                  : SkColorSetARGB(35, 255, 255, 255));
+      } else {
+        flags.setColor(SkColorSetARGB(35, 59, 130, 246));
+      }
+      canvas->sk_canvas()->drawRRect(rrect, flags);
+    }
+  }
+
+ private:
+  void OnRowClicked() {
+    if (browser_) {
+      velox::SwitchWorkspace(browser_, space_index_);
+      if (browser_->tab_strip_model() &&
+          browser_->tab_strip_model()->ContainsIndex(model_index_)) {
+        browser_->tab_strip_model()->ActivateTabAt(model_index_);
+      }
+    }
+    if (click_cb_) {
+      click_cb_.Run();
+    }
+  }
+
+  raw_ptr<Browser> browser_ = nullptr;
+  int space_index_ = 0;
+  int model_index_ = 0;
+  bool is_active_ = false;
+  base::RepeatingClosure click_cb_;
+};
