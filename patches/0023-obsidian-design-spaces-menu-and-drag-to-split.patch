+                                  bool active_is_left) {
+  active_is_left_ = active_is_left;
+
+  // Detach cross-assigned web contents if any to prevent NativeViewHost assertions:
+  if (left_contents_view_->web_contents() == right_contents) {
+    left_contents_view_->SetWebContents(nullptr);
+    left_card_->SetWebContents(nullptr);
+  }
+  if (right_contents_view_->web_contents() == left_contents) {
+    right_contents_view_->SetWebContents(nullptr);
+    right_card_->SetWebContents(nullptr);
+  }
+
+  // Ensure views are visible before attaching web contents:
+  if (!left_card_->GetVisible()) {
+    left_card_->SetVisible(true);
+  }
+  if (!left_contents_view_->GetVisible()) {
+    left_contents_view_->SetVisible(true);
+  }
+  if (divider_view_ && !divider_view_->GetVisible()) {
+    divider_view_->SetVisible(true);
+  }
+  if (!right_card_->GetVisible()) {
+    right_card_->SetVisible(true);
+  }
+  if (!right_contents_view_->GetVisible()) {
+    right_contents_view_->SetVisible(true);
+  }
+
+  if (left_contents_view_->web_contents() != left_contents) {
+    left_contents_view_->SetWebContents(left_contents);
+  }
+  left_card_->SetWebContents(left_contents);
+
