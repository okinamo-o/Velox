+    grid-template-rows: minmax(120px, 24vh) auto minmax(48px, 1fr) auto auto auto !important;
+    gap: 8px 10px !important;
+  }
+}
+
+@media (max-width: 680px) {
+  #veloxLayoutContainer {
+    grid-template-areas:
+        "hero"
+        "time"
+        "search"
+        "shortcuts"
+        "spaces"
+        "focus"
+        "mostused"
+        "footer";
+    grid-template-columns: minmax(0, 1fr) !important;
+    grid-template-rows: auto !important;
+    padding: 16px 12px 64px !important;
+  }
+
+  #veloxHero,
