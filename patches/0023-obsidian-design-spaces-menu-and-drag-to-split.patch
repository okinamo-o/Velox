+    views::Widget* widget =
+        views::BubbleDialogDelegateView::CreateBubble(std::move(bubble));
+    st.active_preview_bubble_widget = widget;
+    st.active_preview_space = space_index;
+    widget->Show();
+  }
+
+  static void ClosePreview() {
+    auto& st = GetVeloxState();
+    if (st.active_preview_bubble_widget) {
+      st.active_preview_bubble_widget->Close();
+      st.active_preview_bubble_widget = nullptr;
+      st.active_preview_space = -1;
+    }
+  }
+
+  VeloxSpaceTabPreviewBubble(views::View* anchor_view,
+                             Browser* browser,
+                             int space_index)
+      : BubbleDialogDelegateView(anchor_view, views::BubbleBorder::TOP_LEFT),
+        browser_(browser),
+        space_index_(space_index) {
+    SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+    set_margins(gfx::Insets::VH(10, 12));
+    set_color(SkColorSetRGB(15, 20, 30));
+    SetCanActivate(false);
+    set_highlight_button_when_shown(false);
+    SetTitle(u"Velox Space Preview");
+    SetShowTitle(false);
+    SetShowCloseButton(false);
+    set_shadow(views::BubbleBorder::STANDARD_SHADOW);
+  }
+
+  ~VeloxSpaceTabPreviewBubble() override {
+    if (GetVeloxState().active_preview_bubble_widget == GetWidget()) {
+      GetVeloxState().active_preview_bubble_widget = nullptr;
+      GetVeloxState().active_preview_space = -1;
+    }
+  }
+
+  void Init() override {
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 6));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kStretch);
+
+    struct TabInfo {
+      int model_idx;
+      std::u16string title;
+      GURL url;
+      ui::ImageModel favicon;
+      bool is_active;
+      bool is_audio;
+    };
+    std::vector<TabInfo> space_tabs;
+
+    BrowserView* bv =
+        browser_ ? BrowserView::GetBrowserViewForBrowser(browser_) : nullptr;
+    TabStrip* tab_strip = bv ? bv->tabstrip() : nullptr;
+    if (tab_strip && browser_->tab_strip_model()) {
+      for (int i = 0; i < tab_strip->GetTabCount(); ++i) {
+        Tab* t = velox::SafeGetTab(tab_strip, i);
+        if (!t || t->closing()) {
+          continue;
+        }
+        if (velox::GetTabWorkspace(t) == space_index_) {
+          bool audio = false;
+          for (TabAlertState alert : t->data().alert_state) {
+            if (alert == TabAlertState::AUDIO_PLAYING) {
+              audio = true;
+              break;
+            }
+          }
+          space_tabs.push_back({
+              i,
+              t->data().title,
+              t->data().visible_url,
+              t->data().favicon,
+              t->IsActive(),
+              audio,
+          });
+        }
+      }
+    }
+
+    const int cur_ws =
+        tab_strip ? velox::GetTabStripActiveWorkspace(tab_strip) : 0;
+    const bool is_current_space = (cur_ws == space_index_);
+
+    // 1. Header Row
+    auto* header = AddChildView(std::make_unique<views::View>());
+    auto* h_layout =
+        header->SetLayoutManager(std::make_unique<views::BoxLayout>(
+            views::BoxLayout::Orientation::kHorizontal, gfx::Insets::VH(0, 2), 6));
+    h_layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+
+    std::u16string space_title =
+        base::NumberToString16(space_index_ + 1) + u" " +
+        velox::GetSpaceName(space_index_);
+    auto* space_lbl = header->AddChildView(std::make_unique<views::Label>(
+        space_title, views::style::CONTEXT_DIALOG_TITLE,
+        views::style::STYLE_PRIMARY));
+    space_lbl->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    space_lbl->SetEnabledColor(SkColorSetRGB(241, 245, 249));
+    space_lbl->SetFontList(space_lbl->font_list().Derive(
+        1, gfx::Font::NORMAL, gfx::Font::Weight::BOLD));
+    h_layout->SetFlexForView(space_lbl, 1);
+
+    if (is_current_space) {
+      auto* active_pill = header->AddChildView(std::make_unique<views::Label>(
+          u"Active", views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+      active_pill->SetEnabledColor(SkColorSetRGB(96, 165, 250));
+      active_pill->SetFontList(active_pill->font_list().Derive(
+          -2, gfx::Font::NORMAL, gfx::Font::Weight::BOLD));
+    }
+
+    std::u16string count_text = base::NumberToString16(space_tabs.size()) +
+                                (space_tabs.size() == 1 ? u" tab" : u" tabs");
+    auto* count_lbl = header->AddChildView(std::make_unique<views::Label>(
+        count_text, views::style::CONTEXT_LABEL,
+        views::style::STYLE_SECONDARY));
+    count_lbl->SetEnabledColor(SkColorSetRGB(148, 163, 184));
+    count_lbl->SetFontList(count_lbl->font_list().Derive(
+        -2, gfx::Font::NORMAL, gfx::Font::Weight::SEMIBOLD));
+
+    // Hairline divider
+    auto* divider = AddChildView(std::make_unique<views::View>());
+    divider->SetPreferredSize(gfx::Size(270, 1));
+    divider->SetBackground(
+        views::CreateSolidBackground(SkColorSetARGB(35, 255, 255, 255)));
+
+    // Tab Rows or Empty State
+    if (space_tabs.empty()) {
+      auto* empty_box = AddChildView(std::make_unique<views::View>());
+      auto* e_layout =
+          empty_box->SetLayoutManager(std::make_unique<views::BoxLayout>(
+              views::BoxLayout::Orientation::kVertical, gfx::Insets::VH(10, 4),
+              3));
+      e_layout->set_cross_axis_alignment(
+          views::BoxLayout::CrossAxisAlignment::kCenter);
+
+      auto* empty_msg = empty_box->AddChildView(std::make_unique<views::Label>(
+          u"No tabs in this space", views::style::CONTEXT_LABEL,
+          views::style::STYLE_PRIMARY));
+      empty_msg->SetEnabledColor(SkColorSetRGB(203, 213, 225));
+      empty_msg->SetFontList(empty_msg->font_list().Derive(
+          -1, gfx::Font::NORMAL, gfx::Font::Weight::SEMIBOLD));
+
+      auto* empty_sub = empty_box->AddChildView(std::make_unique<views::Label>(
+          u"Click to switch or move tabs here via right-click",
+          views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+      empty_sub->SetEnabledColor(SkColorSetRGB(100, 116, 139));
+      empty_sub->SetFontList(empty_sub->font_list().Derive(
+          -2, gfx::Font::NORMAL, gfx::Font::Weight::NORMAL));
+    } else {
+      const size_t max_show = 7;
+      for (size_t i = 0; i < std::min(space_tabs.size(), max_show); ++i) {
+        const auto& t = space_tabs[i];
+        AddChildView(std::make_unique<VeloxSpaceTabRowView>(
+            browser_, space_index_, t.model_idx, t.title, t.url, t.favicon,
+            t.is_active, t.is_audio,
+            base::BindRepeating(&VeloxSpaceTabPreviewBubble::ClosePreview)));
+      }
+      if (space_tabs.size() > max_show) {
+        auto* more_lbl = AddChildView(std::make_unique<views::Label>(
+            u"+ " + base::NumberToString16(space_tabs.size() - max_show) +
+                u" more tabs",
+            views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+        more_lbl->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+        more_lbl->SetEnabledColor(SkColorSetRGB(148, 163, 184));
+        more_lbl->SetFontList(more_lbl->font_list().Derive(
+            -2, gfx::Font::ITALIC, gfx::Font::Weight::NORMAL));
+      }
+    }
+  }
+
+ private:
+  raw_ptr<Browser> browser_ = nullptr;
+  int space_index_ = 0;
+};
