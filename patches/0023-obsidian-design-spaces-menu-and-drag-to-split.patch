+  if (partner != kNoTab) {
+    GetTabModelAtIndex(partner)->set_split(false);
+  }
+
+  UpdateWebContentsStateAt(index, TabChangeType::kAll);
+  if (partner != kNoTab) {
+    UpdateWebContentsStateAt(partner, TabChangeType::kAll);
+  }
+
+  for (TabStripModelObserver& observer : observers_) {
+    observer.OnSplitViewRemoved();
+  }
+}
+
+int TabStripModel::GetSplitPartnerIndex(int index) const {
+  if (!ContainsIndex(index)) {
+    return kNoTab;
+  }
+  const int id = GetTabModelAtIndex(index)->split_id();
+  if (id == 0) {
+    return kNoTab;
+  }
+  if (ContainsIndex(index - 1) &&
+      GetTabModelAtIndex(index - 1)->split_id() == id) {
+    return index - 1;
+  }
+  if (ContainsIndex(index + 1) &&
+      GetTabModelAtIndex(index + 1)->split_id() == id) {
+    return index + 1;
+  }
+  return kNoTab;
+}
+
+void TabStripModel::CleanUpOrphanedSplits() {
+  std::vector<int> orphaned;
+  for (int i = 0; i < count(); ++i) {
+    if (GetTabModelAtIndex(i)->IsSplit() && GetSplitPartnerIndex(i) == kNoTab) {
+      orphaned.push_back(i);
+    }
+  }
+  if (orphaned.empty()) {
+    return;
+  }
+  for (int i : orphaned) {
+    GetTabModelAtIndex(i)->set_split(false);
+  }
+  for (int i : orphaned) {
+    UpdateWebContentsStateAt(i, TabChangeType::kAll);
+  }
+  for (TabStripModelObserver& observer : observers_) {
+    observer.OnSplitViewRemoved();
+  }
+}
+
+void TabStripModel::StartSplitSelection(int index) {
+  if (!ContainsIndex(index)) {
+    return;
+  }
+  CancelSplitSelection();
+  pending_split_tab_ = GetTabModelAtIndex(index);
+  for (TabStripModelObserver& observer : observers_) {
+    observer.TabChangedAt(GetWebContentsAt(index), index, TabChangeType::kAll);
+  }
+}
+
+void TabStripModel::CancelSplitSelection() {
+  if (!pending_split_tab_) {
+    return;
+  }
+  const int index = GetIndexOfTab(pending_split_tab_);
+  pending_split_tab_ = nullptr;
+  if (ContainsIndex(index)) {
+    for (TabStripModelObserver& observer : observers_) {
+      observer.TabChangedAt(GetWebContentsAt(index), index, TabChangeType::kAll);
+    }
+  }
+}
+
+std::optional<int> TabStripModel::pending_split_tab_index() const {
+  if (!pending_split_tab_) {
+    return std::nullopt;
+  }
+  const int index = GetIndexOfTab(pending_split_tab_);
+  if (index == kNoTab) {
+    return std::nullopt;
+  }
+  return index;
+}
+
+bool TabStripModel::IsPendingSplitTab(int index) const {
+  return pending_split_tab_ && ContainsIndex(index) &&
+         GetTabModelAtIndex(index) == pending_split_tab_;
+}
