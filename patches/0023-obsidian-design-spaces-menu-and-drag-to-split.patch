+    SetShowTitle(false);
+    SetShowCloseButton(true);
+  }
+
+  ~VeloxRenameSpaceBubble() override {
+    if (GetVeloxState().active_rename_bubble_widget == GetWidget()) {
+      GetVeloxState().active_rename_bubble_widget = nullptr;
+    }
