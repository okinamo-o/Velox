+    column-gap: 10px;
+    display: flex;
+    flex-wrap: wrap;
+  }
+
+  .velox-date-label {
+    flex-basis: 100%;
+  }
+
+  .velox-clock-text {
+    margin: 0;
+  }
+
+  .velox-qa-grid,
+  .velox-stats-bar,
+  .velox-mostused-widget .velox-widget-list {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
