+void TabStripModel::RemoveFromSplit(int index) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  if (!ContainsIndex(index)) {
+    return;
+  }
+  // Only un-split this tab and its own partner, never a neighbouring pair.
