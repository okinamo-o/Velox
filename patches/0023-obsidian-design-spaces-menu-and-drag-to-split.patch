+// ============================================================================
+// Velox Spaces (Workspaces) Infrastructure
+// ============================================================================
+
+class VeloxSpacesControl;
+
+struct TabSpacePersistedEntry {
+  int index = -1;
+  std::string url;
+  int ws = 0;
+};
+
+struct VeloxRuntimeState {
+  std::map<const Tab*, int> tab_workspaces;
+  std::map<const Tab*, TabStrip*> tab_to_tabstrip;
+  std::map<const TabStrip*, int> tabstrip_active_workspace;
+  std::map<const TabStrip*, TabContainer*> tabstrip_containers;
+  std::map<const TabStrip*, int> last_removed_workspace;
+  std::map<std::pair<const TabStrip*, int>, const Tab*> last_active_tab;
+  std::map<std::pair<const TabStrip*, int>, std::vector<const Tab*>> workspace_active_stack;
+  std::map<std::pair<const TabStrip*, int>, std::vector<const Tab*>> recent_visited_tabs;
+  bool switching_workspace = false;
+
+  // Persistence of tab -> space assignments across browser restarts.
+  // Pending entries loaded from disk, consumed as restored tabs are added.
+  std::vector<TabSpacePersistedEntry> pending_restore;
+  std::set<const Tab*> restored_tabs;
+  bool tab_spaces_loaded = false;
+  bool loaded_has_space_zero = false;
+  int persisted_active_workspace = -1;
+  bool save_scheduled = false;
+  bool post_restore_sync_scheduled = false;
+  base::TimeTicks restore_deadline;
+  base::FilePath tab_spaces_file;
+
+  std::set<VeloxSpacesControl*> spaces_controls;
+  std::vector<std::u16string> space_names = {u"General", u"Work", u"Focus"};
+  bool space_names_loaded = false;
+  raw_ptr<views::Widget> active_rename_bubble_widget = nullptr;
+  raw_ptr<views::Widget> active_preview_bubble_widget = nullptr;
+  int active_preview_space = -1;
+};
+
+VeloxRuntimeState& GetVeloxState() {
+  static base::NoDestructor<VeloxRuntimeState> state;
+  return *state;
+}
+
+void NotifyVeloxSpacesControls();
+
+namespace velox {
+
+int GetSpaceCount() {
+  auto& st = GetVeloxState();
+  if (st.space_names.empty()) {
+    st.space_names = {u"General", u"Work", u"Focus"};
+  }
+  return static_cast<int>(st.space_names.size());
+}
+
+const std::u16string& GetSpaceName(int index) {
+  auto& st = GetVeloxState();
+  if (index >= 0 && index < static_cast<int>(st.space_names.size())) {
+    return st.space_names[index];
+  }
+  static const base::NoDestructor<std::u16string> kEmpty(u"");
+  return *kEmpty;
+}
+
+void LoadSpaceNames(Profile* profile) {
+  auto& st = GetVeloxState();
+  if (st.space_names_loaded || !profile) {
+    return;
+  }
+  base::FilePath json_file =
+      profile->GetPath().Append(FILE_PATH_LITERAL("velox_spaces.json"));
+  std::string content;
+  if (base::ReadFileToString(json_file, &content)) {
+    auto parsed = base::JSONReader::Read(content);
+    if (parsed && parsed->is_list()) {
+      const auto& list = parsed->GetList();
+      if (!list.empty()) {
+        st.space_names.clear();
+        for (size_t i = 0; i < std::min(size_t(9), list.size()); ++i) {
+          if (list[i].is_string()) {
+            std::string str = list[i].GetString();
+            st.space_names.push_back(
+                str.empty() ? (u"Space " + base::NumberToString16(i + 1))
+                            : base::UTF8ToUTF16(str));
+          }
+        }
+      }
+    }
+  }
+  if (st.space_names.empty()) {
+    st.space_names = {u"General", u"Work", u"Focus"};
+  }
+  st.space_names_loaded = true;
+}
+
+void SaveSpaceNames(Profile* profile) {
+  if (!profile) {
+    return;
+  }
+  auto& st = GetVeloxState();
+  base::Value::List list;
+  for (size_t i = 0; i < st.space_names.size(); ++i) {
+    list.Append(base::UTF16ToUTF8(st.space_names[i]));
+  }
+  std::string json_str;
+  if (base::JSONWriter::Write(list, &json_str)) {
+    base::FilePath json_file =
+        profile->GetPath().Append(FILE_PATH_LITERAL("velox_spaces.json"));
+    base::WriteFile(json_file, json_str);
+  }
+}
+
+void SetSpaceName(int index, const std::u16string& new_name, Profile* profile) {
+  auto& st = GetVeloxState();
+  if (index < 0 || index >= static_cast<int>(st.space_names.size())) {
+    return;
+  }
+  st.space_names[index] = new_name;
+  SaveSpaceNames(profile);
+  NotifyVeloxSpacesControls();
+}
+
+int CreateNewSpace(Profile* profile, const std::u16string& optional_name = u"") {
+  auto& st = GetVeloxState();
+  if (st.space_names.size() >= 9) {
+    return -1;
+  }
+  int new_idx = static_cast<int>(st.space_names.size());
+  std::u16string final_name = optional_name.empty()
+      ? (u"Space " + base::NumberToString16(new_idx + 1))
+      : optional_name;
+  st.space_names.push_back(final_name);
+  SaveSpaceNames(profile);
+  NotifyVeloxSpacesControls();
+  return new_idx;
+}
+
+bool DeleteSpace(int space_idx, Browser* browser);
+
+void RegisterTabContainer(TabStrip* tab_strip, TabContainer* container) {
+  auto& st = GetVeloxState();
+  st.tabstrip_containers[tab_strip] = container;
+  if (st.tabstrip_active_workspace.find(tab_strip) ==
+      st.tabstrip_active_workspace.end()) {
+    st.tabstrip_active_workspace[tab_strip] = 0;
+  }
+}
+
+void RecordActiveTabInWorkspace(const TabStrip* tab_strip,
+                                int ws,
+                                const Tab* tab) {
+  if (!tab_strip || !tab) {
+    return;
+  }
+  auto& st = GetVeloxState();
+  auto& stack = st.workspace_active_stack[{tab_strip, ws}];
+  auto it = std::find(stack.begin(), stack.end(), tab);
+  if (it != stack.end()) {
+    stack.erase(it);
+  }
+  stack.insert(stack.begin(), tab);
+}
+
+void RemoveTabFromWorkspaceStack(const TabStrip* tab_strip,
+                                 int ws,
+                                 const Tab* tab) {
+  if (!tab_strip || !tab) {
+    return;
+  }
+  auto& st = GetVeloxState();
+  auto& stack = st.workspace_active_stack[{tab_strip, ws}];
+  auto it = std::find(stack.begin(), stack.end(), tab);
+  if (it != stack.end()) {
+    stack.erase(it);
+  }
+  auto& recent = st.recent_visited_tabs[{tab_strip, ws}];
+  auto rit = std::find(recent.begin(), recent.end(), tab);
+  if (rit != recent.end()) {
+    recent.erase(rit);
+  }
+}
+
+void OnTabStripDestroyed(TabStrip* tab_strip) {
+  auto& st = GetVeloxState();
+  st.tabstrip_containers.erase(tab_strip);
+  st.tabstrip_active_workspace.erase(tab_strip);
+  st.last_removed_workspace.erase(tab_strip);
+  for (int w = 0; w < 3; ++w) {
+    auto key = std::make_pair(static_cast<const TabStrip*>(tab_strip), w);
+    st.workspace_active_stack.erase(key);
+    st.recent_visited_tabs.erase(key);
+    st.last_active_tab.erase(key);
+  }
+  for (auto it = st.tab_to_tabstrip.begin(); it != st.tab_to_tabstrip.end();) {
+    if (it->second == tab_strip) {
+      st.tab_workspaces.erase(it->first);
+      st.restored_tabs.erase(it->first);
+      it = st.tab_to_tabstrip.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+int GetTabWorkspace(const Tab* tab) {
+  auto& st = GetVeloxState();
+  auto it = st.tab_workspaces.find(tab);
+  return it != st.tab_workspaces.end() ? it->second : 0;
+}
+
+int GetTabStripActiveWorkspace(const TabStrip* tab_strip) {
+  if (!tab_strip) {
+    return 0;
+  }
+  auto& st = GetVeloxState();
+  auto it = st.tabstrip_active_workspace.find(tab_strip);
+  return it != st.tabstrip_active_workspace.end() ? it->second : 0;
+}
+
+bool IsTabInActiveWorkspace(const Tab* tab) {
+  if (!tab || tab->dragging()) {
+    return true;
+  }
+  auto& st = GetVeloxState();
+  auto ts_it = st.tab_to_tabstrip.find(tab);
+  if (ts_it == st.tab_to_tabstrip.end() || !ts_it->second) {
+    return true;
+  }
+  return GetTabWorkspace(tab) == GetTabStripActiveWorkspace(ts_it->second);
+}
+
+int GetTabRecentVisitRank(const Tab* tab) {
+  if (!tab || tab->closing() || tab->IsActive()) {
+    return 0;
+  }
+  auto& st = GetVeloxState();
+  auto ts_it = st.tab_to_tabstrip.find(tab);
+  if (ts_it == st.tab_to_tabstrip.end() || !ts_it->second) {
+    return 0;
+  }
+  const TabStrip* tab_strip = ts_it->second;
+  const int ws = GetTabWorkspace(tab);
+  auto rec_it = st.recent_visited_tabs.find({tab_strip, ws});
+  if (rec_it == st.recent_visited_tabs.end()) {
+    return 0;
+  }
+  int inactive_rank = 0;
+  for (const Tab* cand : rec_it->second) {
+    if (!cand || cand->closing() || cand->IsActive()) {
+      continue;
+    }
+    ++inactive_rank;
+    if (cand == tab) {
+      return inactive_rank <= 3 ? inactive_rank : 0;
+    }
+    if (inactive_rank >= 3) {
+      break;
+    }
+  }
+  return 0;
+}
+
+// ---- Tab space persistence ------------------------------------------------
+
+namespace {
+
+Profile* ProfileForTabStrip(const TabStrip* tab_strip) {
+  if (!tab_strip) {
+    return nullptr;
+  }
+  auto* bwi = const_cast<TabStrip*>(tab_strip)->GetBrowserWindowInterface();
+  if (!bwi) {
+    return nullptr;
+  }
+  return bwi->GetProfile();
+}
+
+bool IsTabStripClosingAll(const TabStrip* tab_strip) {
+  if (!tab_strip) {
+    return false;
+  }
+  auto* bwi = const_cast<TabStrip*>(tab_strip)->GetBrowserWindowInterface();
+  if (!bwi) {
+    return false;
+  }
+  if (bwi->IsAttemptingToCloseBrowser()) {
+    return true;
+  }
+  if (Browser* browser = bwi->GetBrowserForMigrationOnly()) {
+    if (browser->IsBrowserClosing() || browser->is_delete_scheduled()) {
+      return true;
+    }
+  }
+  TabStripModel* model = bwi->GetTabStripModel();
+  return model && model->closing_all();
+}
+
+bool IsSessionRestoringForTabStrip(const TabStrip* tab_strip) {
+  Profile* profile = ProfileForTabStrip(tab_strip);
+  return profile && SessionRestore::IsRestoring(profile);
+}
+
+void EnsureTabSpacesLoaded(TabStrip* tab_strip) {
+  auto& st = GetVeloxState();
+  if (st.tab_spaces_loaded) {
+    return;
+  }
+  Profile* profile = ProfileForTabStrip(tab_strip);
+  if (!profile || profile->IsOffTheRecord()) {
+    return;
+  }
+  st.tab_spaces_loaded = true;
+  st.tab_spaces_file =
+      profile->GetPath().Append(FILE_PATH_LITERAL("velox_tab_spaces.json"));
+  st.restore_deadline = base::TimeTicks::Now() + base::Seconds(45);
+
+  std::string content;
+  if (!base::ReadFileToString(st.tab_spaces_file, &content)) {
+    return;
+  }
+  auto parsed = base::JSONReader::Read(content);
+  if (!parsed) {
+    return;
+  }
+  const base::Value::List* list_ptr = nullptr;
+  if (parsed->is_list()) {
+    list_ptr = &parsed->GetList();
+  } else if (parsed->is_dict()) {
+    const base::Value::Dict& root = parsed->GetDict();
+    if (std::optional<int> active_ws = root.FindInt("active_ws");
+        active_ws && *active_ws >= 0 && *active_ws < 3) {
+      st.persisted_active_workspace = *active_ws;
+    }
+    list_ptr = root.FindList("tabs");
+  }
+  if (!list_ptr) {
+    return;
+  }
+  for (const auto& item : *list_ptr) {
+    if (!item.is_dict()) {
+      continue;
+    }
+    const base::Value::Dict& d = item.GetDict();
+    if (std::optional<int> active_ws = d.FindInt("active_ws");
+        active_ws && *active_ws >= 0 && *active_ws < 3 &&
+        st.persisted_active_workspace == -1) {
+      st.persisted_active_workspace = *active_ws;
+    }
+    std::optional<int> ws = d.FindInt("ws");
+    if (!ws || *ws < 0 || *ws >= 3) {
+      continue;
+    }
+    if (*ws == 0) {
+      st.loaded_has_space_zero = true;
+    }
+    const std::string* url = d.FindString("url");
+    std::optional<int> idx = d.FindInt("index");
+    TabSpacePersistedEntry entry;
+    entry.index = idx.value_or(-1);
+    entry.url = url ? *url : std::string();
+    entry.ws = *ws;
+    st.pending_restore.push_back(std::move(entry));
+  }
+}
+
+void WriteTabSpacesFile(const std::vector<TabSpacePersistedEntry>& entries,
+                        int active_ws) {
+  auto& st = GetVeloxState();
+  if (st.tab_spaces_file.empty()) {
+    return;
+  }
+  base::Value::List list;
+  for (const auto& entry : entries) {
+    base::Value::Dict d;
+    d.Set("index", entry.index);
+    d.Set("url", entry.url);
+    d.Set("ws", entry.ws);
+    d.Set("active_ws", active_ws);
+    list.Append(std::move(d));
+  }
+  std::string json_str;
+  if (base::JSONWriter::Write(list, &json_str)) {
+    base::WriteFile(st.tab_spaces_file, json_str);
+  }
+}
+
+Tab* SafeGetTab(const TabStrip* tab_strip, int index) {
+  if (!tab_strip || index < 0 || index >= tab_strip->GetTabCount()) {
+    return nullptr;
+  }
+  return const_cast<TabStrip*>(tab_strip)->tab_at(index);
+}
+
+void AppendTabStripEntries(const TabStrip* tab_strip,
+                           std::vector<TabSpacePersistedEntry>* out) {
+  if (!tab_strip) {
+    return;
+  }
+  auto* bwi = const_cast<TabStrip*>(tab_strip)->GetBrowserWindowInterface();
+  TabStripModel* model = bwi ? bwi->GetTabStripModel() : nullptr;
+
+  const int count = tab_strip->GetTabCount();
+  for (int i = 0; i < count; ++i) {
+    const Tab* tab = SafeGetTab(tab_strip, i);
+    if (!tab || tab->closing()) {
+      continue;
+    }
+    const int max_ws = std::max(0, velox::GetSpaceCount() - 1);
+    const int ws = std::clamp(GetTabWorkspace(tab), 0, max_ws);
+    std::string url_spec;
+    if (model && model->ContainsIndex(i)) {
+      if (auto* wc = model->GetWebContentsAt(i)) {
+        const GURL& u = wc->GetVisibleURL();
+        if (u.is_valid() && !u.is_empty()) {
+          url_spec = u.spec();
+        } else if (wc->GetLastCommittedURL().is_valid()) {
+          url_spec = wc->GetLastCommittedURL().spec();
+        }
+      }
+    }
+    if (url_spec.empty() && tab->data().visible_url.is_valid()) {
+      url_spec = tab->data().visible_url.spec();
+    }
+    out->push_back({i, url_spec, ws});
+  }
+}
+
+}  // namespace
+
+void SaveTabSpaces() {
+  auto& st = GetVeloxState();
+  st.save_scheduled = false;
+  if (st.tab_spaces_file.empty()) {
+    return;
+  }
+  if (browser_shutdown::IsTryingToQuit()) {
+    return;
+  }
+  for (const auto& [tab, ts] : st.tab_to_tabstrip) {
+    if (ts && (IsTabStripClosingAll(ts) || IsSessionRestoringForTabStrip(ts))) {
+      return;
+    }
+  }
+  for (const auto& [ts, container] : st.tabstrip_containers) {
+    if (ts && (IsTabStripClosingAll(ts) || IsSessionRestoringForTabStrip(ts))) {
+      return;
+    }
+  }
+
+  std::set<const TabStrip*> strips;
+  for (const auto& [tab, ts] : st.tab_to_tabstrip) {
+    if (ts) {
+      strips.insert(ts);
+    }
+  }
+  if (strips.empty()) {
+    return;
+  }
+
+  std::vector<TabSpacePersistedEntry> entries;
+  int active_ws = 0;
+  for (const TabStrip* ts : strips) {
+    const int max_ws = std::max(0, velox::GetSpaceCount() - 1);
+    active_ws = std::clamp(GetTabStripActiveWorkspace(ts), 0, max_ws);
+    AppendTabStripEntries(ts, &entries);
+  }
+  if (entries.empty()) {
+    return;
+  }
+  WriteTabSpacesFile(entries, active_ws);
+}
+
+void ScheduleSaveTabSpaces() {
+  auto& st = GetVeloxState();
+  if (st.save_scheduled || browser_shutdown::IsTryingToQuit()) {
+    return;
+  }
+  st.save_scheduled = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&SaveTabSpaces));
+}
+
+void RefreshTabStripLayoutForSpaces(TabStrip* tab_strip);
+
+void RegisterTabInWorkspace(TabStrip* tab_strip, const Tab* tab) {
+  if (!tab_strip || !tab) {
+    return;
+  }
+  EnsureTabSpacesLoaded(tab_strip);
+  auto& st = GetVeloxState();
+  const bool is_restoring = IsSessionRestoringForTabStrip(tab_strip);
+  // During session restore, new tabs must default to Space 0 before
+  // MaybeRestoreTabWorkspace runs, rather than inheriting whichever workspace
+  // happened to be activated by an earlier restored tab.
+  int initial_ws = is_restoring ? 0 : GetTabStripActiveWorkspace(tab_strip);
+  st.tab_to_tabstrip[tab] = tab_strip;
+  st.tab_workspaces[tab] = initial_ws;
+  RecordActiveTabInWorkspace(tab_strip, initial_ws, tab);
+  if (!is_restoring && !IsTabStripClosingAll(tab_strip)) {
+    ScheduleSaveTabSpaces();
+  }
+}
+
+void MaybeRestoreTabWorkspace(TabStrip* tab_strip,
+                              Tab* tab,
+                              int model_index,
+                              const GURL& url) {
+  if (!tab_strip || !tab) {
+    return;
+  }
+  EnsureTabSpacesLoaded(tab_strip);
+  auto& st = GetVeloxState();
+  if (st.restored_tabs.contains(tab)) {
+    return;
+  }
+  if (st.pending_restore.empty()) {
+    return;
+  }
+  if (base::TimeTicks::Now() > st.restore_deadline) {
+    st.pending_restore.clear();
+    return;
+  }
+
+  const std::string url_spec = url.is_valid() ? url.spec() : std::string();
+
+  auto it = st.pending_restore.end();
+  // 1. Match by exact index and matching (or not-yet-populated) URL
+  for (auto iter = st.pending_restore.begin(); iter != st.pending_restore.end();
+       ++iter) {
+    if (iter->index == model_index) {
+      if (url_spec.empty() || iter->url.empty() || iter->url == url_spec) {
+        it = iter;
+        break;
+      }
+    }
+  }
+  // 2. Match by URL if non-empty, preferring the closest index.
+  // When migrating a legacy file that omitted Space 0 tabs, restrict URL
+  // fallback to nearby indices (distance <= 2) so a Space 0 tab sharing a URL
+  // with a distant Space 1/2 tab cannot steal its workspace assignment.
+  if (it == st.pending_restore.end() && !url_spec.empty()) {
+    int best_dist = std::numeric_limits<int>::max();
+    for (auto iter = st.pending_restore.begin();
+         iter != st.pending_restore.end(); ++iter) {
+      if (iter->url == url_spec) {
+        int dist = (iter->index >= 0) ? std::abs(iter->index - model_index) : 0;
+        if (!st.loaded_has_space_zero && dist > 2) {
+          continue;
+        }
+        if (dist < best_dist) {
+          best_dist = dist;
+          it = iter;
+        }
+      }
+    }
+  }
+  // 3. Fallback match by index alone only when full-snapshot entries exist
+  // (or when URL matched index in legacy mode).
+  if (it == st.pending_restore.end() && st.loaded_has_space_zero) {
+    for (auto iter = st.pending_restore.begin();
+         iter != st.pending_restore.end(); ++iter) {
+      if (iter->index == model_index) {
+        it = iter;
+        break;
+      }
+    }
+  }
+
+  if (it == st.pending_restore.end()) {
+    if (!url_spec.empty()) {
+      st.restored_tabs.insert(tab);
+    }
+    return;
+  }
+
+  const int max_ws = std::max(0, velox::GetSpaceCount() - 1);
+  int restored_ws = std::clamp(it->ws, 0, max_ws);
+  st.pending_restore.erase(it);
+  st.restored_tabs.insert(tab);
+
+  int prev_ws = GetTabWorkspace(tab);
+  if (prev_ws != restored_ws) {
+    RemoveTabFromWorkspaceStack(tab_strip, prev_ws, tab);
+  }
+  st.tab_workspaces[tab] = restored_ws;
+  RecordActiveTabInWorkspace(tab_strip, restored_ws, tab);
+
+  const bool is_active_tab =
+      tab->IsActive() ||
+      (tab_strip->GetActiveIndex().has_value() &&
+       static_cast<int>(tab_strip->GetActiveIndex().value()) == model_index);
+  if (is_active_tab) {
+    st.tabstrip_active_workspace[tab_strip] = restored_ws;
+  }
+  if (tab->parent()) {
+    RefreshTabStripLayoutForSpaces(tab_strip);
+  }
+  NotifyVeloxSpacesControls();
+
+  if (!st.post_restore_sync_scheduled) {
+    st.post_restore_sync_scheduled = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce([]() {
+          auto& state = GetVeloxState();
+          state.post_restore_sync_scheduled = false;
+          if (browser_shutdown::IsTryingToQuit()) {
+            return;
+          }
+          bool any_restoring = false;
+          for (const auto& [ts_const, container] : state.tabstrip_containers) {
+            TabStrip* ts = const_cast<TabStrip*>(ts_const);
+            if (!ts || IsTabStripClosingAll(ts)) {
+              continue;
+            }
+            if (IsSessionRestoringForTabStrip(ts)) {
+              any_restoring = true;
+            }
+            if (std::optional<int> active_idx = ts->GetActiveIndex();
+                active_idx.has_value()) {
+              if (Tab* active_tab = SafeGetTab(ts, active_idx.value())) {
+                const int active_ws = GetTabWorkspace(active_tab);
+                state.tabstrip_active_workspace[ts] = active_ws;
+                auto& recent = state.recent_visited_tabs[{ts, active_ws}];
+                if (std::find(recent.begin(), recent.end(), active_tab) ==
+                    recent.end()) {
+                  recent.insert(recent.begin(), active_tab);
+                }
+              }
+            }
+            RefreshTabStripLayoutForSpaces(ts);
+          }
+          if (!any_restoring) {
+            state.pending_restore.clear();
+          }
+          NotifyVeloxSpacesControls();
+          SaveTabSpaces();
+        }),
+        base::Milliseconds(800));
+  }
+}
+
+void OnTabDataChanged(TabStrip* tab_strip, const Tab* tab) {
+  if (!tab_strip || !tab || IsTabStripClosingAll(tab_strip) ||
+      IsSessionRestoringForTabStrip(tab_strip)) {
+    return;
+  }
+  EnsureTabSpacesLoaded(tab_strip);
+  ScheduleSaveTabSpaces();
+}
+
+void OnTabMoved(TabStrip* tab_strip) {
+  if (!tab_strip || IsTabStripClosingAll(tab_strip) ||
+      IsSessionRestoringForTabStrip(tab_strip)) {
+    return;
+  }
+  EnsureTabSpacesLoaded(tab_strip);
+  ScheduleSaveTabSpaces();
+}
+
+void UnregisterTabFromWorkspace(TabStrip* tab_strip, const Tab* tab) {
+  if (!tab) {
+    return;
+  }
+  auto& st = GetVeloxState();
+  int ws = GetTabWorkspace(tab);
+  const bool closing_all = !tab_strip || IsTabStripClosingAll(tab_strip) ||
+                           browser_shutdown::IsTryingToQuit();
+  if (tab_strip) {
+    if (!closing_all) {
+      st.last_removed_workspace[tab_strip] = ws;
+    }
+    RemoveTabFromWorkspaceStack(tab_strip, ws, tab);
+    for (int w = 0; w < 3; ++w) {
+      auto key = std::make_pair(static_cast<const TabStrip*>(tab_strip), w);
+      if (st.last_active_tab[key] == tab) {
+        st.last_active_tab.erase(key);
+      }
+    }
+  }
+  st.tab_workspaces.erase(tab);
+  st.tab_to_tabstrip.erase(tab);
+  st.restored_tabs.erase(tab);
+
+  if (tab_strip && !closing_all && !IsSessionRestoringForTabStrip(tab_strip)) {
+    SaveTabSpaces();
+  }
+}
+
+void RefreshTabStripLayoutForSpaces(TabStrip* tab_strip) {
+  if (!tab_strip || IsTabStripClosingAll(tab_strip) ||
+      browser_shutdown::IsTryingToQuit()) {
+    return;
+  }
+  auto& st = GetVeloxState();
+  auto it = st.tabstrip_containers.find(tab_strip);
+  if (it != st.tabstrip_containers.end() && it->second) {
+    it->second->CompleteAnimationAndLayout();
+    it->second->InvalidateLayout();
+  }
+  tab_strip->InvalidateLayout();
+  tab_strip->SchedulePaint();
+}
+
+void SwitchWorkspace(Browser* browser, int workspace_id) {
+  if (!browser || workspace_id < 0 || workspace_id >= velox::GetSpaceCount()) {
+    return;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view || !browser_view->tabstrip()) {
+    return;
+  }
+  TabStrip* tab_strip = browser_view->tabstrip();
+  auto& st = GetVeloxState();
+  if (GetTabStripActiveWorkspace(tab_strip) == workspace_id) {
+    return;
+  }
+
+  st.switching_workspace = true;
+  st.tabstrip_active_workspace[tab_strip] = workspace_id;
+
+  TabStripModel* model = browser->tab_strip_model();
+
+  int target_index = -1;
+  // 1. Check workspace active stack
+  auto& stack = st.workspace_active_stack[{tab_strip, workspace_id}];
+  for (auto it = stack.begin(); it != stack.end();) {
+    const Tab* cand = *it;
+    bool found = false;
+    if (cand && !cand->closing() && GetTabWorkspace(cand) == workspace_id) {
+      for (int i = 0; i < tab_strip->GetTabCount(); ++i) {
+        if (SafeGetTab(tab_strip, i) == cand) {
+          target_index = i;
+          found = true;
+          break;
+        }
+      }
+    }
+    if (found) {
+      break;
+    } else {
+      it = stack.erase(it);
+    }
+  }
+
+  // 2. Check last_active_tab
+  if (target_index == -1) {
+    const Tab* preferred_tab = st.last_active_tab[{tab_strip, workspace_id}];
+    if (preferred_tab && !preferred_tab->closing() &&
+        GetTabWorkspace(preferred_tab) == workspace_id) {
+      for (int i = 0; i < tab_strip->GetTabCount(); ++i) {
+        if (SafeGetTab(tab_strip, i) == preferred_tab) {
+          target_index = i;
+          break;
+        }
+      }
+    }
+  }
+
+  // 3. Fall back to MRU via GetLastActiveTimeTicks()
+  if (target_index == -1) {
+    int mru_index = -1;
+    base::TimeTicks mru_time;
+    for (int i = 0; i < tab_strip->GetTabCount(); ++i) {
+      Tab* t = SafeGetTab(tab_strip, i);
+      if (!t || t->closing() || GetTabWorkspace(t) != workspace_id) {
+        continue;
+      }
+      WebContents* wc =
+          (model && model->ContainsIndex(i)) ? model->GetWebContentsAt(i)
+                                             : nullptr;
+      const base::TimeTicks t_active =
+          wc ? wc->GetLastActiveTimeTicks() : base::TimeTicks();
+      if (mru_index == -1 || t_active > mru_time) {
+        mru_index = i;
+        mru_time = t_active;
+      }
+    }
+    target_index = mru_index;
+  }
+
+  if (model && model->IsSplitSelectionActive()) {
+    model->CancelSplitSelection();
+  }
+  if (target_index != -1 && model && model->ContainsIndex(target_index)) {
+    model->ActivateTabAt(target_index);
+  } else {
+    chrome::NewTab(browser);
+  }
+
+  // Freeze inactive workspace background tabs (if not playing audio) to save RAM
+  if (model) {
+    for (int i = 0; i < model->count() && i < tab_strip->GetTabCount(); ++i) {
+      WebContents* wc = model->GetWebContentsAt(i);
+      Tab* t = SafeGetTab(tab_strip, i);
+      if (!wc || !t) {
+        continue;
+      }
+      int w = GetTabWorkspace(t);
+      if (w != workspace_id) {
+        if (wc->GetVisibility() == content::Visibility::HIDDEN &&
+            !wc->IsCurrentlyAudible() && !wc->IsBeingCaptured()) {
+          wc->SetPageFrozen(true);
+        }
+      }
+    }
+  }
+
+  st.switching_workspace = false;
+  RefreshTabStripLayoutForSpaces(tab_strip);
+  NotifyVeloxSpacesControls();
+  EnsureTabSpacesLoaded(tab_strip);
+  ScheduleSaveTabSpaces();
+}
+
+void MoveTabsToEndOfWorkspace(TabStrip* tab_strip,
+                             TabStripModel* model,
+                             const std::vector<Tab*>& moving_tabs,
+                             int target_workspace) {
+  if (!tab_strip || !model || moving_tabs.empty()) {
+    return;
+  }
+
+  for (Tab* moving_tab : moving_tabs) {
+    if (!moving_tab || moving_tab->closing()) {
+      continue;
+    }
+    auto opt_current_idx = tab_strip->GetModelIndexOf(moving_tab);
+    if (!opt_current_idx.has_value()) {
+      continue;
+    }
+    int current_idx = opt_current_idx.value();
+    const bool is_pinned = moving_tab->data().pinned;
+
+    int last_target_idx = -1;
+    for (int i = model->count() - 1; i >= 0; --i) {
+      if (i == current_idx) {
+        continue;
+      }
+      Tab* t = SafeGetTab(tab_strip, i);
+      if (t && !t->closing() && GetTabWorkspace(t) == target_workspace &&
+          t->data().pinned == is_pinned) {
+        last_target_idx = i;
+        break;
+      }
+    }
+
+    int to_idx = -1;
+    if (last_target_idx != -1) {
+      if (current_idx < last_target_idx) {
+        to_idx = last_target_idx;
+      } else {
+        to_idx = last_target_idx + 1;
+      }
+    } else {
+      if (is_pinned) {
+        to_idx = std::max(0, model->IndexOfFirstNonPinnedTab() - 1);
+      } else {
+        to_idx = model->count() - 1;
+      }
+    }
+
+    if (to_idx >= 0 && to_idx < model->count() && to_idx != current_idx) {
+      model->MoveWebContentsAt(current_idx, to_idx, /*select_after_move=*/false);
+    }
+  }
+}
+
+void MoveActiveTabToWorkspace(Browser* browser, int workspace_id) {
+  if (!browser || workspace_id < 0 || workspace_id >= velox::GetSpaceCount()) {
+    return;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view || !browser_view->tabstrip()) {
+    return;
+  }
+  TabStrip* tab_strip = browser_view->tabstrip();
+  TabStripModel* model = browser->tab_strip_model();
+  int active_idx = model->active_index();
+  if (active_idx >= 0 && active_idx < tab_strip->GetTabCount()) {
+    std::vector<Tab*> moving_tabs;
+    int partner_idx = model->GetSplitPartnerIndex(active_idx);
+    if (partner_idx != TabStripModel::kNoTab &&
+        partner_idx < tab_strip->GetTabCount()) {
+      if (Tab* partner_tab = SafeGetTab(tab_strip, partner_idx)) {
+        int old_partner_ws = GetTabWorkspace(partner_tab);
+        RemoveTabFromWorkspaceStack(tab_strip, old_partner_ws, partner_tab);
+        GetVeloxState().tab_workspaces[partner_tab] = workspace_id;
+        RecordActiveTabInWorkspace(tab_strip, workspace_id, partner_tab);
+        moving_tabs.push_back(partner_tab);
+      }
+    }
+    Tab* active_tab = SafeGetTab(tab_strip, active_idx);
+    if (active_tab) {
+      int old_ws = GetTabWorkspace(active_tab);
+      RemoveTabFromWorkspaceStack(tab_strip, old_ws, active_tab);
+      auto old_key =
+          std::make_pair(static_cast<const TabStrip*>(tab_strip), old_ws);
+      if (GetVeloxState().last_active_tab[old_key] == active_tab) {
+        GetVeloxState().last_active_tab.erase(old_key);
+      }
+      GetVeloxState().tab_workspaces[active_tab] = workspace_id;
+      RecordActiveTabInWorkspace(tab_strip, workspace_id, active_tab);
+      auto new_key =
+          std::make_pair(static_cast<const TabStrip*>(tab_strip), workspace_id);
+      GetVeloxState().last_active_tab[new_key] = active_tab;
+      moving_tabs.push_back(active_tab);
+    }
+    MoveTabsToEndOfWorkspace(tab_strip, model, moving_tabs, workspace_id);
+  }
+  SwitchWorkspace(browser, workspace_id);
+  EnsureTabSpacesLoaded(tab_strip);
+  SaveTabSpaces();
+}
+
+int GetTabWorkspaceAtIndex(TabStripModel* model, int tab_index) {
+  if (!model || tab_index < 0 || tab_index >= model->count()) {
+    return 0;
+  }
+  content::WebContents* contents = model->GetWebContentsAt(tab_index);
+  if (!contents) {
+    return 0;
+  }
+  Browser* browser = chrome::FindBrowserWithTab(contents);
+  if (!browser) {
+    return 0;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view || !browser_view->tabstrip()) {
+    return 0;
+  }
+  TabStrip* tab_strip = browser_view->tabstrip();
+  Tab* tab = SafeGetTab(tab_strip, tab_index);
+  return tab ? GetTabWorkspace(tab) : 0;
+}
+
+void MoveTabAtIndexToWorkspace(TabStripModel* model, int tab_index, int target_workspace) {
+  if (!model || tab_index < 0 || tab_index >= model->count() ||
+      target_workspace < 0 || target_workspace >= velox::GetSpaceCount()) {
+    return;
+  }
+  content::WebContents* contents = model->GetWebContentsAt(tab_index);
+  if (!contents) {
+    return;
+  }
+  Browser* browser = chrome::FindBrowserWithTab(contents);
+  if (!browser) {
+    return;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view || !browser_view->tabstrip()) {
+    return;
+  }
+  TabStrip* tab_strip = browser_view->tabstrip();
+  auto& st = GetVeloxState();
+
+  // Determine all tab indices to move (if multi-selected, move all selected tabs)
+  std::vector<int> indices;
+  if (model->IsTabSelected(tab_index)) {
+    for (int sel : model->selection_model().selected_indices()) {
+      indices.push_back(sel);
+    }
+  } else {
+    indices.push_back(tab_index);
+  }
+
+  // Also include split screen partners if any of the moving tabs are split
+  std::set<int> all_indices_to_move(indices.begin(), indices.end());
+  for (int idx : indices) {
+    int partner = model->GetSplitPartnerIndex(idx);
+    if (partner != TabStripModel::kNoTab && partner >= 0 && partner < model->count()) {
+      all_indices_to_move.insert(partner);
+    }
+  }
+
+  int current_active_ws = GetTabStripActiveWorkspace(tab_strip);
+  bool moved_active_tab = false;
+
+  std::vector<Tab*> moving_tabs;
+  for (int idx : all_indices_to_move) {
+    Tab* tab = SafeGetTab(tab_strip, idx);
+    if (!tab) {
+      continue;
+    }
+    int old_ws = GetTabWorkspace(tab);
+    if (old_ws == target_workspace) {
+      continue;
+    }
+    RemoveTabFromWorkspaceStack(tab_strip, old_ws, tab);
+    auto old_key = std::make_pair(static_cast<const TabStrip*>(tab_strip), old_ws);
+    if (st.last_active_tab[old_key] == tab) {
+      st.last_active_tab.erase(old_key);
+    }
+    st.tab_workspaces[tab] = target_workspace;
+    RecordActiveTabInWorkspace(tab_strip, target_workspace, tab);
+    moving_tabs.push_back(tab);
+    if (tab->IsActive()) {
+      moved_active_tab = true;
+    }
+  }
+
+  MoveTabsToEndOfWorkspace(tab_strip, model, moving_tabs, target_workspace);
+
+  // If the active tab was moved out of the current workspace,
+  // activate another tab remaining in the current workspace.
+  if (moved_active_tab) {
+    auto& stack = st.workspace_active_stack[{tab_strip, current_active_ws}];
+    Tab* next_tab_to_activate = nullptr;
+    while (!stack.empty()) {
+      const Tab* cand = stack.front();
+      stack.erase(stack.begin());
+      for (int i = 0; i < tab_strip->GetTabCount(); ++i) {
+        Tab* t = SafeGetTab(tab_strip, i);
+        if (t == cand && GetTabWorkspace(t) == current_active_ws) {
+          next_tab_to_activate = t;
+          break;
+        }
+      }
+      if (next_tab_to_activate) {
+        break;
+      }
+    }
+
+    if (next_tab_to_activate) {
+      auto opt_idx = tab_strip->GetModelIndexOf(next_tab_to_activate);
+      if (opt_idx.has_value()) {
+        model->ActivateTabAt(opt_idx.value());
+      }
+    } else {
+      int found_idx = -1;
+      for (int i = 0; i < tab_strip->GetTabCount(); ++i) {
+        Tab* t = SafeGetTab(tab_strip, i);
+        if (t && GetTabWorkspace(t) == current_active_ws) {
+          found_idx = i;
+          break;
+        }
+      }
+      if (found_idx != -1) {
+        model->ActivateTabAt(found_idx);
+      } else {
+        model->delegate()->AddTabAt(GURL(chrome::kChromeUINewTabURL), -1, true);
+        if (tab_strip->GetActiveIndex().has_value()) {
+          Tab* new_tab = SafeGetTab(tab_strip, tab_strip->GetActiveIndex().value());
+          if (new_tab) {
+            st.tab_workspaces[new_tab] = current_active_ws;
+            RecordActiveTabInWorkspace(tab_strip, current_active_ws, new_tab);
+          }
+        }
+      }
+    }
+  }
+
+  RefreshTabStripLayoutForSpaces(tab_strip);
+  NotifyVeloxSpacesControls();
+  SaveTabSpaces();
+}
+
+void OnTabStripActiveTabChanged(TabStrip* tab_strip, const Tab* new_active_tab) {
+  if (!tab_strip || !new_active_tab || IsTabStripClosingAll(tab_strip) ||
+      browser_shutdown::IsTryingToQuit()) {
+    return;
+  }
+  auto& st = GetVeloxState();
+  int new_ws = GetTabWorkspace(new_active_tab);
+  st.last_active_tab[{tab_strip, new_ws}] = new_active_tab;
+  RecordActiveTabInWorkspace(tab_strip, new_ws, new_active_tab);
+
+  if (!IsSessionRestoringForTabStrip(tab_strip)) {
+    auto& recent = st.recent_visited_tabs[{tab_strip, new_ws}];
+    auto rit = std::find(recent.begin(), recent.end(), new_active_tab);
+    if (rit != recent.end()) {
+      recent.erase(rit);
+    }
+    recent.insert(recent.begin(), new_active_tab);
+    if (recent.size() > 6) {
+      recent.resize(6);
+    }
+    for (int i = 0; i < tab_strip->GetTabCount(); ++i) {
+      if (Tab* t = SafeGetTab(tab_strip, i)) {
+        if (GetTabWorkspace(t) == new_ws) {
+          t->SchedulePaint();
+        }
+      }
+    }
+  }
+
+  if (st.switching_workspace) {
+    return;
+  }
+
+  int current_ws = GetTabStripActiveWorkspace(tab_strip);
+  int removed_ws = -1;
+  auto rem_it = st.last_removed_workspace.find(tab_strip);
+  if (rem_it != st.last_removed_workspace.end()) {
+    removed_ws = rem_it->second;
+    st.last_removed_workspace.erase(rem_it);
+  }
+
+  if (new_ws != current_ws) {
+    if (removed_ws == current_ws) {
+      // Check if there is still another tab in current_ws.
+      // Prefer the MRU active tab from that workspace's stack instead of index 0.
+      int remaining_in_current = -1;
+      auto& stack = st.workspace_active_stack[{tab_strip, current_ws}];
+      for (auto it = stack.begin(); it != stack.end();) {
+        const Tab* cand = *it;
+        bool found = false;
+        if (cand && !cand->closing() && GetTabWorkspace(cand) == current_ws) {
+          for (int i = 0; i < tab_strip->GetTabCount(); ++i) {
+            if (SafeGetTab(tab_strip, i) == cand) {
+              remaining_in_current = i;
+              found = true;
+              break;
+            }
+          }
+        }
+        if (found) {
+          break;
+        } else {
+          it = stack.erase(it);
+        }
+      }
+      if (remaining_in_current == -1) {
+        for (int i = tab_strip->GetTabCount() - 1; i >= 0; --i) {
+          Tab* t = SafeGetTab(tab_strip, i);
+          if (t && !t->closing() && GetTabWorkspace(t) == current_ws) {
+            remaining_in_current = i;
+            break;
+          }
+        }
+      }
+      if (remaining_in_current != -1 && tab_strip->GetBrowserWindowInterface()) {
+        TabStripModel* model =
+            tab_strip->GetBrowserWindowInterface()->GetTabStripModel();
+        const int target_idx = remaining_in_current;
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE,
+            base::BindOnce(
+                [](TabStrip* ts, TabStripModel* m, int target) {
+                  if (!ts || !m ||
+                      !GetVeloxState().tabstrip_containers.contains(ts) ||
+                      IsTabStripClosingAll(ts) || !m->ContainsIndex(target)) {
+                    return;
+                  }
+                  m->ActivateTabAt(target);
+                  RefreshTabStripLayoutForSpaces(ts);
+                },
+                base::Unretained(tab_strip), base::Unretained(model),
+                target_idx));
+        return;
+      }
+    }
+
+    st.tabstrip_active_workspace[tab_strip] = new_ws;
+    RefreshTabStripLayoutForSpaces(tab_strip);
+    NotifyVeloxSpacesControls();
+    if (!IsSessionRestoringForTabStrip(tab_strip)) {
+      ScheduleSaveTabSpaces();
+    }
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](TabStrip* ts) {
+              if (GetVeloxState().tabstrip_containers.contains(ts)) {
+                RefreshTabStripLayoutForSpaces(ts);
+              }
+            },
+            base::Unretained(tab_strip)));
+  }
+}
+
+bool DeleteSpace(int space_idx, Browser* browser) {
+  auto& st = GetVeloxState();
+  if (st.space_names.size() <= 1 || space_idx < 0 ||
+      space_idx >= static_cast<int>(st.space_names.size())) {
+    return false;
+  }
+
+  if (browser) {
+    BrowserView* bv = BrowserView::GetBrowserViewForBrowser(browser);
+    TabStrip* tab_strip = bv ? bv->tabstrip() : nullptr;
+    if (tab_strip) {
+      for (int i = 0; i < tab_strip->GetTabCount(); ++i) {
+        Tab* t = SafeGetTab(tab_strip, i);
+        if (!t) {
+          continue;
+        }
+        int t_ws = GetTabWorkspace(t);
+        if (t_ws == space_idx) {
+          st.tab_workspaces[t] = 0;
+        } else if (t_ws > space_idx) {
+          st.tab_workspaces[t] = t_ws - 1;
+        }
+      }
+    }
+  }
+
+  st.space_names.erase(st.space_names.begin() + space_idx);
+  SaveSpaceNames(browser ? browser->profile() : nullptr);
+
+  if (browser) {
+    BrowserView* bv = BrowserView::GetBrowserViewForBrowser(browser);
+    TabStrip* tab_strip = bv ? bv->tabstrip() : nullptr;
+    if (tab_strip) {
+      int active = GetTabStripActiveWorkspace(tab_strip);
+      if (active == space_idx) {
+        SwitchWorkspace(browser, std::max(0, space_idx - 1));
+      } else if (active > space_idx) {
+        SwitchWorkspace(browser, active - 1);
+      }
+    }
+  }
+
+  NotifyVeloxSpacesControls();
+  return true;
+}
