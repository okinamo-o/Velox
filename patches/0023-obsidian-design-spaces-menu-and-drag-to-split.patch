+// ============================================================================
+// VeloxSpacesControl: Morphing Spaces Pill with Tab Hover Previews
+// ============================================================================
+class VeloxSpacesControl : public views::View,
+                           public views::AnimationDelegateViews,
+                           public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(VeloxSpacesControl, views::View)
+
+ public:
+  enum ContextCommand {
+    kCommandRename = 1,
+    kCommandMoveTab,
+    kCommandSwitch,
+    kCommandNewSpace,
+    kCommandDeleteSpace,
+    kCommandResetName,
+  };
+
+  explicit VeloxSpacesControl(Browser* browser)
+      : views::AnimationDelegateViews(this),
+        browser_(browser),
+        morph_animation_(this) {
+    if (browser_ && browser_->profile()) {
+      velox::LoadSpaceNames(browser_->profile());
+    }
+    morph_animation_.SetSlideDuration(base::Milliseconds(220));
+    morph_animation_.SetTweenType(gfx::Tween::FAST_OUT_SLOW_IN);
+
+    UpdateTooltip();
+    GetViewAccessibility().SetName(u"Velox Workspaces");
+    GetVeloxState().spaces_controls.insert(this);
+  }
+
+  ~VeloxSpacesControl() override {
+    VeloxSpaceTabPreviewBubble::ClosePreview();
+    GetVeloxState().spaces_controls.erase(this);
+  }
+
+  void UpdateTooltip() {
+    std::u16string tip =
+        u"Velox Spaces: Click to expand • Double-click or Right-click to rename • Click + to add space\n";
+    int count = velox::GetSpaceCount();
+    for (int i = 0; i < count; ++i) {
+      tip += u"[" + base::NumberToString16(i + 1) + u"] " + velox::GetSpaceName(i);
+      if (i < count - 1) {
+        tip += u"  •  ";
+      }
+    }
+    SetTooltipText(tip);
+  }
+
+  void NotifyUpdated() {
+    UpdateTooltip();
+    PreferredSizeChanged();
+    SchedulePaint();
+  }
+
+  int GetActiveSpace() const {
+    if (!browser_) {
+      return 0;
+    }
+    BrowserView* bv = BrowserView::GetBrowserViewForBrowser(browser_);
+    if (!bv || !bv->tabstrip()) {
+      return 0;
+    }
+    return velox::GetTabStripActiveWorkspace(bv->tabstrip());
+  }
+
+  int GetSegmentWidth(int i, int active) const {
+    if (i == active) {
+      const gfx::FontList bold_font = gfx::FontList().Derive(
+          0, gfx::Font::NORMAL, gfx::Font::Weight::BOLD);
+      std::u16string label = base::NumberToString16(i + 1) + u" " +
+                             velox::GetSpaceName(i);
+      int text_w = gfx::Canvas::GetStringWidth(label, bold_font);
+      return std::clamp(text_w + 16, 56, 120);
+    }
+    const gfx::FontList semi_font = gfx::FontList().Derive(
+        0, gfx::Font::NORMAL, gfx::Font::Weight::SEMIBOLD);
+    std::u16string label = base::NumberToString16(i + 1);
+    int text_w = gfx::Canvas::GetStringWidth(label, semi_font);
+    return std::clamp(text_w + 12, 26, 36);
+  }
+
+  int GetCollapsedWidth() const {
+    const int active = GetActiveSpace();
+    const gfx::FontList bold_font = gfx::FontList().Derive(
+        0, gfx::Font::NORMAL, gfx::Font::Weight::BOLD);
+    std::u16string label = base::NumberToString16(active + 1) + u" " +
+                           velox::GetSpaceName(active) + u"  ▾";
+    int text_w = gfx::Canvas::GetStringWidth(label, bold_font);
+    return std::clamp(text_w + 20, 70, 130);
+  }
+
+  int GetExpandedWidth() const {
+    const int active = GetActiveSpace();
+    const int count = velox::GetSpaceCount();
+    int total_w = 6;
+    for (int i = 0; i < count; ++i) {
+      total_w += GetSegmentWidth(i, active) + 2;
+    }
+    if (count < 9) {
+      total_w += 22;  // '+' button
+    }
+    total_w += 22;  // '◂' button
+    return total_w;
+  }
+
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    int col_w = GetCollapsedWidth();
+    int exp_w = GetExpandedWidth();
+    double progress = morph_animation_.GetCurrentValue();
+    int current_w = gfx::Tween::IntValueBetween(progress, col_w, exp_w);
+    return gfx::Size(current_w, 28);
+  }
+
+  void AnimationProgressed(const gfx::Animation* animation) override {
+    PreferredSizeChanged();
+    SchedulePaint();
+  }
+
+  void AnimationEnded(const gfx::Animation* animation) override {
+    PreferredSizeChanged();
+    SchedulePaint();
+  }
+
+  void Expand() {
+    if (is_expanded_) {
+      return;
+    }
+    is_expanded_ = true;
+    auto_collapse_timer_.Stop();
+    morph_animation_.Show();
+  }
+
+  void Collapse() {
+    if (!is_expanded_) {
+      return;
+    }
+    is_expanded_ = false;
+    auto_collapse_timer_.Stop();
+    VeloxSpaceTabPreviewBubble::ClosePreview();
+    morph_animation_.Hide();
+  }
+
+  // Returns:
+  // 0 .. count-1 for space segments
+  // -3 for '+' new space button
+  // -2 for '◂' collapse button
+  // -1 for out of bounds
+  int HitSpaceIndex(int x) const {
+    if (!is_expanded_ && !morph_animation_.is_animating()) {
+      return GetActiveSpace();
+    }
+    const int active = GetActiveSpace();
+    const int count = velox::GetSpaceCount();
+    int cur_x = 3;
+    for (int i = 0; i < count; ++i) {
+      int seg_w = GetSegmentWidth(i, active);
+      if (x >= cur_x && x < cur_x + seg_w) {
+        return i;
+      }
+      cur_x += seg_w + 2;
+    }
+    if (count < 9) {
+      if (x >= cur_x && x < cur_x + 22) {
+        return -3;  // '+' New Space button
+      }
+      cur_x += 24;
+    }
+    if (x >= cur_x) {
+      return -2;  // '◂' Collapse button
+    }
+    return -1;
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    int space_idx = HitSpaceIndex(event.x());
+
+    // Double-click opens rename dialog directly
+    if (event.flags() & ui::EF_IS_DOUBLE_CLICK) {
+      if (space_idx >= 0 && space_idx < velox::GetSpaceCount()) {
+        VeloxSpaceTabPreviewBubble::ClosePreview();
+        VeloxRenameSpaceBubble::Show(this, browser_, space_idx);
+        return true;
+      }
+    }
+
+    // Right-click opens context menu
+    if (event.IsOnlyRightMouseButton()) {
+      VeloxSpaceTabPreviewBubble::ClosePreview();
+      int target_idx = (space_idx >= 0 && space_idx < velox::GetSpaceCount())
+                           ? space_idx
+                           : GetActiveSpace();
+      ShowContextMenuForSpace(target_idx, event.location());
+      return true;
+    }
+
+    // Middle-click instantly moves current tab to this space
+    if (event.IsMiddleMouseButton()) {
+      if (space_idx >= 0 && space_idx < velox::GetSpaceCount()) {
+        velox::MoveActiveTabToWorkspace(browser_, space_idx);
+        return true;
+      }
+    }
+
+    // Left-click switches workspace, expands, adds space, or collapses
+    if (event.IsOnlyLeftMouseButton()) {
+      VeloxSpaceTabPreviewBubble::ClosePreview();
+      if (!is_expanded_ && !morph_animation_.is_animating()) {
+        Expand();
+        return true;
+      }
+
+      // In expanded mode:
+      if (space_idx == -2) {
+        // Collapse '◂'
+        Collapse();
+        return true;
+      }
+
+      if (space_idx == -3) {
+        // '+' New Space button!
+        int new_idx =
+            velox::CreateNewSpace(browser_ ? browser_->profile() : nullptr);
+        if (new_idx >= 0) {
+          velox::SwitchWorkspace(browser_, new_idx);
+          PreferredSizeChanged();
+          SchedulePaint();
+          VeloxRenameSpaceBubble::Show(this, browser_, new_idx);
+        }
+        return true;
+      }
+
+      if (space_idx >= 0 && space_idx < velox::GetSpaceCount()) {
+        if (space_idx == GetActiveSpace()) {
+          Collapse();
+        } else {
+          velox::SwitchWorkspace(browser_, space_idx);
+          Collapse();
+        }
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void OnMouseMoved(const ui::MouseEvent& event) override {
+    int hit = HitSpaceIndex(event.x());
+    if (hit != hovered_space_) {
+      hovered_space_ = hit;
+      SchedulePaint();
+    }
+
+    if (hit >= 0 && hit < velox::GetSpaceCount()) {
+      hover_timer_.Stop();
+      hover_timer_.Start(
+          FROM_HERE, base::Milliseconds(140),
+          base::BindOnce(&VeloxSpacesControl::ShowHoverPreview,
+                         base::Unretained(this), hit));
+    } else {
+      hover_timer_.Stop();
+      preview_close_timer_.Start(
+          FROM_HERE, base::Milliseconds(200),
+          base::BindOnce(&VeloxSpacesControl::CheckDismissPreview,
+                         base::Unretained(this)));
+    }
+  }
+
+  void OnMouseExited(const ui::MouseEvent& event) override {
+    hover_timer_.Stop();
+    if (hovered_space_ != -1) {
+      hovered_space_ = -1;
+      SchedulePaint();
+    }
+
+    preview_close_timer_.Start(
+        FROM_HERE, base::Milliseconds(250),
+        base::BindOnce(&VeloxSpacesControl::CheckDismissPreview,
+                       base::Unretained(this)));
+
+    if (is_expanded_) {
+      auto_collapse_timer_.Start(
+          FROM_HERE, base::Milliseconds(3500),
+          base::BindOnce(&VeloxSpacesControl::Collapse,
+                         base::Unretained(this)));
+    }
+  }
+
+  void ShowHoverPreview(int space_idx) {
+    if (space_idx >= 0 && space_idx < velox::GetSpaceCount()) {
+      VeloxSpaceTabPreviewBubble::Show(this, browser_, space_idx);
+    }
+  }
+
+  void CheckDismissPreview() {
+    auto& st = GetVeloxState();
+    if (!st.active_preview_bubble_widget) {
+      return;
+    }
+    gfx::Point cursor = display::Screen::GetScreen()->GetCursorScreenPoint();
+    gfx::Rect my_bounds = GetBoundsInScreen();
+    if (my_bounds.Contains(cursor)) {
+      return;
+    }
+    gfx::Rect bubble_bounds =
+        st.active_preview_bubble_widget->GetWindowBoundsInScreen();
+    if (bubble_bounds.Contains(cursor)) {
+      preview_close_timer_.Start(
+          FROM_HERE, base::Milliseconds(250),
+          base::BindOnce(&VeloxSpacesControl::CheckDismissPreview,
+                         base::Unretained(this)));
+      return;
+    }
+    VeloxSpaceTabPreviewBubble::ClosePreview();
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    gfx::ScopedCanvas scoped(canvas);
+    const float scale = canvas->UndoDeviceScaleFactor();
+
+    gfx::RectF outer_f(GetLocalBounds());
+    outer_f.Scale(scale);
+    outer_f.Inset(gfx::InsetsF::VH(1.5f * scale, 2.0f * scale));
+
+    const float outer_radius = outer_f.height() / 2.0f;
+    SkRRect outer_rr;
+    outer_rr.setRectXY(gfx::RectFToSkRect(outer_f), outer_radius, outer_radius);
+
+    // Dark glass outer pill
+    cc::PaintFlags outer_bg;
+    outer_bg.setAntiAlias(true);
+    outer_bg.setStyle(cc::PaintFlags::kFill_Style);
+    outer_bg.setColor(SkColorSetARGB(195, 11, 15, 25));
+    canvas->sk_canvas()->drawRRect(outer_rr, outer_bg);
+
+    cc::PaintFlags outer_border;
+    outer_border.setAntiAlias(true);
+    outer_border.setStyle(cc::PaintFlags::kStroke_Style);
+    outer_border.setStrokeWidth(1.0f * scale);
+    outer_border.setColor(SkColorSetARGB(35, 255, 255, 255));
+    canvas->sk_canvas()->drawRRect(outer_rr, outer_border);
+
+    canvas->sk_canvas()->restore();  // Back to DIPs
+
+    const int active = GetActiveSpace();
+    const int count = velox::GetSpaceCount();
+    const double progress = morph_animation_.GetCurrentValue();
+
+    // 1. COLLAPSED VIEW (when progress is close to 0)
+    if (!is_expanded_ && progress <= 0.05) {
+      gfx::Rect seg_rect(3, 3, width() - 6, height() - 6);
+
+      gfx::ScopedCanvas seg_scoped(canvas);
+      const float s = canvas->UndoDeviceScaleFactor();
+      gfx::RectF sf(seg_rect);
+      sf.Scale(s);
+      SkRRect srr;
+      srr.setRectXY(gfx::RectFToSkRect(sf), sf.height() / 2.0f, sf.height() / 2.0f);
+
+      cc::PaintFlags seg_fill;
+      seg_fill.setAntiAlias(true);
+      seg_fill.setStyle(cc::PaintFlags::kFill_Style);
+      seg_fill.setColor(hovered_space_ != -1 ? SkColorSetARGB(75, 59, 130, 246)
+                                             : SkColorSetARGB(50, 59, 130, 246));
+      canvas->sk_canvas()->drawRRect(srr, seg_fill);
+
+      cc::PaintFlags seg_rim;
+      seg_rim.setAntiAlias(true);
+      seg_rim.setStyle(cc::PaintFlags::kStroke_Style);
+      seg_rim.setStrokeWidth(1.2f * s);
+      seg_rim.setColor(SkColorSetARGB(180, 59, 130, 246));
+      canvas->sk_canvas()->drawRRect(srr, seg_rim);
+
+      canvas->sk_canvas()->restore();
+
+      std::u16string label = base::NumberToString16(active + 1) + u" " +
+                             velox::GetSpaceName(active) + u"  ▾";
+      canvas->DrawStringRectWithFlags(
+          label,
+          gfx::FontList().Derive(0, gfx::Font::NORMAL, gfx::Font::Weight::BOLD),
+          SK_ColorWHITE, seg_rect,
+          gfx::Canvas::TEXT_ALIGN_CENTER | gfx::Canvas::NO_SUBPIXEL_RENDERING);
+      return;
+    }
+
+    // 2. EXPANDED OR MORPHING VIEW
+    int cur_x = 3;
+    for (int i = 0; i < count; ++i) {
+      int seg_w = GetSegmentWidth(i, active);
+      if (cur_x + seg_w > width() - 2) {
+        break;
+      }
+      gfx::Rect seg_rect(cur_x, 3, seg_w, height() - 6);
+
+      if (i == active || i == hovered_space_) {
+        gfx::ScopedCanvas seg_scoped(canvas);
+        const float s = canvas->UndoDeviceScaleFactor();
+        gfx::RectF sf(seg_rect);
+        sf.Scale(s);
+        SkRRect srr;
+        srr.setRectXY(gfx::RectFToSkRect(sf), sf.height() / 2.0f, sf.height() / 2.0f);
+
+        cc::PaintFlags seg_fill;
+        seg_fill.setAntiAlias(true);
+        seg_fill.setStyle(cc::PaintFlags::kFill_Style);
+        if (i == active) {
+          seg_fill.setColor(SkColorSetARGB(55, 59, 130, 246));
+        } else {
+          seg_fill.setColor(SkColorSetARGB(30, 255, 255, 255));
+        }
+        canvas->sk_canvas()->drawRRect(srr, seg_fill);
+
+        if (i == active) {
+          cc::PaintFlags seg_rim;
+          seg_rim.setAntiAlias(true);
+          seg_rim.setStyle(cc::PaintFlags::kStroke_Style);
+          seg_rim.setStrokeWidth(1.2f * s);
+          seg_rim.setColor(SkColorSetARGB(180, 59, 130, 246));
+          canvas->sk_canvas()->drawRRect(srr, seg_rim);
+        }
+      }
+
+      SkColor text_col = (i == active)
+                             ? SK_ColorWHITE
+                             : (i == hovered_space_
+                                    ? SkColorSetRGB(226, 232, 240)
+                                    : SkColorSetRGB(148, 163, 184));
+      std::u16string label =
+          (i == active)
+              ? (base::NumberToString16(i + 1) + u" " + velox::GetSpaceName(i))
+              : base::NumberToString16(i + 1);
+      canvas->DrawStringRectWithFlags(
+          label,
+          gfx::FontList().Derive(
+              0, gfx::Font::NORMAL,
+              (i == active) ? gfx::Font::Weight::BOLD
+                            : gfx::Font::Weight::SEMIBOLD),
+          text_col, seg_rect,
+          gfx::Canvas::TEXT_ALIGN_CENTER | gfx::Canvas::NO_SUBPIXEL_RENDERING);
+
+      cur_x += seg_w + 2;
+    }
+
+    // '+' New Space button
+    if (cur_x < width() - 26 && count < 9) {
+      gfx::Rect add_rect(cur_x, 3, 20, height() - 6);
+      if (hovered_space_ == -3) {
+        gfx::ScopedCanvas add_scoped(canvas);
+        const float s = canvas->UndoDeviceScaleFactor();
+        gfx::RectF af(add_rect);
+        af.Scale(s);
+        SkRRect arr;
+        arr.setRectXY(gfx::RectFToSkRect(af), af.height() / 2.0f, af.height() / 2.0f);
+        cc::PaintFlags add_fill;
+        add_fill.setAntiAlias(true);
+        add_fill.setColor(SkColorSetARGB(45, 59, 130, 246));
+        canvas->sk_canvas()->drawRRect(arr, add_fill);
+      }
+      canvas->DrawStringRectWithFlags(
+          u"+",
+          gfx::FontList().Derive(0, gfx::Font::NORMAL, gfx::Font::Weight::BOLD),
+          (hovered_space_ == -3) ? SK_ColorWHITE : SkColorSetRGB(148, 163, 184),
+          add_rect,
+          gfx::Canvas::TEXT_ALIGN_CENTER | gfx::Canvas::NO_SUBPIXEL_RENDERING);
+      cur_x += 22;
+    }
+
+    // Collapse chevron '◂' at the end
+    if (cur_x < width() - 8) {
+      gfx::Rect collapse_rect(cur_x, 3, width() - cur_x - 3, height() - 6);
+      if (hovered_space_ == -2) {
+        gfx::ScopedCanvas col_scoped(canvas);
+        const float s = canvas->UndoDeviceScaleFactor();
+        gfx::RectF cf(collapse_rect);
+        cf.Scale(s);
+        SkRRect crr;
+        crr.setRectXY(gfx::RectFToSkRect(cf), cf.height() / 2.0f, cf.height() / 2.0f);
+        cc::PaintFlags col_fill;
+        col_fill.setAntiAlias(true);
+        col_fill.setColor(SkColorSetARGB(35, 255, 255, 255));
+        canvas->sk_canvas()->drawRRect(crr, col_fill);
+      }
+      canvas->DrawStringRectWithFlags(
+          u"◂",
+          gfx::FontList().Derive(0, gfx::Font::NORMAL, gfx::Font::Weight::BOLD),
+          (hovered_space_ == -2) ? SK_ColorWHITE : SkColorSetRGB(148, 163, 184),
+          collapse_rect,
+          gfx::Canvas::TEXT_ALIGN_CENTER | gfx::Canvas::NO_SUBPIXEL_RENDERING);
+    }
+  }
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override {
+    switch (command_id) {
+      case kCommandRename:
+        VeloxRenameSpaceBubble::Show(this, browser_, context_space_idx_);
+        break;
+      case kCommandMoveTab:
+        velox::MoveActiveTabToWorkspace(browser_, context_space_idx_);
+        break;
+      case kCommandSwitch:
+        velox::SwitchWorkspace(browser_, context_space_idx_);
+        break;
+      case kCommandNewSpace: {
+        int new_idx =
+            velox::CreateNewSpace(browser_ ? browser_->profile() : nullptr);
+        if (new_idx >= 0) {
+          velox::SwitchWorkspace(browser_, new_idx);
+          PreferredSizeChanged();
+          SchedulePaint();
+          VeloxRenameSpaceBubble::Show(this, browser_, new_idx);
+        }
+        break;
+      }
+      case kCommandDeleteSpace: {
+        velox::DeleteSpace(context_space_idx_, browser_);
+        PreferredSizeChanged();
+        SchedulePaint();
+        break;
+      }
+      case kCommandResetName: {
+        const std::u16string kDefaults[3] = {u"General", u"Work", u"Focus"};
+        std::u16string def_name =
+            (context_space_idx_ < 3)
+                ? kDefaults[context_space_idx_]
+                : (u"Space " + base::NumberToString16(context_space_idx_ + 1));
+        velox::SetSpaceName(context_space_idx_, def_name,
+                            browser_ ? browser_->profile() : nullptr);
+        break;
+      }
+    }
+  }
+
+ private:
+  void ShowContextMenuForSpace(int space_idx, const gfx::Point& local_point) {
+    context_space_idx_ = space_idx;
+    menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    std::u16string name = velox::GetSpaceName(space_idx);
+
+    menu_model_->AddItem(kCommandRename,
+                         u"Rename \"" + name + u"\" Space...");
+    menu_model_->AddItem(kCommandMoveTab,
+                         u"Move Current Tab to this Space");
+    if (space_idx != GetActiveSpace()) {
+      menu_model_->AddItem(kCommandSwitch, u"Switch to this Space");
+    }
+    menu_model_->AddSeparator(ui::MenuSeparatorType::NORMAL_SEPARATOR);
+    if (velox::GetSpaceCount() < 9) {
+      menu_model_->AddItem(kCommandNewSpace, u"Create New Space...");
+    }
+    if (velox::GetSpaceCount() > 1) {
+      menu_model_->AddItem(kCommandDeleteSpace,
+                           u"Delete \"" + name + u"\" Space");
+    }
+    menu_model_->AddSeparator(ui::MenuSeparatorType::NORMAL_SEPARATOR);
+    menu_model_->AddItem(kCommandResetName, u"Reset Name to Default");
+
+    menu_runner_ = std::make_unique<views::MenuRunner>(
+        menu_model_.get(),
+        views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+
+    gfx::Point screen_loc = local_point;
+    views::View::ConvertPointToScreen(this, &screen_loc);
+    menu_runner_->RunMenuAt(
+        GetWidget(), nullptr, gfx::Rect(screen_loc, gfx::Size()),
+        views::MenuAnchorPosition::kTopLeft, ui::mojom::MenuSourceType::kMouse);
+  }
+
+  raw_ptr<Browser> browser_ = nullptr;
+  int hovered_space_ = -1;
+  int context_space_idx_ = 0;
+  bool is_expanded_ = false;
+
+  gfx::SlideAnimation morph_animation_;
+  base::OneShotTimer hover_timer_;
+  base::OneShotTimer preview_close_timer_;
+  base::OneShotTimer auto_collapse_timer_;
+
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+};
