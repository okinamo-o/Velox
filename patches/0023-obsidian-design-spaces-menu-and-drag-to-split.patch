+class VeloxUpdateButton : public views::Button, public UpgradeObserver {
+  METADATA_HEADER(VeloxUpdateButton, views::Button)
+
+ public:
+  VeloxUpdateButton(ToolbarView* toolbar_view, Browser* browser)
+      : views::Button(base::BindRepeating(&VeloxUpdateButton::OnButtonPressed,
+                                          base::Unretained(this))),
+        toolbar_view_(toolbar_view),
+        browser_(browser) {
+    SetTooltipText(u"Update Velox - A new update is ready");
+    GetViewAccessibility().SetName(u"Update Velox");
+    SetFocusBehavior(FocusBehavior::ALWAYS);
+    SetVisible(false);
+
+    if (browser_ && browser_->profile() &&
+        browser_->profile()->IsOffTheRecord()) {
+      return;
+    }
+
+    if (UpgradeDetector::GetInstance()) {
+      UpgradeDetector::GetInstance()->AddObserver(this);
+      is_observing_ = true;
+    }
+    UpdateVisibility();
+  }
+
+  ~VeloxUpdateButton() override {
+    if (is_observing_ && UpgradeDetector::GetInstance()) {
+      UpgradeDetector::GetInstance()->RemoveObserver(this);
+      is_observing_ = false;
+    }
+  }
+
+  void UpdateVisibility() {
+    if (browser_ && browser_->profile() &&
+        browser_->profile()->IsOffTheRecord()) {
+      SetVisible(false);
+      return;
+    }
+    bool has_update = false;
+    UpgradeDetector* detector = UpgradeDetector::GetInstance();
+    if (detector) {
+      if (detector->notify_upgrade() || detector->is_upgrade_available() ||
+          detector->upgrade_notification_stage() !=
+              UpgradeDetector::UPGRADE_ANNOYANCE_NONE) {
+        has_update = true;
+      }
+    }
+    if (GetVisible() != has_update) {
+      SetVisible(has_update);
+      PreferredSizeChanged();
+      if (toolbar_view_) {
+        toolbar_view_->InvalidateLayout();
+      }
+    }
+  }
+
+  // UpgradeObserver:
+  void OnUpgradeRecommended() override { UpdateVisibility(); }
+  void OnCriticalUpgradeInstalled() override { UpdateVisibility(); }
+  void OnOutdatedInstall() override { UpdateVisibility(); }
+  void OnOutdatedInstallNoAutoUpdate() override { UpdateVisibility(); }
+
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(118, 28);
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    gfx::ScopedCanvas scoped_canvas(canvas);
+    const float scale = canvas->UndoDeviceScaleFactor();
+
+    gfx::RectF bounds_f(GetContentsBounds());
+    bounds_f.Scale(scale);
+    bounds_f.Inset(gfx::InsetsF::VH(1.0f * scale, 1.0f * scale));
+
+    const float radius = bounds_f.height() / 2.0f;
+    SkRRect rrect;
+    rrect.setRectXY(gfx::RectFToSkRect(bounds_f), radius, radius);
+
+    float hover_val = (GetState() == STATE_PRESSED)
+                          ? 1.0f
+                          : (GetState() == STATE_HOVERED ? 0.85f : 0.0f);
+
+    // Glowing Neon Glass Background Pill
+    cc::PaintFlags bg_flags;
+    bg_flags.setAntiAlias(true);
+    bg_flags.setStyle(cc::PaintFlags::kFill_Style);
+    bg_flags.setColor(SkColorSetARGB(
+        static_cast<uint8_t>(200 + hover_val * 35), 18, 22, 31));
+    canvas->sk_canvas()->drawRRect(rrect, bg_flags);
+
+    // Architectural Titanium Sapphire Rim
+    cc::PaintFlags border_flags;
+    border_flags.setAntiAlias(true);
+    border_flags.setStyle(cc::PaintFlags::kStroke_Style);
+    border_flags.setStrokeWidth(1.0f * scale);
+    border_flags.setColor(SkColorSetARGB(
+        static_cast<uint8_t>(75 + hover_val * 110), 59, 130, 246));
+    canvas->sk_canvas()->drawRRect(rrect, border_flags);
+
+    // Soft outer glow when hovered
+    if (hover_val > 0.0f) {
+      cc::PaintFlags glow_flags;
+      glow_flags.setAntiAlias(true);
+      glow_flags.setStyle(cc::PaintFlags::kStroke_Style);
+      glow_flags.setStrokeWidth(2.0f * scale);
+      glow_flags.setColor(
+          SkColorSetARGB(static_cast<uint8_t>(hover_val * 25), 59, 130, 246));
+      canvas->sk_canvas()->drawRRect(rrect, glow_flags);
+    }
+
+    // Vector Icon: Precision Update Arrow
+    const float icon_cx = bounds_f.x() + 15.0f * scale;
+    const float icon_cy = bounds_f.CenterPoint().y();
+    const float arrow_r = 4.0f * scale;
+
+    cc::PaintFlags icon_flags;
+    icon_flags.setAntiAlias(true);
+    icon_flags.setStyle(cc::PaintFlags::kStroke_Style);
+    icon_flags.setStrokeWidth(1.6f * scale);
+    icon_flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+    icon_flags.setStrokeJoin(cc::PaintFlags::kRound_Join);
+    icon_flags.setColor(hover_val > 0.0f ? SK_ColorWHITE
+                                        : SkColorSetRGB(96, 165, 250));
+
+    SkPath arrow_path;
+    arrow_path.moveTo(icon_cx - arrow_r * 0.75f, icon_cy - arrow_r * 0.2f);
+    arrow_path.lineTo(icon_cx, icon_cy - arrow_r);
+    arrow_path.lineTo(icon_cx + arrow_r * 0.75f, icon_cy - arrow_r * 0.2f);
+    arrow_path.moveTo(icon_cx, icon_cy - arrow_r);
+    arrow_path.lineTo(icon_cx, icon_cy + arrow_r);
+    canvas->sk_canvas()->drawPath(arrow_path, icon_flags);
+
+    // Live Ready Status Dot (precision emerald dot on right)
+    cc::PaintFlags dot_flags;
+    dot_flags.setAntiAlias(true);
+    dot_flags.setStyle(cc::PaintFlags::kFill_Style);
+    dot_flags.setColor(SkColorSetRGB(34, 197, 94));  // Precision emerald
+    canvas->DrawCircle(
+        gfx::PointF(bounds_f.right() - 10.0f * scale, bounds_f.CenterPoint().y()),
+        2.0f * scale, dot_flags);
+
+    canvas->sk_canvas()->restore();  // Back to DIPs for font drawing
+
+    gfx::Rect text_rect = GetContentsBounds();
+    text_rect.set_x(text_rect.x() + 26);
+    text_rect.set_width(text_rect.width() - 36);
+
+    SkColor text_color = (hover_val > 0.0f) ? SK_ColorWHITE
+                                            : SkColorSetRGB(226, 232, 240);
+    canvas->DrawStringRectWithFlags(
+        u"Update Velox",
+        gfx::FontList().Derive(1, gfx::Font::NORMAL,
+                               gfx::Font::Weight::SEMIBOLD),
+        text_color, text_rect,
+        gfx::Canvas::TEXT_ALIGN_LEFT | gfx::Canvas::NO_SUBPIXEL_RENDERING);
+  }
+
+ private:
+  void OnButtonPressed() {
+    VeloxUpdateBubble::Show(this, browser_);
+  }
+
+  raw_ptr<ToolbarView> toolbar_view_ = nullptr;
+  raw_ptr<Browser> browser_ = nullptr;
+  bool is_observing_ = false;
+};
