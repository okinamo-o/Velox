+namespace velox {
+int GetTabWorkspaceAtIndex(TabStripModel* model, int tab_index);
+void MoveTabAtIndexToWorkspace(TabStripModel* model, int tab_index, int target_workspace);
+int GetSpaceCount();
+const std::u16string& GetSpaceName(int index);
+int CreateNewSpace(Profile* profile, const std::u16string& optional_name = u"");
+}  // namespace velox
+
+namespace {
+
+class VeloxSpacesSubMenuModel : public ui::SimpleMenuModel,
+                                public ui::SimpleMenuModel::Delegate {
+ public:
+  static constexpr int kMinSpacesCommandId = 3200;
+  static constexpr int kCreateNewSpaceCommandId = 3250;
+
+  VeloxSpacesSubMenuModel(TabStripModel* tab_strip, int context_index)
+      : ui::SimpleMenuModel(this),
+        tab_strip_(tab_strip),
+        context_index_(context_index) {
+    Build();
+  }
+
+  bool IsCommandIdChecked(int command_id) const override {
+    if (command_id == kCreateNewSpaceCommandId) {
+      return false;
+    }
+    int ws = command_id - kMinSpacesCommandId;
+    return ws == velox::GetTabWorkspaceAtIndex(tab_strip_, context_index_);
+  }
+
+  bool IsCommandIdEnabled(int command_id) const override {
+    if (command_id == kCreateNewSpaceCommandId) {
+      return velox::GetSpaceCount() < 9;
+    }
+    int ws = command_id - kMinSpacesCommandId;
+    return ws != velox::GetTabWorkspaceAtIndex(tab_strip_, context_index_);
+  }
+
+  void ExecuteCommand(int command_id, int event_flags) override {
+    if (command_id == kCreateNewSpaceCommandId) {
+      if (tab_strip_) {
+        Profile* profile = tab_strip_->profile();
+        int new_ws = velox::CreateNewSpace(profile);
+        if (new_ws >= 0) {
+          velox::MoveTabAtIndexToWorkspace(tab_strip_, context_index_, new_ws);
+        }
+      }
+      return;
+    }
+    int target_ws = command_id - kMinSpacesCommandId;
+    velox::MoveTabAtIndexToWorkspace(tab_strip_, context_index_, target_ws);
+  }
+
+ private:
+  void Build() {
+    int current_ws = velox::GetTabWorkspaceAtIndex(tab_strip_, context_index_);
+    int count = velox::GetSpaceCount();
+    for (int i = 0; i < count; ++i) {
+      std::u16string name = velox::GetSpaceName(i);
+      if (name.empty()) {
+        name = u"Space " + base::NumberToString16(i + 1);
+      }
+      if (i == current_ws) {
+        name += u" (Current)";
+      }
+      AddItem(kMinSpacesCommandId + i, name);
+    }
+    if (count < 9) {
+      AddSeparator(ui::MenuSeparatorType::NORMAL_SEPARATOR);
+      AddItem(kCreateNewSpaceCommandId, u"+ Create New Space & Move Tab");
+    }
+  }
+
+  raw_ptr<TabStripModel> tab_strip_;
+  int context_index_;
+};
+
+}  // namespace
 
