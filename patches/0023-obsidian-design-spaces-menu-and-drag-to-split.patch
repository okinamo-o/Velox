+  if (active) {
+    if (right_contents_view_ &&
+        right_contents_view_->web_contents() == web_contents) {
+      right_contents_view_->SetWebContents(nullptr);
+      right_card_->SetWebContents(nullptr);
+    }
+    if (left_contents_view_->web_contents() != web_contents) {
+      left_contents_view_->SetWebContents(web_contents);
+    }
+    left_card_->SetWebContents(web_contents);
+  } else {
+    if (web_contents) {
+      if (left_contents_view_->web_contents() == web_contents) {
+        left_contents_view_->SetWebContents(nullptr);
+        left_card_->SetWebContents(nullptr);
+      }
+      right_card_->SetVisible(true);
+      right_contents_view_->SetVisible(true);
+      if (divider_view_) {
+        divider_view_->SetVisible(true);
+      }
+      if (right_contents_view_->web_contents() != web_contents) {
+        right_contents_view_->SetWebContents(web_contents);
+      }
+      right_card_->SetWebContents(web_contents);
+    } else {
+      HideSplit();
+    }
+  }
+  UpdateSplitLayout();
+}
+
+void MultiContentsView::SetSplitOrdering(bool active_is_left) {
+  active_is_left_ = active_is_left;
+  if (left_card_) {
+    left_card_->SetIsActive(active_is_left_);
+  }
+  if (right_card_) {
+    right_card_->SetIsActive(!active_is_left_);
+  }
+}
+
+void MultiContentsView::UpdateSplitLayout() {
+  const bool split = is_split();
+  const bool is_fullscreen = browser_view_ && browser_view_->IsFullscreen();
+  const gfx::RoundedCornersF radii(is_fullscreen ? 0.0f : 11.0f);
+
+  left_card_->SetIsSplit(split);
+  right_card_->SetIsSplit(split);
+  left_card_->SetAccentColor(
+      GetGroupColorForContents(browser_view_, left_contents_view_->web_contents()));
+
+  if (split) {
+    right_card_->SetAccentColor(
+        GetGroupColorForContents(browser_view_, right_contents_view_->web_contents()));
+    left_card_->SetIsActive(active_is_left_);
+    right_card_->SetIsActive(!active_is_left_);
+
+    if (is_fullscreen) {
+      left_card_->SetBorder(nullptr);
+      right_card_->SetBorder(nullptr);
+      left_card_->SetProperty(views::kMarginsKey, gfx::Insets());
+      right_card_->SetProperty(views::kMarginsKey, gfx::Insets());
+    } else {
+      left_card_->SetBorder(views::CreateEmptyBorder(gfx::Insets(2)));
+      right_card_->SetBorder(views::CreateEmptyBorder(gfx::Insets(2)));
+      left_card_->SetProperty(views::kMarginsKey,
+                              gfx::Insets::TLBR(3, 6, 6, 3));
+      right_card_->SetProperty(views::kMarginsKey,
+                               gfx::Insets::TLBR(3, 3, 6, 6));
+    }
+
+    left_contents_view_->SetBackgroundRadii(radii);
+    right_contents_view_->SetBackgroundRadii(radii);
+    if (left_contents_view_->holder()) {
+      left_contents_view_->holder()->SetCornerRadii(radii);
+    }
+    if (right_contents_view_->holder()) {
+      right_contents_view_->holder()->SetCornerRadii(radii);
+    }
+    left_card_->SchedulePaint();
+    right_card_->SchedulePaint();
+  } else {
+    left_card_->SetIsActive(true);
+    if (is_fullscreen) {
+      left_card_->SetBorder(nullptr);
+      left_card_->SetProperty(views::kMarginsKey, gfx::Insets());
+    } else {
+      left_card_->SetBorder(views::CreateEmptyBorder(gfx::Insets(2)));
+      left_card_->SetProperty(views::kMarginsKey,
+                              gfx::Insets::TLBR(3, 6, 6, 6));
+    }
+    left_contents_view_->SetBackgroundRadii(radii);
+    if (left_contents_view_->holder()) {
+      left_contents_view_->holder()->SetCornerRadii(radii);
+    }
+    left_card_->SchedulePaint();
+  }
+  InvalidateLayout();
 }
 
