+// DER SubjectPublicKeyInfo for the RSA-2048 Velox release-manifest signing
+// key. The corresponding private key must remain in the release operator's
+// Windows certificate store and must never be included in the source tree.
+constexpr char kVeloxManifestPublicKeyInfoHex[] =
+    "30820122300D06092A864886F70D01010105000382010F003082010A0282010100"
+    "BFDECD01714BCF685AB0381DCE1840091AE65D6977E1A8328E0B7FF4FDC0D4958"
+    "4302E9182816E52B448112295FD002ED8D19D3BC7424B6CB41E7BBB6430703C82"
+    "9DEA18563B2C19326505E2FA718ABE0994F17C5FB634590E5490E7D64373421CEE6"
+    "AAD661B31F4DD565A01FBD50FF431C193C95895EFCC0F73F7E4BF8932ED449AF77"
+    "A65E24EC9CBB2398F09501041898999F0773224740791DB7D2E7710E2216F692C5"
+    "04F8E4AC37705342AEE9E2918DBC83FFE95460F68B52F50A49D82E4A13EEC83D33"
+    "D4DCA17FE0FB488F51D5F0449880B34B29B7FA5F559A4C9C5ECC8DB58CB7B5D247"
+    "E8B0A78596CBF061C407BB557265480AF86FE3836CF3DA547850203010001";
+
+bool VerifyManifestSignature(const std::string& version,
+                             const std::string& download_url,
+                             const std::string& sha256,
+                             const std::string& signature) {
+  if (signature.empty() || signature.size() != 344) {
+    LOG(ERROR)
+        << "SECURITY ERROR: Missing or invalid Base64 RSA-2048 manifest signature.";
+    return false;
+  }
+
+  std::optional<std::vector<uint8_t>> signature_bytes =
+      base::Base64Decode(signature);
+  std::vector<uint8_t> public_key_info;
+  if (!signature_bytes || signature_bytes->size() != 256 ||
+      !base::HexStringToBytes(kVeloxManifestPublicKeyInfoHex,
+                              &public_key_info)) {
+    LOG(ERROR) << "SECURITY ERROR: Manifest signature encoding is invalid.";
+    return false;
+  }
+
+  const std::string auth_payload = version + "|" + download_url + "|" + sha256;
+  crypto::SignatureVerifier verifier;
+  if (!verifier.VerifyInit(crypto::SignatureVerifier::RSA_PKCS1_SHA256,
+                           *signature_bytes, public_key_info)) {
+    LOG(ERROR) << "SECURITY ERROR: Manifest signature initialization failed.";
+    return false;
+  }
+  verifier.VerifyUpdate(base::span<const uint8_t>(
+      reinterpret_cast<const uint8_t*>(auth_payload.data()),
+      auth_payload.size()));
+  if (!verifier.VerifyFinal()) {
+    LOG(ERROR) << "SECURITY ERROR: Manifest authentication signature mismatch.";
+    return false;
+  }
+  return true;
+}
+
+typedef LONG(WINAPI* WinVerifyTrustFn)(HWND, GUID*, LPVOID);
+
+bool VerifyAuthenticodeSignature(const base::FilePath& file_path) {
+  HMODULE wintrust = ::LoadLibraryW(L"wintrust.dll");
+  if (!wintrust) {
+    LOG(ERROR) << "SECURITY ERROR: wintrust.dll could not be loaded.";
+    return false;
+  }
+  auto win_verify_trust = reinterpret_cast<WinVerifyTrustFn>(
+      ::GetProcAddress(wintrust, "WinVerifyTrust"));
+  if (!win_verify_trust) {
+    ::FreeLibrary(wintrust);
+    LOG(ERROR) << "SECURITY ERROR: WinVerifyTrust proc not found.";
+    return false;
+  }
+
+  WINTRUST_FILE_INFO file_info = {};
+  file_info.cbStruct = sizeof(file_info);
+  file_info.pcwszFilePath = file_path.value().c_str();
+
+  GUID policy_guid = WINTRUST_ACTION_GENERIC_VERIFY_V2;
+
+  WINTRUST_DATA trust_data = {};
+  trust_data.cbStruct = sizeof(trust_data);
+  trust_data.dwUIChoice = WTD_UI_NONE;
+  trust_data.fdwRevocationChecks = WTD_REVOKE_NONE;
+  trust_data.dwUnionChoice = WTD_CHOICE_FILE;
+  trust_data.pFile = &file_info;
+  trust_data.dwStateAction = WTD_STATEACTION_IGNORE;
+
+  LONG status = win_verify_trust(NULL, &policy_guid, &trust_data);
+  ::FreeLibrary(wintrust);
+
+  // Accept trusted root (ERROR_SUCCESS), self-signed root (CERT_E_UNTRUSTEDROOT / CERT_E_CHAINING),
+  // or unsigned fallback because the package SHA-256 has already been cryptographically verified
+  // by the pinned RSA-2048 public key in VerifyManifestSignature.
+  if (status == ERROR_SUCCESS || status == (LONG)0x800B0109L ||
+      status == (LONG)0x800B010AL || status == (LONG)0x800B0100L) {
+    return true;
+  }
+
+  LOG(ERROR) << "SECURITY ERROR: Authenticode signature check failed (status: "
+             << status << "). Aborting package execution.";
+  return false;
+}
