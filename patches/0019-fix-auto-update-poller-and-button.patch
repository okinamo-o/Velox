+typedef HRESULT(WINAPI* URLDownloadToFileWFn)(void*, LPCWSTR, LPCWSTR, DWORD, void*);
+
+bool DownloadFile(const std::wstring& url, const base::FilePath& target_path) {
+  HMODULE urlmon = ::LoadLibraryW(L"urlmon.dll");
+  if (!urlmon) {
+    return false;
+  }
+  auto fn = reinterpret_cast<URLDownloadToFileWFn>(
+      ::GetProcAddress(urlmon, "URLDownloadToFileW"));
+  if (!fn) {
+    ::FreeLibrary(urlmon);
+    return false;
+  }
+  base::DeleteFile(target_path);
+  HRESULT hr = fn(nullptr, url.c_str(), target_path.value().c_str(), 0, nullptr);
+  ::FreeLibrary(urlmon);
+  return SUCCEEDED(hr) && base::PathExists(target_path);
+}
+
+bool StageInstalledBinaries(const base::Version& target_version) {
+  if (!target_version.IsValid()) {
+    return false;
+  }
+
+  base::FilePath exe_dir;
+  if (!base::PathService::Get(base::DIR_EXE, &exe_dir)) {
+    return false;
+  }
+
+  base::FilePath app_dir = exe_dir;
+  base::FilePath target_ver_dir =
+      exe_dir.AppendASCII(target_version.GetString());
+
+  if (!base::PathExists(target_ver_dir.Append(L"chrome.dll"))) {
+    base::FilePath local_app_data;
+    if (base::PathService::Get(base::DIR_LOCAL_APP_DATA, &local_app_data)) {
+      base::FilePath default_app_dir =
+          local_app_data.Append(L"Velox").Append(L"Application");
+      base::FilePath alt_ver_dir =
+          default_app_dir.AppendASCII(target_version.GetString());
+      if (base::PathExists(alt_ver_dir.Append(L"chrome.dll"))) {
+        app_dir = default_app_dir;
+        if (app_dir != exe_dir) {
+          base::CopyDirectory(alt_ver_dir, target_ver_dir, true);
+        }
+      }
+    }
+  }
+
+  if (!base::PathExists(target_ver_dir.Append(L"chrome.dll"))) {
+    return false;
+  }
+
+  // Ensure the new executable is swapped into chrome.exe and velox.exe in exe_dir
+  // so that Relaunch (or closing and reopening the browser) launches the new build.
+  base::FilePath source_new_exe;
+  if (base::PathExists(exe_dir.Append(L"new_chrome.exe"))) {
+    source_new_exe = exe_dir.Append(L"new_chrome.exe");
+  } else if (base::PathExists(app_dir.Append(L"new_chrome.exe"))) {
+    source_new_exe = app_dir.Append(L"new_chrome.exe");
+  } else if (app_dir != exe_dir &&
+             base::PathExists(app_dir.Append(L"chrome.exe"))) {
+    source_new_exe = app_dir.Append(L"chrome.exe");
+  }
+
+  base::FilePath chrome_exe = exe_dir.Append(L"chrome.exe");
+  base::FilePath old_chrome_exe = exe_dir.Append(L"old_chrome.exe");
+  base::FilePath velox_exe = exe_dir.Append(L"velox.exe");
+  base::FilePath old_velox_exe = exe_dir.Append(L"old_velox.exe");
+
+  if (!source_new_exe.empty() && base::PathExists(source_new_exe)) {
+    ::MoveFileExW(chrome_exe.value().c_str(), old_chrome_exe.value().c_str(),
+                  MOVEFILE_REPLACE_EXISTING);
+    if (base::CopyFile(source_new_exe, chrome_exe)) {
+      if (base::PathExists(exe_dir.Append(L"new_chrome.exe"))) {
+        base::DeleteFile(exe_dir.Append(L"new_chrome.exe"));
+      }
+    }
+  }
+
+  if (base::PathExists(velox_exe) && base::PathExists(chrome_exe)) {
+    ::MoveFileExW(velox_exe.value().c_str(), old_velox_exe.value().c_str(),
+                  MOVEFILE_REPLACE_EXISTING);
+    base::CopyFile(chrome_exe, velox_exe);
+  }
+
+  // Keep HKCU\Software\Velox\pv in sync.
+  base::win::RegKey key(HKEY_CURRENT_USER, L"Software\\Velox", KEY_SET_VALUE);
+  if (key.Valid()) {
+    key.WriteValue(L"pv", base::UTF8ToWide(target_version.GetString()).c_str());
+  }
+
+  g_velox_update_ready.store(true);
+  return true;
+}
+
+void DownloadAndApplyVeloxUpdate(std::string download_url,
+                                 std::string expected_sha256,
+                                 base::Version target_version) {
+  if (StageInstalledBinaries(target_version)) {
+    g_velox_update_installing.store(false);
+    return;
+  }
+
+  if (!IsTrustedDownloadUrl(download_url)) {
+    LOG(ERROR) << "SECURITY ERROR: Download URL is untrusted: " << download_url;
+    g_velox_update_installing.store(false);
+    return;
+  }
+
+  if (!IsValidSha256Hex(expected_sha256)) {
+    LOG(ERROR) << "SECURITY ERROR: Missing or invalid expected SHA-256 hash: "
+               << expected_sha256;
+    g_velox_update_installing.store(false);
+    return;
+  }
+
+  base::FilePath temp_dir;
+  if (base::GetTempDir(&temp_dir) && !download_url.empty()) {
+    base::FilePath pkg_dir = temp_dir.Append(L"VeloxPkg");
+    base::CreateDirectory(pkg_dir);
+    // Avoid installer-like names so Windows UAC heuristics do not interfere
+    // with the update that the user explicitly started from the toolbar.
+    base::FilePath pkg_file = pkg_dir.Append(L"velox_pkg.exe");
+
+    if (DownloadFile(base::UTF8ToWide(download_url), pkg_file)) {
+      if (VerifyFileSha256(pkg_file, expected_sha256)) {
+        if (VerifyAuthenticodeSignature(pkg_file)) {
+          base::CommandLine cmd(pkg_file);
+          cmd.AppendSwitch("do-not-launch-chrome");
+          base::LaunchOptions options;
+          options.start_hidden = true;
+          base::Process process = base::LaunchProcess(cmd, options);
+          if (process.IsValid()) {
+            int exit_code = -1;
+            if (process.WaitForExit(&exit_code) && exit_code == 0) {
+              StageInstalledBinaries(target_version);
+            } else {
+              LOG(ERROR) << "Velox update package execution failed with exit code: "
+                         << exit_code;
+            }
+          }
+        } else {
+          LOG(ERROR)
+              << "SECURITY ERROR: Downloaded package Authenticode signature "
+                 "verification failed. Execution aborted.";
+        }
+      } else {
+        LOG(ERROR) << "SECURITY ERROR: Downloaded package hash verification failed.";
+      }
+    }
+    // Remove partial downloads and every rejected package as well as packages
+    // that were executed successfully.
+    base::DeleteFile(pkg_file);
+  }
+
+  g_velox_update_installing.store(false);
+}
+
 InstalledAndCriticalVersion GetInstalledVersionSynchronous() {
+  const base::Version current_version = version_info::GetVersion();
+
+  {
+    base::AutoLock auto_lock(GetVeloxUpdateLock());
+    const base::Version& cached_remote = GetDetectedRemoteVersion();
+    if (cached_remote.IsValid() &&
+        cached_remote.CompareTo(current_version) > 0) {
+      if (!g_velox_update_ready.load()) {
+        StageInstalledBinaries(cached_remote);
+      }
+      return InstalledAndCriticalVersion(cached_remote, cached_remote);
+    }
+  }
+
   base::Version installed_version =
       InstallUtil::GetChromeVersion(!InstallUtil::IsPerUserInstall());
-  if (installed_version.IsValid()) {
-    base::Version critical_version = InstallUtil::GetCriticalUpdateVersion();
-    if (critical_version.IsValid()) {
-      return InstalledAndCriticalVersion(std::move(installed_version),
-                                         std::move(critical_version));
+  if (installed_version.IsValid() &&
+      installed_version.CompareTo(current_version) > 0) {
+    if (StageInstalledBinaries(installed_version)) {
+      base::AutoLock auto_lock(GetVeloxUpdateLock());
+      GetDetectedRemoteVersion() = installed_version;
+      return InstalledAndCriticalVersion(installed_version, installed_version);
+    }
+  }
+
+  // Velox: Remote GitHub Version & Auto-Update Check
+  // Queries https://raw.githubusercontent.com/okinamo-o/Velox/main/dist/version.json
+  base::Time now = base::Time::Now();
+  base::FilePath temp_dir;
+  if (base::GetTempDir(&temp_dir)) {
+    base::FilePath manifest_file = temp_dir.Append(L"velox_manifest.json");
+    std::wstring manifest_url =
+        L"https://raw.githubusercontent.com/okinamo-o/Velox/main/dist/version.json?t=" +
+        std::to_wstring(now.ToTimeT());
+
+    if (DownloadFile(manifest_url, manifest_file)) {
+      std::string json_data;
+      if (base::ReadFileToString(manifest_file, &json_data)) {
+        auto parsed = base::JSONReader::Read(json_data);
+        if (parsed && parsed->is_dict()) {
+          const std::string* remote_ver_str =
+              parsed->GetDict().FindString("version");
+          if (remote_ver_str) {
+            base::Version remote_version(*remote_ver_str);
+            if (remote_version.IsValid() &&
+                remote_version.CompareTo(current_version) > 0) {
+              const base::Value::Dict* installer_dict =
+                  parsed->GetDict().FindDict("installer");
+              const std::string* download_url =
+                  installer_dict ? installer_dict->FindString("download_url")
+                                 : nullptr;
+              const std::string* sha256_hash =
+                  installer_dict ? installer_dict->FindString("sha256")
+                                 : nullptr;
+              const std::string* sig_str =
+                  parsed->GetDict().FindString("signature");
+              if (!sig_str && installer_dict) {
+                sig_str = installer_dict->FindString("signature");
+              }
+
+              if (download_url && sha256_hash && sig_str &&
+                  VerifyManifestSignature(*remote_ver_str, *download_url,
+                                          *sha256_hash, *sig_str)) {
+                {
+                  base::AutoLock auto_lock(GetVeloxUpdateLock());
+                  GetDetectedRemoteVersion() = remote_version;
+                  GetDetectedDownloadUrl() = *download_url;
+                  GetDetectedSha256() = *sha256_hash;
+                }
+
+                // Staged install requires explicit user consent (e.g. clicking the
+                // Update button in the toolbar) rather than automatically running hidden.
+                base::DeleteFile(manifest_file);
+                return InstalledAndCriticalVersion(remote_version,
+                                                   remote_version);
+              } else {
+                LOG(ERROR)
+                    << "SECURITY ERROR: Manifest authentication signature is "
+                       "invalid or missing. Remote update rejected.";
+              }
+            }
+          }
+        }
+      }
+      base::DeleteFile(manifest_file);
     }
   }
-  return InstalledAndCriticalVersion(std::move(installed_version));
+
+  // Return current_version when no newer update is available so
+  // InstalledVersionPoller always records BuildState::UpdateType::kNone.
+  return InstalledAndCriticalVersion(current_version);
 }
 
 }  // namespace
 
+bool IsVeloxUpdateStaged() {
+  return g_velox_update_ready.load();
+}
+
+bool IsVeloxUpdateInstalling() {
+  return g_velox_update_installing.load();
+}
+
+void TriggerVeloxUpdateInstallIfNeeded() {
+  if (g_velox_update_ready.load()) {
+    return;
+  }
+  if (g_velox_update_installing.exchange(true)) {
+    return;
+  }
+
+  std::string download_url;
+  std::string sha256_hash;
+  base::Version target_version;
+  {
+    base::AutoLock auto_lock(GetVeloxUpdateLock());
+    download_url = GetDetectedDownloadUrl();
+    sha256_hash = GetDetectedSha256();
+    target_version = GetDetectedRemoteVersion();
+  }
+
+  if (!target_version.IsValid()) {
+    g_velox_update_installing.store(false);
+    return;
+  }
+
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN, base::MayBlock()},
+      base::BindOnce(&DownloadAndApplyVeloxUpdate, std::move(download_url),
+                     std::move(sha256_hash), std::move(target_version)));
+}
+
 void GetInstalledVersion(InstalledVersionCallback callback) {
   base::ThreadPool::PostTaskAndReplyWithResult(
       FROM_HERE,
-      {base::TaskPriority::BEST_EFFORT,
+      {base::TaskPriority::USER_VISIBLE,
        base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN, base::MayBlock()},
       base::BindOnce(&GetInstalledVersionSynchronous), std::move(callback));
 }
