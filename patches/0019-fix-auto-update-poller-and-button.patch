+class VeloxUpdateBubble : public views::BubbleDialogDelegateView {
+  METADATA_HEADER(VeloxUpdateBubble, views::BubbleDialogDelegateView)
+
+ public:
+  static void Show(views::View* anchor_view, Browser* browser) {
+    auto bubble = std::make_unique<VeloxUpdateBubble>(anchor_view, browser);
+    views::BubbleDialogDelegateView::CreateBubble(std::move(bubble))->Show();
+  }
+
+  VeloxUpdateBubble(views::View* anchor_view, Browser* browser)
+      : BubbleDialogDelegateView(anchor_view, views::BubbleBorder::TOP_RIGHT),
+        browser_(browser) {
+    SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+    set_margins(gfx::Insets::VH(16, 20));
+    SetTitle(u"Velox Browser");
+    SetShowTitle(false);
+    SetShowCloseButton(true);
+  }
+
+  ~VeloxUpdateBubble() override = default;
+
+  void Init() override {
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 12));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kStretch);
+
+    bool has_upgrade = false;
+    UpgradeDetector* detector = UpgradeDetector::GetInstance();
+    if (detector && (detector->notify_upgrade() ||
+                     detector->is_upgrade_available() ||
+                     detector->upgrade_notification_stage() !=
+                         UpgradeDetector::UPGRADE_ANNOYANCE_NONE)) {
+      has_upgrade = true;
+    }
+
+    if (has_upgrade) {
+      // Header Title with emoji badge
+      auto* title_label = AddChildView(std::make_unique<views::Label>(
+          u"ΓÜí Velox Update Available", views::style::CONTEXT_DIALOG_TITLE,
+          views::style::STYLE_PRIMARY));
+      title_label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      title_label->SetFontList(title_label->font_list().Derive(
+          3, gfx::Font::NORMAL, gfx::Font::Weight::BOLD));
+
+      status_label_ = AddChildView(std::make_unique<views::Label>(
+          u"≡ƒÜÇ A new Velox update is ready to install!",
+          views::style::CONTEXT_LABEL, views::style::STYLE_PRIMARY));
+      status_label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+
+      auto* desc_label = AddChildView(std::make_unique<views::Label>(
+          u"Restart Velox now to apply the latest speed, security, and feature "
+          u"updates. All your open tabs and windows will be restored.",
+          views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+      desc_label->SetMultiLine(true);
+      desc_label->SetMaximumWidth(320);
+      desc_label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+
+      // Button Row
+      auto* button_row = AddChildView(std::make_unique<views::View>());
+      auto* row_layout =
+          button_row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+              views::BoxLayout::Orientation::kHorizontal,
+              gfx::Insets::TLBR(8, 0, 0, 0), 8));
+      row_layout->set_main_axis_alignment(
+          views::BoxLayout::MainAxisAlignment::kEnd);
+
+      check_button_ =
+          button_row->AddChildView(std::make_unique<views::MdTextButton>(
+              base::BindRepeating(&VeloxUpdateBubble::OnRelaunchClicked,
+                                  base::Unretained(this)),
+              u"Relaunch to Update"));
+      check_button_->SetStyle(ui::ButtonStyle::kProminent);
+
+      auto* later_button =
+          button_row->AddChildView(std::make_unique<views::MdTextButton>(
+              base::BindRepeating(&VeloxUpdateBubble::OnLaterClicked,
+                                  base::Unretained(this)),
+              u"Later"));
+      later_button->SetStyle(ui::ButtonStyle::kDefault);
+    } else {
+      // Header Title with emoji badge
+      auto* title_label = AddChildView(std::make_unique<views::Label>(
+          u"ΓÜí Velox Browser", views::style::CONTEXT_DIALOG_TITLE,
+          views::style::STYLE_PRIMARY));
+      title_label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      title_label->SetFontList(title_label->font_list().Derive(
+          3, gfx::Font::NORMAL, gfx::Font::Weight::BOLD));
+
+      // Status / Version
+      status_label_ = AddChildView(std::make_unique<views::Label>(
+          u"Velox is up to date (Version 134.0 Ultra)",
+          views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+      status_label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+
+      auto* desc_label = AddChildView(std::make_unique<views::Label>(
+          u"Official high-performance release with Velox Shield adblock, Opera "
+          u"One tab islands, and ultra-smooth hardware acceleration enabled.",
+          views::style::CONTEXT_LABEL, views::style::STYLE_DISABLED));
+      desc_label->SetMultiLine(true);
+      desc_label->SetMaximumWidth(320);
+      desc_label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+
+      // Button Row
+      auto* button_row = AddChildView(std::make_unique<views::View>());
+      auto* row_layout =
+          button_row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+              views::BoxLayout::Orientation::kHorizontal,
+              gfx::Insets::TLBR(8, 0, 0, 0), 8));
+      row_layout->set_main_axis_alignment(
+          views::BoxLayout::MainAxisAlignment::kEnd);
+
+      check_button_ =
+          button_row->AddChildView(std::make_unique<views::MdTextButton>(
+              base::BindRepeating(&VeloxUpdateBubble::OnCheckClicked,
+                                  base::Unretained(this)),
+              u"Check for Updates"));
+      check_button_->SetStyle(ui::ButtonStyle::kProminent);
+
+      auto* settings_button =
+          button_row->AddChildView(std::make_unique<views::MdTextButton>(
+              base::BindRepeating(&VeloxUpdateBubble::OnSettingsClicked,
+                                  base::Unretained(this)),
+              u"What's New"));
+      settings_button->SetStyle(ui::ButtonStyle::kDefault);
+    }
+  }
+
+ private:
+  static void PollAndRelaunchWhenStaged(int attempts_left) {
+    if (IsVeloxUpdateStaged() ||
+        (!IsVeloxUpdateInstalling() && attempts_left <= 0)) {
+      chrome::AttemptRelaunch();
+      return;
+    }
+    if (!IsVeloxUpdateInstalling()) {
+      TriggerVeloxUpdateInstallIfNeeded();
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&VeloxUpdateBubble::PollAndRelaunchWhenStaged,
+                       attempts_left - 1),
+        base::Milliseconds(500));
+  }
+
+  void OnRelaunchClicked() {
+    if (IsVeloxUpdateStaged()) {
+      chrome::AttemptRelaunch();
+      return;
+    }
+    TriggerVeloxUpdateInstallIfNeeded();
+    if (check_button_) {
+      check_button_->SetEnabled(false);
+      check_button_->SetText(u"Applying Update...");
+    }
+    if (status_label_) {
+      status_label_->SetText(
+          u"ΓÜí Downloading & staging update... Velox will restart automatically!");
+    }
+    PollAndRelaunchWhenStaged(240);
+  }
+
+  void OnLaterClicked() {
+    if (GetWidget()) {
+      GetWidget()->CloseWithReason(
+          views::Widget::ClosedReason::kCancelButtonClicked);
+    }
+  }
+
+  void OnCheckClicked() {
+    if (!check_button_ || !status_label_) {
+      return;
+    }
+    check_button_->SetEnabled(false);
+    status_label_->SetText(u"Connecting to GitHub...");
+    GetInstalledVersion(base::BindOnce(
+        &VeloxUpdateBubble::OnInstalledVersionChecked, weak_factory_.GetWeakPtr()));
+  }
+
+  void OnInstalledVersionChecked(InstalledAndCriticalVersion versions) {
+    if (versions.installed_version.IsValid() &&
+        versions.installed_version.CompareTo(version_info::GetVersion()) > 0) {
+      if (status_label_) {
+        status_label_->SetText(u"≡ƒÜÇ A new Velox update is ready!");
+      }
+      if (check_button_) {
+        check_button_->SetEnabled(true);
+        check_button_->SetText(u"Relaunch to Update");
+        check_button_->SetCallback(base::BindRepeating(
+            &VeloxUpdateBubble::OnRelaunchClicked, base::Unretained(this)));
+      }
+    } else {
+      OnCheckCompleted();
+    }
+  }
+
+  void OnCheckCompleted() {
+    if (status_label_) {
+      status_label_->SetText(u"Γ£¿ Velox is up to date! (Latest Release)");
+    }
+    if (check_button_) {
+      check_button_->SetEnabled(true);
+      check_button_->SetText(u"Up to Date");
+    }
+  }
+
+  void OnSettingsClicked() {
+    if (browser_) {
+      chrome::AddTabAt(browser_, GURL("chrome://settings/help"), -1, true,
+                       std::nullopt);
+    }
+    if (GetWidget()) {
+      GetWidget()->CloseWithReason(
+          views::Widget::ClosedReason::kAcceptButtonClicked);
+    }
+  }
+
+  raw_ptr<Browser> browser_ = nullptr;
+  raw_ptr<views::Label> status_label_ = nullptr;
+  raw_ptr<views::MdTextButton> check_button_ = nullptr;
+  base::WeakPtrFactory<VeloxUpdateBubble> weak_factory_{this};
+};
