+bool IsValidSha256Hex(const std::string& hash) {
+  if (hash.size() != 64) {
+    return false;
+  }
+  for (char c : hash) {
+    if (!base::IsHexDigit(c)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool IsTrustedDownloadUrl(const std::string& url) {
+  return base::StartsWith(url,
+                          "https://github.com/okinamo-o/Velox/releases/download/",
+                          base::CompareCase::INSENSITIVE_ASCII) ||
+         base::StartsWith(url, "https://github.com/okinamo-o/Velox/releases/",
+                          base::CompareCase::INSENSITIVE_ASCII);
+}
+
+bool VerifyFileSha256(const base::FilePath& file_path,
+                      const std::string& expected_sha256) {
+  if (!IsValidSha256Hex(expected_sha256)) {
+    LOG(ERROR) << "SECURITY ERROR: Missing or invalid 64-character SHA-256 hash.";
+    return false;
+  }
+
+  base::File file(file_path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!file.IsValid()) {
+    LOG(ERROR) << "Failed to open downloaded file for SHA-256 verification: "
+               << file_path.value();
+    return false;
+  }
+
+  auto hasher = crypto::SecureHash::Create(crypto::SecureHash::SHA256);
+  std::vector<uint8_t> buffer(64 * 1024);
+  while (true) {
+    int bytes_read = file.ReadAtCurrentPos(
+        reinterpret_cast<char*>(buffer.data()), static_cast<int>(buffer.size()));
+    if (bytes_read < 0) {
+      LOG(ERROR) << "Error reading file during SHA-256 calculation.";
+      return false;
+    }
+    if (bytes_read == 0) {
+      break;
+    }
+    hasher->Update(buffer.data(), bytes_read);
+  }
+
+  std::vector<uint8_t> digest(32);
+  hasher->Finish(digest.data(), digest.size());
+  std::string actual_hex = base::HexEncode(digest.data(), digest.size());
+
+  bool matches = base::EqualsCaseInsensitiveASCII(actual_hex, expected_sha256);
+  if (!matches) {
+    LOG(ERROR) << "SECURITY ERROR: SHA-256 hash mismatch! Expected: "
+               << expected_sha256 << ", Actual: " << actual_hex;
+  }
+  return matches;
+}
