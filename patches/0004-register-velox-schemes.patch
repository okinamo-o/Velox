+
+namespace {
+
+class VeloxPerformanceHTMLSource : public content::URLDataSource {
+ public:
+  explicit VeloxPerformanceHTMLSource(Profile* profile) : profile_(profile) {}
+  ~VeloxPerformanceHTMLSource() override = default;
+
+  std::string GetSource() override {
+    return chrome::kVeloxUIPerformanceHost;
+  }
+
+  std::string GetMimeType(const GURL& url) override {
+    return "text/html";
+  }
+
+  bool ShouldServiceRequest(const GURL& url,
+                            content::BrowserContext* browser_context,
+                            int render_process_id) override {
+    return url.SchemeIs(content::kVeloxUIScheme) &&
+           url.host() == chrome::kVeloxUIPerformanceHost;
+  }
+
+  void StartDataRequest(
+      const GURL& url,
+      const content::WebContents::Getter& wc_getter,
+      content::URLDataSource::GotDataCallback callback) override {
+    int64_t total_mem = base::SysInfo::AmountOfPhysicalMemory();
+    int64_t free_mem = base::SysInfo::AmountOfAvailablePhysicalMemory();
+    int64_t used_mem = total_mem > free_mem ? (total_mem - free_mem) : 0;
+    double load_pct = total_mem > 0 ? (100.0 * used_mem / total_mem) : 0.0;
+
+    int num_procs = base::SysInfo::NumberOfProcessors();
+    std::string os_name = base::SysInfo::OperatingSystemName();
+    std::string os_version = base::SysInfo::OperatingSystemVersion();
+
+    std::ostringstream ss;
+    ss << "<!DOCTYPE html>\n<html><head><meta charset='utf-8'>\n";
+    ss << "<title>VELOX Resource Performance Center</title>\n";
+    ss << "<style>\n";
+    ss << "  * { box-sizing: border-box; }\n";
+    ss << "  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #0b0d13; color: #e2e8f0; margin: 0; padding: 32px; }\n";
+    ss << "  .header { display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #1e293b; padding-bottom: 16px; margin-bottom: 24px; }\n";
+    ss << "  .brand { display: flex; align-items: center; gap: 12px; }\n";
+    ss << "  .logo { font-size: 24px; font-weight: 900; letter-spacing: 2px; color: #38bdf8; text-transform: uppercase; background: linear-gradient(135deg, #38bdf8, #818cf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }\n";
+    ss << "  .subtitle { font-size: 13px; color: #94a3b8; }\n";
+    ss << "  .badge { display: inline-block; padding: 4px 10px; border-radius: 9999px; font-size: 12px; font-weight: 600; }\n";
+    ss << "  .badge-success { background: #064e3b; color: #34d399; border: 1px solid #059669; }\n";
+    ss << "  .badge-info { background: #0c4a6e; color: #38bdf8; border: 1px solid #0284c7; }\n";
+    ss << "  .badge-warning { background: #78350f; color: #fbbf24; border: 1px solid #d97706; }\n";
+    ss << "  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 24px; }\n";
+    ss << "  .card { background: #131722; border: 1px solid #1e293b; border-radius: 12px; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2); }\n";
+    ss << "  .card-title { font-size: 14px; text-transform: uppercase; letter-spacing: 1px; color: #64748b; margin-top: 0; margin-bottom: 8px; }\n";
+    ss << "  .stat-val { font-size: 28px; font-weight: 700; color: #f8fafc; }\n";
+    ss << "  .stat-desc { font-size: 12px; color: #94a3b8; margin-top: 4px; }\n";
+    ss << "  table { width: 100%; border-collapse: collapse; margin-top: 12px; }\n";
+    ss << "  th, td { text-align: left; padding: 12px; border-bottom: 1px solid #1e293b; font-size: 14px; }\n";
+    ss << "  th { color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 12px; letter-spacing: 0.5px; }\n";
+    ss << "  tr:hover { background: #1e293b44; }\n";
+    ss << "  .footer { text-align: center; color: #475569; font-size: 12px; margin-top: 40px; padding-top: 16px; border-top: 1px solid #1e293b; }\n";
+    ss << "</style></head><body>\n";
+
+    ss << "<div class='header'>\n";
+    ss << "  <div class='brand'>\n";
+    ss << "    <div class='logo'>VELOX</div>\n";
+    ss << "    <div class='subtitle'>Resource Performance Center &amp; Architecture Telemetry</div>\n";
+    ss << "  </div>\n";
+    ss << "  <div><span class='badge badge-success'>ORIGIN ISOLATION ACTIVE</span></div>\n";
+    ss << "</div>\n";
+
+    ss << "<div class='grid'>\n";
+    // System Memory Card
+    ss << "  <div class='card'>\n";
+    ss << "    <div class='card-title'>Host System Memory</div>\n";
+    ss << "    <div class='stat-val'>" << std::fixed << std::setprecision(1) << load_pct << "%</div>\n";
+    ss << "    <div class='stat-desc'>Used: " << (used_mem / (1024 * 1024)) << " MB / Total: " << (total_mem / (1024 * 1024)) << " MB</div>\n";
+    ss << "  </div>\n";
+
+    // Host CPU Card
+    ss << "  <div class='card'>\n";
+    ss << "    <div class='card-title'>Processor &amp; Platform</div>\n";
+    ss << "    <div class='stat-val'>" << num_procs << " Logical Cores</div>\n";
+    ss << "    <div class='stat-desc'>" << os_name << " " << os_version << "</div>\n";
+    ss << "  </div>\n";
+
+    // Sandbox & Security Card
+    ss << "  <div class='card'>\n";
+    ss << "    <div class='card-title'>Security &amp; Isolation Model</div>\n";
+    ss << "    <div class='stat-val' style='font-size:20px;color:#38bdf8;'>Win32k Lockdown + AppContainer</div>\n";
+    ss << "    <div class='stat-desc'>Strict Site Isolation &amp; Process Locking Enforced</div>\n";
+    ss << "  </div>\n";
+    ss << "</div>\n";
+
+    // Subprocess Table
+    ss << "<div class='card'>\n";
+    ss << "  <div class='card-title'>Active Process Tree &amp; Resource Topology</div>\n";
+    ss << "  <table>\n";
+    ss << "    <thead><tr><th>PID</th><th>Process Type</th><th>Role</th><th>Isolation Level</th><th>Status</th></tr></thead>\n";
+    ss << "    <tbody>\n";
+
+    // Browser Main Process
+    ss << "      <tr><td>" << base::GetCurrentProcId() << "</td><td><strong>Browser Main</strong></td><td>UI &amp; Frame Coordination</td><td>Broker / Host Token</td><td><span class='badge badge-success'>HEALTHY</span></td></tr>\n";
+
+    // Renderers
+    int renderer_count = 0;
+    auto iter = content::RenderProcessHost::AllHostsIterator();
+    while (!iter.IsAtEnd()) {
+      if (iter.GetCurrentValue()->GetProcess().IsValid()) {
+        base::ProcessId rpid = iter.GetCurrentValue()->GetProcess().Pid();
+        if (rpid != 0) {
+          renderer_count++;
+          ss << "      <tr><td>" << rpid << "</td><td>Renderer</td><td>Site Isolated Content</td><td>Restricted Subprocess Sandbox</td><td><span class='badge badge-info'>RUNNING</span></td></tr>\n";
+        }
+      }
+      iter.Advance();
+    }
+
+    if (renderer_count == 0) {
+      ss << "      <tr><td colspan='5' style='color:#64748b;text-align:center;'>No background renderers currently active.</td></tr>\n";
+    }
+
+    ss << "    </tbody>\n";
+    ss << "  </table>\n";
+    ss << "</div>\n";
+
+    // Discard & Performance Policies
+    ss << "<div class='card' style='margin-top:20px;'>\n";
+    ss << "  <div class='card-title'>VELOX Tab Discard Heuristics &amp; RAM Protection Rules</div>\n";
+    ss << "  <table>\n";
+    ss << "    <thead><tr><th>Policy Condition</th><th>Heuristic Evaluation</th><th>Protection Action</th></tr></thead>\n";
+    ss << "    <tbody>\n";
+    ss << "      <tr><td>Active Audible Media</td><td>Detected via WebContents audio state</td><td><strong>PROHIBITED</strong> from discard</td></tr>\n";
+    ss << "      <tr><td>WebRTC Stream / Call</td><td>Active RTCPeerConnection established</td><td><strong>PROHIBITED</strong> from discard</td></tr>\n";
+    ss << "      <tr><td>Pending / Active Download</td><td>In-flight download item</td><td><strong>PROHIBITED</strong> from discard</td></tr>\n";
+    ss << "      <tr><td>Pinned Tab Status</td><td>User-pinned tab marker</td><td><strong>PROHIBITED</strong> from discard</td></tr>\n";
+    ss << "      <tr><td>Idle Background Tab (&gt;15 min)</td><td>No media, no WebRTC, unpinned</td><td>Eligible for graceful memory reclaim</td></tr>\n";
+    ss << "    </tbody>\n";
+    ss << "  </table>\n";
+    ss << "</div>\n";
+
+    ss << "<div class='footer'>VELOX High-Performance Desktop Browser &mdash; Master Engineering Directive Section 16 (Privileged WebUI)</div>\n";
+    ss << "</body></html>\n";
+
+    std::move(callback).Run(base::MakeRefCounted<base::RefCountedString>(ss.str()));
+  }
+
+ private:
+  raw_ptr<Profile> profile_;
+};
+
+}  // namespace
+
+VeloxPerformanceUIConfig::VeloxPerformanceUIConfig()
+    : DefaultWebUIConfig(content::kVeloxUIScheme,
+                         chrome::kVeloxUIPerformanceHost) {}
+
+VeloxPerformanceUI::VeloxPerformanceUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::URLDataSource::Add(
+      profile, std::make_unique<VeloxPerformanceHTMLSource>(profile));
+}
+
+VeloxPerformanceUI::~VeloxPerformanceUI() = default;
