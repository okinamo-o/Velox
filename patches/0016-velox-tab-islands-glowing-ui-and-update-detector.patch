+// Copyright 2026 The VELOX Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_COMMON_VELOX_SHIELD_RULES_H_
+#define CHROME_COMMON_VELOX_SHIELD_RULES_H_
+
+#include <string_view>
+
+namespace velox_shield {
+
+inline bool IsBlockedHost(std::string_view host) {
+  if (host.ends_with('.')) {
+    host.remove_suffix(1);
+  }
+  static constexpr const char* const kBlockedDomains[] = {
+    // Tracking & ad simulation domains (EFF Cover Your Tracks / Panopticlick)
+    "trackersimulator.org",
+    "eviltracker.net",
+
+    // Major ad networks
+    "doubleclick.net",
+    "googlesyndication.com",
+    "googleadservices.com",
+    "adservice.google.com",
+    "pagead2.googlesyndication.com",
+    "adnxs.com",
+    "criteo.com",
+    "amazon-adsystem.com",
+    "taboola.com",
+    "outbrain.com",
+    "moatads.com",
+    "casalemedia.com",
+    "rubiconproject.com",
+    "pubmatic.com",
+    "openx.net",
+    "smartadserver.com",
+    "adroll.com",
+    "advertising.com",
+    "bidswitch.net",
+    "revcontent.com",
+    "trafficjunky.com",
+    "exoclick.com",
+    "popads.net",
+    "propellerads.com",
+    "zedo.com",
+
+    // Major tracking & analytics networks
+    "google-analytics.com",
+    "analytics.google.com",
+    "scorecardresearch.com",
+    "quantserve.com",
+    "hotjar.com",
+    "segment.io",
+    "segment.com",
+    "mixpanel.com",
+    "chartbeat.com",
+  };
+
+  for (const char* domain : kBlockedDomains) {
+    std::string_view d(domain);
+    if (host == d) {
+      return true;
+    }
+    if (host.length() > d.length() &&
+        host.ends_with(d) &&
+        host[host.length() - d.length() - 1] == '.') {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace velox_shield
+
+#endif  // CHROME_COMMON_VELOX_SHIELD_RULES_H_
