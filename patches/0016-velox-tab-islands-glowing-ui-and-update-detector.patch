+  const base::TimeDelta elapsed = current_time - loading_animation_start_time_;
+  const double elapsed_ms = elapsed.InMillisecondsF();
+
+  // Velox Supersonic Dual-Tone Glowing Neon Arc Pulse:
+  // Primary arc: Neon Cyan (#38bdf8)
+  // Secondary arc: Neon Violet (#a855f7)
+  constexpr SkScalar kStrokeWidth = 2.0f;
+  gfx::Rect oval = bounds;
