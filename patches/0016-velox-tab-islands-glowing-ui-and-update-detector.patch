+void TabStripModel::RemoveFromSplit(int index) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  if (!ContainsIndex(index)) {
+    return;
+  }
+  tabs::TabModel* tab_model = GetTabModelAtIndex(index);
+  tab_model->set_split(false);
+
+  // Clear split flag on any adjacent split partner
+  if (index > 0 && ContainsIndex(index - 1) && GetTabModelAtIndex(index - 1)->IsSplit()) {
+    GetTabModelAtIndex(index - 1)->set_split(false);
+  }
+  if (index < count() - 1 && ContainsIndex(index + 1) && GetTabModelAtIndex(index + 1)->IsSplit()) {
+    GetTabModelAtIndex(index + 1)->set_split(false);
+  }
+
+  // Cleanup any orphaned split tabs without adjacent split partners
+  for (int i = 0; i < count(); ++i) {
+    tabs::TabModel* m = GetTabModelAtIndex(i);
+    if (m->IsSplit()) {
+      bool has_partner = (i > 0 && GetTabModelAtIndex(i - 1)->IsSplit()) ||
+                         (i < count() - 1 && GetTabModelAtIndex(i + 1)->IsSplit());
+      if (!has_partner) {
+        m->set_split(false);
+      }
+    }
+  }
+
+  for (int i = 0; i < count(); ++i) {
+    UpdateWebContentsStateAt(i, TabChangeType::kAll);
+  }
+
+  for (TabStripModelObserver& observer : observers_) {
+    observer.OnSplitViewRemoved();
+  }
+}
+
+void TabStripModel::StartSplitSelection(int index) {
+  if (!ContainsIndex(index)) {
+    return;
+  }
+  pending_split_tab_index_ = index;
+  for (TabStripModelObserver& observer : observers_) {
+    observer.TabChangedAt(GetWebContentsAt(index), index, TabChangeType::kAll);
+  }
+}
+
+void TabStripModel::CancelSplitSelection() {
+  if (!pending_split_tab_index_.has_value()) {
+    return;
+  }
+  int index = *pending_split_tab_index_;
+  pending_split_tab_index_.reset();
+  if (ContainsIndex(index)) {
+    for (TabStripModelObserver& observer : observers_) {
+      observer.TabChangedAt(GetWebContentsAt(index), index, TabChangeType::kAll);
+    }
+  }
+}
