+
+// VeloxAutoHideController provides Windows-taskbar-style auto-hide behavior
+// for the top container (tabs + address bar). It automatically reveals when
+// the mouse moves to the top edge of the window, keeps revealed while interacting
+// or focusing, peeks automatically when notifications arrive from websites like
+// Facebook, Instagram, or email, and protects fullscreen video players by showing
+// a subtle, non-intrusive notification pill instead of dropping the top bar.
+class VeloxAutoHideController : public ui::EventObserver,
+                                public gfx::AnimationDelegate,
+                                public views::FocusChangeListener,
+                                public NotificationDisplayService::Observer,
+                                public views::WidgetObserver {
+ public:
+  explicit VeloxAutoHideController(BrowserView* browser_view);
+  VeloxAutoHideController(const VeloxAutoHideController&) = delete;
+  VeloxAutoHideController& operator=(const VeloxAutoHideController&) = delete;
+  ~VeloxAutoHideController() override;
+
+  void Init();
+
+  // Whether the auto-hide top bar is enabled.
+  bool IsEnabled() const;
+  void SetEnabled(bool enabled);
+  void ToggleEnabled();
+
+  // Current fraction from 0.0 (completely hidden) to 1.0 (fully revealed).
+  double GetRevealFraction() const;
+
+  // Whether the top container is currently partially or fully revealed.
+  bool IsRevealed() const;
+
+  // Triggers slide-down reveal.
+  void Reveal(bool animate = true);
+
+  // Triggers slide-up hide if nothing is keeping it revealed.
+  void Hide(bool animate = true);
+
+  // Invoked when a notification is displayed or background tab activity is detected.
+  void OnNotificationReceived(const std::u16string& title,
+                              const GURL& origin,
+                              const std::u16string& message = std::u16string());
+
+  // Called when a new tab is opened to drop down the header temporarily.
+  void OnNewTabOpened();
+
+  // Called from TabStripModelObserver for background tab activity.
+  void OnBackgroundTabActivity(content::WebContents* contents);
+
+  // ui::EventObserver:
+  void OnEvent(const ui::Event& event) override;
+
+  // gfx::AnimationDelegate:
+  void AnimationProgressed(const gfx::Animation* animation) override;
+  void AnimationEnded(const gfx::Animation* animation) override;
+
+  // views::FocusChangeListener:
+  void OnWillChangeFocus(views::View* focused_before,
+                         views::View* focused_now) override {}
+  void OnDidChangeFocus(views::View* focused_before,
+                        views::View* focused_now) override;
+
+  // NotificationDisplayService::Observer:
+  void OnNotificationDisplayed(
+      const message_center::Notification& notification,
+      const NotificationCommon::Metadata* const metadata) override;
+  void OnNotificationClosed(const std::string& notification_id) override {}
+  void OnNotificationDisplayServiceDestroyed(
+      NotificationDisplayService* service) override;
+
+  // views::WidgetObserver:
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+ private:
+  bool CanHide() const;
+  bool IsVideoFullscreen() const;
+  void CheckMousePosition();
+  void ShowFullscreenVideoToast(const std::u16string& title,
+                                const std::u16string& message);
+  void DismissFullscreenVideoToast();
+  void OnNotificationPeekTimerExpired();
+  void UpdateTopContainerPosition();
+
+  raw_ptr<BrowserView> browser_view_ = nullptr;
+  std::unique_ptr<views::EventMonitor> event_monitor_;
+  std::unique_ptr<gfx::SlideAnimation> slide_animation_;
+
+  double reveal_fraction_ = 0.0;
+  bool is_enabled_ = false;
+  bool mouse_hovering_ = false;
+  bool notification_peek_in_progress_ = false;
+
+  std::u16string last_notified_background_title_;
+
+  base::RepeatingTimer mouse_poll_timer_;
+  base::OneShotTimer notification_peek_timer_;
+  base::OneShotTimer hide_debounce_timer_;
+  base::OneShotTimer toast_dismiss_timer_;
+
+  raw_ptr<views::Widget> fullscreen_toast_widget_ = nullptr;
+
+  base::ScopedObservation<NotificationDisplayService,
+                          NotificationDisplayService::Observer>
+      notification_observation_{this};
+
+  base::WeakPtrFactory<VeloxAutoHideController> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_VELOX_AUTO_HIDE_CONTROLLER_H_
