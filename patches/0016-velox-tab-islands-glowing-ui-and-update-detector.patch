+void ImportDataHandler::OpenImportedTabs(const base::FilePath& source_path) {
+  if (source_path.empty()) {
+    return;
+  }
+  Browser* browser = chrome::FindBrowserWithTab(web_ui()->GetWebContents());
+  if (!browser) {
+    return;
+  }
+
+  base::FilePath sessions_dir =
+      source_path.Append(FILE_PATH_LITERAL("Sessions"));
+  if (!base::DirectoryExists(sessions_dir)) {
+    return;
+  }
+
+  std::vector<base::FilePath> session_files;
+  base::FileEnumerator enumerator(sessions_dir, false,
+                                  base::FileEnumerator::FILES,
+                                  FILE_PATH_LITERAL("Session_*"));
+  for (base::FilePath file = enumerator.Next(); !file.empty();
+       file = enumerator.Next()) {
+    session_files.push_back(file);
+  }
+
+  std::sort(session_files.begin(), session_files.end(),
+            [](const base::FilePath& a, const base::FilePath& b) {
+              base::File::Info info_a, info_b;
+              base::GetFileInfo(a, &info_a);
+              base::GetFileInfo(b, &info_b);
+              return info_a.last_modified > info_b.last_modified;
+            });
+
+  std::vector<std::string> urls_to_open;
+
+  for (const auto& sfile : session_files) {
+    std::string data;
+    if (!base::ReadFileToString(sfile, &data) || data.size() < 8) {
+      continue;
+    }
+
+    uint32_t sig = *reinterpret_cast<const uint32_t*>(data.data());
+    if (sig != 0x53534E53) {  // "SSNS"
+      continue;
+    }
+
+    size_t offset = 8;
+    std::map<int32_t, bool> closed_tabs;
+    std::map<int32_t, std::map<int32_t, std::string>> tab_navigations;
+    std::map<int32_t, int32_t> current_indices;
+
+    while (offset + 2 <= data.size()) {
+      uint16_t cmd_size =
+          *reinterpret_cast<const uint16_t*>(data.data() + offset);
+      offset += 2;
+      if (cmd_size == 0 || offset + cmd_size > data.size()) {
+        break;
+      }
+      uint8_t cmd_id = static_cast<uint8_t>(data[offset]);
+      const char* payload = data.data() + offset + 1;
+      size_t payload_len = cmd_size - 1;
+      offset += cmd_size;
+
+      if (cmd_id == 16 && payload_len >= 4) {  // TabClosed
+        int32_t tab_id = *reinterpret_cast<const int32_t*>(payload);
+        closed_tabs[tab_id] = true;
+      } else if (cmd_id == 7 && payload_len >= 8) {  // SetSelectedNavigationIndex
+        int32_t tab_id = *reinterpret_cast<const int32_t*>(payload);
+        int32_t idx = *reinterpret_cast<const int32_t*>(payload + 4);
+        current_indices[tab_id] = idx;
+      } else if (cmd_id == 6 && payload_len >= 16) {  // UpdateTabNavigation
+        base::Pickle pickle = base::Pickle::WithUnownedBuffer(
+            base::as_byte_span(std::string_view(payload, payload_len)));
+        base::PickleIterator iter(pickle);
+        int32_t tab_id = 0;
+        int32_t nav_index = 0;
+        std::string url;
+        if (iter.ReadInt(&tab_id) && iter.ReadInt(&nav_index) &&
+            iter.ReadString(&url)) {
+          if (!url.empty()) {
+            tab_navigations[tab_id][nav_index] = url;
+          }
+        }
+      }
+    }
+
+    for (const auto& pair : closed_tabs) {
+      if (pair.second) {
+        tab_navigations.erase(pair.first);
+      }
+    }
+
+    for (const auto& pair : tab_navigations) {
+      int32_t tab_id = pair.first;
+      const auto& navs = pair.second;
+      if (navs.empty()) {
+        continue;
+      }
+      int32_t target_idx = current_indices.count(tab_id)
+                               ? current_indices[tab_id]
+                               : navs.rbegin()->first;
+      auto it = navs.find(target_idx);
+      if (it != navs.end()) {
+        urls_to_open.push_back(it->second);
+      } else {
+        urls_to_open.push_back(navs.rbegin()->second);
+      }
+    }
+
+    if (!urls_to_open.empty()) {
+      break;
+    }
+  }
+
+  // VELOX: Collect all URLs currently open across all browser windows for this profile.
+  std::set<std::string> open_urls;
+  for (Browser* b : *BrowserList::GetInstance()) {
+    if (b->profile() != browser->profile()) {
+      continue;
+    }
+    TabStripModel* tab_strip = b->tab_strip_model();
+    for (int i = 0; i < tab_strip->count(); ++i) {
+      content::WebContents* contents = tab_strip->GetWebContentsAt(i);
+      if (contents) {
+        const GURL& u1 = contents->GetVisibleURL();
+        if (u1.is_valid()) {
+          open_urls.insert(u1.spec());
+        }
+        const GURL& u2 = contents->GetLastCommittedURL();
+        if (u2.is_valid()) {
+          open_urls.insert(u2.spec());
+        }
+      }
+    }
+  }
+
+  auto is_url_already_open = [&open_urls](const GURL& url) {
+    if (open_urls.count(url.spec()) > 0) {
+      return true;
+    }
+    std::string spec = url.spec();
+    if (spec.back() == '/' && spec.size() > 1 && url.path() != "/") {
+      if (open_urls.count(spec.substr(0, spec.size() - 1)) > 0) {
+        return true;
+      }
+    } else if (spec.back() != '/') {
+      if (open_urls.count(spec + "/") > 0) {
+        return true;
+      }
+    }
+    return false;
+  };
+
+  for (const auto& url_str : urls_to_open) {
+    GURL gurl(url_str);
+    if (gurl.is_valid() &&
+        (gurl.SchemeIs(url::kHttpScheme) || gurl.SchemeIs(url::kHttpsScheme))) {
+      // VELOX: Skip tabs that are already open or duplicate within this batch.
+      if (is_url_already_open(gurl)) {
+        continue;
+      }
+      open_urls.insert(gurl.spec());
+      chrome::AddTabAt(browser, gurl, -1, /*foreground=*/false);
+    }
+  }
+}
