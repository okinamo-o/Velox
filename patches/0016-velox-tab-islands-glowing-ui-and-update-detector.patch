+  const double base_angle = std::fmod(elapsed_ms * (360.0 / 1100.0), 360.0);
+  // Pulse sweep angle smoothly between 45 and 135 degrees
+  const double pulse = std::sin(elapsed_ms * (2.0 * 3.141592653589793 / 1400.0));
+  const double sweep_cyan = 90.0 + 45.0 * pulse;
+  const double sweep_violet = 90.0 - 45.0 * pulse;
+
+  // Primary Neon Cyan Arc
+  SkPath cyan_path;
