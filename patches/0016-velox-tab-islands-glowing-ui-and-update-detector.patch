+                  static_cast<SkScalar>(sweep_cyan), true);
+  cc::PaintFlags cyan_flags;
+  cyan_flags.setColor(SkColorSetRGB(0x38, 0xBD, 0xF8));
+  cyan_flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+  cyan_flags.setStrokeWidth(kStrokeWidth);
+  cyan_flags.setStyle(cc::PaintFlags::kStroke_Style);
+  cyan_flags.setAntiAlias(true);
+  canvas->DrawPath(cyan_path, cyan_flags);
+
+  // Secondary Neon Violet Arc (chasing 180 degrees opposite)
+  SkPath violet_path;
+  const double violet_start = std::fmod(base_angle + 180.0, 360.0);
+  violet_path.arcTo(sk_oval, static_cast<SkScalar>(violet_start),
+                    static_cast<SkScalar>(sweep_violet), true);
+  cc::PaintFlags violet_flags;
+  violet_flags.setColor(SkColorSetRGB(0xA8, 0x55, 0xF7));
+  violet_flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+  violet_flags.setStrokeWidth(kStrokeWidth);
+  violet_flags.setStyle(cc::PaintFlags::kStroke_Style);
+  violet_flags.setAntiAlias(true);
+  canvas->DrawPath(violet_path, violet_flags);
 }
 
