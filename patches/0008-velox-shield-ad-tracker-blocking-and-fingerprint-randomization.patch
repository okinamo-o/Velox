+namespace {
+
+class VeloxShieldNavigationThrottle : public content::NavigationThrottle {
+ public:
+  explicit VeloxShieldNavigationThrottle(content::NavigationHandle* handle)
+      : content::NavigationThrottle(handle) {}
+  ~VeloxShieldNavigationThrottle() override = default;
+
+  ThrottleCheckResult WillStartRequest() override {
+    const GURL& url = navigation_handle()->GetURL();
+    if (url.has_host() && velox_shield::IsBlockedHost(url.host_piece())) {
+      return ThrottleCheckResult(content::NavigationThrottle::BLOCK_REQUEST,
+                                 net::ERR_BLOCKED_BY_CLIENT);
+    }
+    return ThrottleCheckResult(content::NavigationThrottle::PROCEED);
+  }
+
+  ThrottleCheckResult WillRedirectRequest() override {
+    const GURL& url = navigation_handle()->GetURL();
+    if (url.has_host() && velox_shield::IsBlockedHost(url.host_piece())) {
+      return ThrottleCheckResult(content::NavigationThrottle::BLOCK_REQUEST,
+                                 net::ERR_BLOCKED_BY_CLIENT);
+    }
+    return ThrottleCheckResult(content::NavigationThrottle::PROCEED);
+  }
+
+  const char* GetNameForLogging() override {
+    return "VeloxShieldNavigationThrottle";
+  }
+};
+
+}  // namespace
