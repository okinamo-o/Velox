+void ParseChromiumNode(const base::Value::Dict& node,
+                       bool in_toolbar,
+                       std::vector<std::u16string>* path,
+                       std::vector<ImportedBookmarkEntry>* bookmarks) {
+  const std::string* type = node.FindString("type");
+  const std::string* name = node.FindString("name");
+  std::u16string title = name ? base::UTF8ToUTF16(*name) : std::u16string();
+
+  if (type && *type == "url") {
+    const std::string* url_str = node.FindString("url");
+    if (url_str) {
+      GURL url(*url_str);
+      if (url.is_valid()) {
+        ImportedBookmarkEntry entry;
+        entry.in_toolbar = in_toolbar;
+        entry.is_folder = false;
+        entry.url = url;
+        entry.title = title;
+        entry.path = *path;
+        bookmarks->push_back(entry);
+      }
+    }
+  } else if (type && *type == "folder") {
+    const base::Value::List* children = node.FindList("children");
+    if (children) {
+      path->push_back(title);
+      for (const auto& child : *children) {
+        if (child.is_dict()) {
+          ParseChromiumNode(child.GetDict(), in_toolbar, path, bookmarks);
+        }
+      }
+      path->pop_back();
+    }
+  }
+}
+
+void ParseChromiumBookmarks(const base::FilePath& bookmarks_path,
+                            std::vector<ImportedBookmarkEntry>* bookmarks) {
+  std::string content;
+  if (!base::ReadFileToString(bookmarks_path, &content)) {
+    return;
+  }
+
+  std::optional<base::Value> json_val = base::JSONReader::Read(content);
+  if (!json_val || !json_val->is_dict()) {
+    return;
+  }
+
+  const base::Value::Dict* roots = json_val->GetDict().FindDict("roots");
+  if (!roots) return;
+
+  std::vector<std::u16string> path;
+
+  // 1. Bookmark bar
+  const base::Value::Dict* bookmark_bar = roots->FindDict("bookmark_bar");
+  if (bookmark_bar) {
+    const base::Value::List* children = bookmark_bar->FindList("children");
+    if (children) {
+      for (const auto& child : *children) {
+        if (child.is_dict()) {
+          ParseChromiumNode(child.GetDict(), /*in_toolbar=*/true, &path, bookmarks);
+        }
+      }
+    }
+  }
+
+  // 2. Other bookmarks
+  const base::Value::Dict* other = roots->FindDict("other");
+  if (other) {
+    const base::Value::List* children = other->FindList("children");
+    if (children) {
+      for (const auto& child : *children) {
+        if (child.is_dict()) {
+          ParseChromiumNode(child.GetDict(), /*in_toolbar=*/false, &path, bookmarks);
+        }
+      }
+    }
+  }
+
+  // 3. Synced bookmarks
+  const base::Value::Dict* synced = roots->FindDict("synced");
+  if (synced) {
+    const base::Value::List* children = synced->FindList("children");
+    if (children) {
+      for (const auto& child : *children) {
+        if (child.is_dict()) {
+          ParseChromiumNode(child.GetDict(), /*in_toolbar=*/false, &path, bookmarks);
+        }
+      }
+    }
+  }
+}
