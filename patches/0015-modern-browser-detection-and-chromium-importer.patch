+std::wstring GetSystemDefaultBrowserName() {
+  wchar_t buffer[256] = {0};
+  DWORD size = std::size(buffer);
+  HRESULT hr = AssocQueryStringW(ASSOCF_IS_PROTOCOL, ASSOCSTR_FRIENDLYAPPNAME,
+                                 L"https", nullptr, buffer, &size);
+  if (SUCCEEDED(hr) && buffer[0] != L'\0') {
+    return std::wstring(buffer);
+  }
+  return std::wstring();
+}
