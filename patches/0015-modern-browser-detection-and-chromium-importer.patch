+void EdgeImporter::ImportHistory() {
+  base::FilePath history_path = source_path_.Append(L"History");
+  if (!base::PathExists(history_path)) {
+    return;
+  }
+
+  base::FilePath temp_file;
+  if (!base::CreateTemporaryFile(&temp_file)) {
+    return;
+  }
+  if (!base::CopyFile(history_path, temp_file)) {
+    base::DeleteFile(temp_file);
+    return;
+  }
+
+  sql::Database db("History");
+  if (db.Open(temp_file)) {
+    sql::Statement s(db.GetUniqueStatement(
+        "SELECT url, title, visit_count, typed_count, last_visit_time FROM urls ORDER BY last_visit_time DESC LIMIT 200"));
+    std::vector<ImporterURLRow> rows;
+    while (s.Step() && !cancelled()) {
+      std::string url_str = s.ColumnString(0);
+      std::u16string title = s.ColumnString16(1);
+      int visit_count = s.ColumnInt(2);
+      int typed_count = s.ColumnInt(3);
+      int64_t last_visit_time = s.ColumnInt64(4);
+
+      GURL url(url_str);
+      if (url.is_valid()) {
+        ImporterURLRow row(url);
+        row.title = title;
+        row.visit_count = visit_count;
+        row.typed_count = typed_count;
+        row.last_visit = base::Time::FromInternalValue(last_visit_time);
+        row.hidden = false;
+        rows.push_back(row);
+      }
+    }
+    db.Close();
+    if (!rows.empty() && !cancelled()) {
+      bridge_->SetHistoryItems(rows, importer::VISIT_SOURCE_BROWSED);
+    }
+  }
+  base::DeleteFile(temp_file);
+}
