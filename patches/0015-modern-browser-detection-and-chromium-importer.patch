+void DetectInstalledBrowsersWin(std::vector<importer::SourceProfile>* profiles) {
+  base::ScopedBlockingCall scoped_blocking_call(FROM_HERE,
+                                                base::BlockingType::MAY_BLOCK);
+
+  base::FilePath local_app_data;
+  base::PathService::Get(base::DIR_LOCAL_APP_DATA, &local_app_data);
+  base::FilePath app_data;
+  base::PathService::Get(base::DIR_ROAMING_APP_DATA, &app_data);
+
+  std::wstring default_browser_name = GetSystemDefaultBrowserName();
+
+  struct BrowserCandidate {
+    const wchar_t* display_name;
+    base::FilePath profile_path;
+  };
+
+  std::vector<BrowserCandidate> candidates;
+
+  if (!local_app_data.empty()) {
+    candidates.push_back({
+        L"Google Chrome",
+        local_app_data.Append(L"Google\\Chrome\\User Data\\Default")
+    });
+    candidates.push_back({
+        L"Microsoft Edge",
+        local_app_data.Append(L"Microsoft\\Edge\\User Data\\Default")
+    });
+    candidates.push_back({
+        L"Brave Browser",
+        local_app_data.Append(L"BraveSoftware\\Brave-Browser\\User Data\\Default")
+    });
+    candidates.push_back({
+        L"Comet",
+        local_app_data.Append(L"Perplexity\\Comet\\User Data\\Default")
+    });
+    candidates.push_back({
+        L"Vivaldi",
+        local_app_data.Append(L"Vivaldi\\User Data\\Default")
+    });
+  }
+
+  if (!app_data.empty()) {
+    candidates.push_back({
+        L"Opera",
+        app_data.Append(L"Opera Software\\Opera Stable")
+    });
+  }
+
+  std::vector<importer::SourceProfile> detected_browsers;
+
+  for (const auto& candidate : candidates) {
+    if (base::PathExists(candidate.profile_path)) {
+      importer::SourceProfile sp;
+      std::wstring name_w = candidate.display_name;
+
+      bool is_default = false;
+      if (!default_browser_name.empty()) {
+        if (default_browser_name.find(candidate.display_name) != std::wstring::npos ||
+            name_w.find(default_browser_name) != std::wstring::npos) {
+          is_default = true;
+        }
+      }
+
+      std::u16string display_u16 = base::WideToUTF16(name_w);
+      if (is_default) {
+        display_u16 += u" (Default)";
+      }
+
+      sp.importer_name = display_u16;
+      sp.importer_type = importer::TYPE_EDGE;
+      sp.source_path = candidate.profile_path;
+      sp.services_supported = importer::HISTORY | importer::FAVORITES |
+                              importer::AUTOFILL_FORM_DATA |
+                              importer::PASSWORDS | importer::SEARCH_ENGINES;
+
+      if (is_default) {
+        detected_browsers.insert(detected_browsers.begin(), sp);
+      } else {
+        detected_browsers.push_back(sp);
+      }
+    }
+  }
+
+  if (!default_browser_name.empty()) {
+    bool already_present = false;
+    for (const auto& b : detected_browsers) {
+      if (b.importer_name.find(u"(Default)") != std::u16string::npos) {
+        already_present = true;
+        break;
+      }
+    }
+    if (!already_present) {
+      importer::SourceProfile def_sp;
+      def_sp.importer_name = base::WideToUTF16(default_browser_name) + u" (Default)";
+      def_sp.importer_type = importer::TYPE_EDGE;
+      def_sp.services_supported = importer::HISTORY | importer::FAVORITES;
+      detected_browsers.insert(detected_browsers.begin(), def_sp);
+    }
+  }
+
+  profiles->insert(profiles->begin(), detected_browsers.begin(), detected_browsers.end());
+}
