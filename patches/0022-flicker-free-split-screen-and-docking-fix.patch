+                              gfx::Insets::TLBR(3, 6, 6, 6));
+    }
+    left_contents_view_->SetBackgroundRadii(radii);
+    if (left_contents_view_->holder()) {
+      left_contents_view_->holder()->SetCornerRadii(radii);
+    }
+    left_card_->SchedulePaint();
+  }
+  InvalidateLayout();
 }
 
