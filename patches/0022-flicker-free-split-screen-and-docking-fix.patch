+          u"⚡ Velox Update Available", views::style::CONTEXT_DIALOG_TITLE,
+          views::style::STYLE_PRIMARY));
+      title_label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      title_label->SetFontList(title_label->font_list().Derive(
+          3, gfx::Font::NORMAL, gfx::Font::Weight::BOLD));
+
+      status_label_ = AddChildView(std::make_unique<views::Label>(
+          u"🚀 A new Velox update is ready to install!",
+          views::style::CONTEXT_LABEL, views::style::STYLE_PRIMARY));
+      status_label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+
+      auto* desc_label = AddChildView(std::make_unique<views::Label>(
+          u"Restart Velox now to apply the latest speed, security, and feature "
+          u"updates. All your open tabs and windows will be restored.",
+          views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+      desc_label->SetMultiLine(true);
+      desc_label->SetMaximumWidth(320);
+      desc_label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+
+      // Button Row
+      auto* button_row = AddChildView(std::make_unique<views::View>());
+      auto* row_layout =
+          button_row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+              views::BoxLayout::Orientation::kHorizontal,
+              gfx::Insets::TLBR(8, 0, 0, 0), 8));
+      row_layout->set_main_axis_alignment(
+          views::BoxLayout::MainAxisAlignment::kEnd);
+
+      check_button_ =
+          button_row->AddChildView(std::make_unique<views::MdTextButton>(
+              base::BindRepeating(&VeloxUpdateBubble::OnRelaunchClicked,
+                                  base::Unretained(this)),
+              u"Relaunch to Update"));
+      check_button_->SetStyle(ui::ButtonStyle::kProminent);
+
+      auto* later_button =
+          button_row->AddChildView(std::make_unique<views::MdTextButton>(
+              base::BindRepeating(&VeloxUpdateBubble::OnLaterClicked,
+                                  base::Unretained(this)),
+              u"Later"));
+      later_button->SetStyle(ui::ButtonStyle::kDefault);
+    } else {
+      // Header Title with emoji badge
+      auto* title_label = AddChildView(std::make_unique<views::Label>(
+          u"⚡ Velox Browser", views::style::CONTEXT_DIALOG_TITLE,
+          views::style::STYLE_PRIMARY));
+      title_label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      title_label->SetFontList(title_label->font_list().Derive(
+          3, gfx::Font::NORMAL, gfx::Font::Weight::BOLD));
+
+      // Status / Version
+      status_label_ = AddChildView(std::make_unique<views::Label>(
