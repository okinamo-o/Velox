+std::optional<SkColor> GetGroupColorForContents(
+    BrowserView* browser_view,
+    content::WebContents* contents) {
+  if (!browser_view || !contents || !browser_view->browser() ||
+      !browser_view->tabstrip()) {
+    return std::nullopt;
+  }
+  TabStripModel* model = browser_view->browser()->tab_strip_model();
+  if (!model) {
+    return std::nullopt;
+  }
+  const int index = model->GetIndexOfWebContents(contents);
+  if (index == TabStripModel::kNoTab ||
+      index >= browser_view->tabstrip()->GetTabCount()) {
+    return std::nullopt;
+  }
+  Tab* tab = browser_view->tabstrip()->tab_at(index);
+  return tab ? tab->GetGroupColor() : std::nullopt;
+}
