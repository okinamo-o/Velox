+// ============================================================================
+// VeloxSpacesControl: Toolbar Segmented Pill for Spaces 1 / 2 / 3
+// ============================================================================
+class VeloxSpacesControl : public views::View,
+                           public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(VeloxSpacesControl, views::View)
+
+ public:
+  enum ContextCommand {
+    kCommandRename = 1,
+    kCommandMoveTab,
+    kCommandSwitch,
+    kCommandResetName,
+  };
+
+  explicit VeloxSpacesControl(Browser* browser) : browser_(browser) {
+    if (browser_ && browser_->profile()) {
+      velox::LoadSpaceNames(browser_->profile());
+    }
+    UpdateTooltip();
+    GetViewAccessibility().SetName(u"Velox Workspaces");
+    GetVeloxState().spaces_controls.insert(this);
+  }
+
+  ~VeloxSpacesControl() override {
+    GetVeloxState().spaces_controls.erase(this);
+  }
+
+  void UpdateTooltip() {
+    std::u16string tip =
+        u"Velox Spaces: Click to switch • Double-click or Right-click to rename • "
+        u"Ctrl+1 / Ctrl+2 / Ctrl+3\n";
+    for (int i = 0; i < 3; ++i) {
+      tip += u"[" + base::NumberToString16(i + 1) + u"] " + velox::GetSpaceName(i);
+      if (i < 2) {
+        tip += u"  •  ";
+      }
+    }
+    SetTooltipText(tip);
+  }
+
+  void NotifyUpdated() {
+    UpdateTooltip();
+    PreferredSizeChanged();
+    SchedulePaint();
+  }
+
+  int GetActiveSpace() const {
+    if (!browser_) {
+      return 0;
+    }
+    BrowserView* bv = BrowserView::GetBrowserViewForBrowser(browser_);
+    if (!bv || !bv->tabstrip()) {
+      return 0;
+    }
+    return velox::GetTabStripActiveWorkspace(bv->tabstrip());
+  }
+
+  int GetSegmentWidth(int i, int active) const {
+    if (i != active) {
+      return 28;
+    }
+    const gfx::FontList bold_font = gfx::FontList().Derive(
+        0, gfx::Font::NORMAL, gfx::Font::Weight::BOLD);
+    std::u16string label =
+        base::NumberToString16(i + 1) + u" " + velox::GetSpaceName(i);
+    int text_w = gfx::Canvas::GetStringWidth(label, bold_font);
+    return std::clamp(text_w + 16, 56, 120);
+  }
+
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    int active = GetActiveSpace();
+    int total_w = 8;
+    for (int i = 0; i < 3; ++i) {
+      total_w += GetSegmentWidth(i, active);
+    }
+    return gfx::Size(total_w, 28);
+  }
+
+  int HitSpaceIndex(int x) const {
+    int active = GetActiveSpace();
+    int cur_x = 3;
+    for (int i = 0; i < 3; ++i) {
+      int seg_w = GetSegmentWidth(i, active);
+      if (x < cur_x + seg_w || i == 2) {
+        return i;
+      }
+      cur_x += seg_w + 1;
+    }
+    return 0;
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    int space_idx = HitSpaceIndex(event.x());
+
+    // Double-click opens rename dialog directly
+    if (event.flags() & ui::EF_IS_DOUBLE_CLICK) {
+      VeloxRenameSpaceBubble::Show(this, browser_, space_idx);
+      return true;
+    }
+
+    // Right-click opens context menu with Rename, Move Tab, Switch, Reset
+    if (event.IsOnlyRightMouseButton()) {
+      ShowContextMenuForSpace(space_idx, event.location());
+      return true;
+    }
+
+    // Middle-click instantly moves current tab to this space
+    if (event.IsMiddleMouseButton()) {
+      velox::MoveActiveTabToWorkspace(browser_, space_idx);
+      return true;
+    }
+
+    // Left-click switches workspace
+    if (event.IsOnlyLeftMouseButton()) {
+      velox::SwitchWorkspace(browser_, space_idx);
+      return true;
+    }
+    return false;
+  }
+
+  void OnMouseMoved(const ui::MouseEvent& event) override {
+    int h = HitSpaceIndex(event.x());
+    if (h != hovered_space_) {
+      hovered_space_ = h;
+      SchedulePaint();
+    }
+  }
+
+  void OnMouseExited(const ui::MouseEvent& event) override {
+    if (hovered_space_ != -1) {
+      hovered_space_ = -1;
+      SchedulePaint();
+    }
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    gfx::ScopedCanvas scoped(canvas);
+    const float scale = canvas->UndoDeviceScaleFactor();
+
+    gfx::RectF outer_f(GetLocalBounds());
+    outer_f.Scale(scale);
+    outer_f.Inset(gfx::InsetsF::VH(1.5f * scale, 2.0f * scale));
+
+    const float outer_radius = outer_f.height() / 2.0f;
+    SkRRect outer_rr;
+    outer_rr.setRectXY(gfx::RectFToSkRect(outer_f), outer_radius, outer_radius);
+
+    // Dark glass outer pill
+    cc::PaintFlags outer_bg;
+    outer_bg.setAntiAlias(true);
+    outer_bg.setStyle(cc::PaintFlags::kFill_Style);
+    outer_bg.setColor(SkColorSetARGB(195, 11, 15, 25));
+    canvas->sk_canvas()->drawRRect(outer_rr, outer_bg);
+
+    cc::PaintFlags outer_border;
+    outer_border.setAntiAlias(true);
+    outer_border.setStyle(cc::PaintFlags::kStroke_Style);
+    outer_border.setStrokeWidth(1.0f * scale);
+    outer_border.setColor(SkColorSetARGB(85, 56, 189, 248));
+    canvas->sk_canvas()->drawRRect(outer_rr, outer_border);
+
+    canvas->sk_canvas()->restore();  // Back to DIPs for segment layout & text
+
+    const int active = GetActiveSpace();
+    const SkColor kSpaceColors[3] = {
+        SkColorSetRGB(0, 240, 255),    // Space 1: Cyan
+        SkColorSetRGB(168, 85, 247),   // Space 2: Purple
+        SkColorSetRGB(16, 185, 129),   // Space 3: Emerald
+    };
+
+    int cur_x = 3;
+    for (int i = 0; i < 3; ++i) {
+      int seg_w = GetSegmentWidth(i, active);
+      gfx::Rect seg_rect(cur_x, 3, seg_w, height() - 6);
+
+      if (i == active || i == hovered_space_) {
+        gfx::ScopedCanvas seg_scoped(canvas);
+        const float s = canvas->UndoDeviceScaleFactor();
+        gfx::RectF sf(seg_rect);
+        sf.Scale(s);
+        SkRRect srr;
+        srr.setRectXY(gfx::RectFToSkRect(sf), sf.height() / 2.0f,
+                      sf.height() / 2.0f);
+
+        cc::PaintFlags seg_fill;
+        seg_fill.setAntiAlias(true);
+        seg_fill.setStyle(cc::PaintFlags::kFill_Style);
+        uint8_t alpha = (i == active) ? 55 : 28;
+        seg_fill.setColor(SkColorSetA(kSpaceColors[i], alpha));
+        canvas->sk_canvas()->drawRRect(srr, seg_fill);
+
+        if (i == active) {
+          cc::PaintFlags seg_rim;
+          seg_rim.setAntiAlias(true);
+          seg_rim.setStyle(cc::PaintFlags::kStroke_Style);
+          seg_rim.setStrokeWidth(1.2f * s);
+          seg_rim.setColor(SkColorSetA(kSpaceColors[i], 190));
+          canvas->sk_canvas()->drawRRect(srr, seg_rim);
+        }
+      }
+
+      SkColor text_col = (i == active)
+                             ? SK_ColorWHITE
+                             : (i == hovered_space_
+                                    ? kSpaceColors[i]
+                                    : SkColorSetRGB(148, 163, 184));
+      std::u16string label =
+          (i == active)
+              ? (base::NumberToString16(i + 1) + u" " + velox::GetSpaceName(i))
+              : base::NumberToString16(i + 1);
+      canvas->DrawStringRectWithFlags(
+          label,
+          gfx::FontList().Derive(
+              0, gfx::Font::NORMAL,
+              (i == active) ? gfx::Font::Weight::BOLD
+                            : gfx::Font::Weight::SEMIBOLD),
+          text_col, seg_rect,
+          gfx::Canvas::TEXT_ALIGN_CENTER | gfx::Canvas::NO_SUBPIXEL_RENDERING);
+
+      cur_x += seg_w + 1;
+    }
+  }
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override {
+    switch (command_id) {
+      case kCommandRename:
+        VeloxRenameSpaceBubble::Show(this, browser_, context_space_idx_);
+        break;
+      case kCommandMoveTab:
+        velox::MoveActiveTabToWorkspace(browser_, context_space_idx_);
+        break;
+      case kCommandSwitch:
+        velox::SwitchWorkspace(browser_, context_space_idx_);
+        break;
+      case kCommandResetName: {
+        const std::u16string kDefaults[3] = {u"General", u"Work", u"Focus"};
+        velox::SetSpaceName(context_space_idx_, kDefaults[context_space_idx_],
+                            browser_ ? browser_->profile() : nullptr);
+        break;
+      }
+    }
+  }
+
+ private:
+  void ShowContextMenuForSpace(int space_idx, const gfx::Point& local_point) {
+    context_space_idx_ = space_idx;
+    menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    std::u16string name = velox::GetSpaceName(space_idx);
+
+    menu_model_->AddItem(kCommandRename,
+                         u"✏️ Rename \"" + name + u"\" Space...");
+    menu_model_->AddItem(kCommandMoveTab,
+                         u"➡️ Move Current Tab to this Space");
+    if (space_idx != GetActiveSpace()) {
+      menu_model_->AddItem(kCommandSwitch, u"🔄 Switch to this Space");
+    }
+    menu_model_->AddSeparator(ui::MenuSeparatorType::NORMAL_SEPARATOR);
+    menu_model_->AddItem(kCommandResetName, u"↩️ Reset Name to Default");
+
+    menu_runner_ = std::make_unique<views::MenuRunner>(
+        menu_model_.get(),
+        views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+
+    gfx::Point screen_loc = local_point;
+    views::View::ConvertPointToScreen(this, &screen_loc);
+    menu_runner_->RunMenuAt(
+        GetWidget(), nullptr, gfx::Rect(screen_loc, gfx::Size()),
+        views::MenuAnchorPosition::kTopLeft, ui::mojom::MenuSourceType::kMouse);
+  }
+
+  raw_ptr<Browser> browser_ = nullptr;
+  int hovered_space_ = -1;
+  int context_space_idx_ = 0;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+};
