+// VeloxRenameSpaceBubble: Glassmorphic Rename Dialog for Spaces
+// ============================================================================
+class VeloxRenameSpaceBubble : public views::BubbleDialogDelegateView,
+                               public views::TextfieldController {
+  METADATA_HEADER(VeloxRenameSpaceBubble, views::BubbleDialogDelegateView)
+
+ public:
+  static void Show(views::View* anchor_view,
+                   Browser* browser,
+                   int space_index) {
+    auto& st = GetVeloxState();
+    if (st.active_rename_bubble_widget) {
+      st.active_rename_bubble_widget->Close();
+      st.active_rename_bubble_widget = nullptr;
+    }
+    auto bubble = std::make_unique<VeloxRenameSpaceBubble>(anchor_view, browser,
+                                                           space_index);
+    views::Widget* widget =
+        views::BubbleDialogDelegateView::CreateBubble(std::move(bubble));
+    st.active_rename_bubble_widget = widget;
+    widget->Show();
+  }
+
+  VeloxRenameSpaceBubble(views::View* anchor_view,
+                         Browser* browser,
+                         int space_index)
+      : BubbleDialogDelegateView(anchor_view, views::BubbleBorder::TOP_LEFT),
+        browser_(browser),
+        space_index_(space_index) {
+    SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+    set_margins(gfx::Insets::VH(16, 20));
+    set_color(SkColorSetRGB(13, 17, 26));
+    SetTitle(u"Velox Spaces");
+    SetShowTitle(false);
+    SetShowCloseButton(true);
+  }
+
+  ~VeloxRenameSpaceBubble() override {
+    if (GetVeloxState().active_rename_bubble_widget == GetWidget()) {
+      GetVeloxState().active_rename_bubble_widget = nullptr;
+    }
+  }
+
+  void Init() override {
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 10));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kStretch);
+
+    // Title label
+    auto* title_label = AddChildView(std::make_unique<views::Label>(
+        u"✏️ Rename Space " + base::NumberToString16(space_index_ + 1),
+        views::style::CONTEXT_DIALOG_TITLE, views::style::STYLE_PRIMARY));
+    title_label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    title_label->SetEnabledColor(SkColorSetRGB(241, 245, 249));
+    title_label->SetFontList(title_label->font_list().Derive(
+        2, gfx::Font::NORMAL, gfx::Font::Weight::BOLD));
+
+    auto* desc_label = AddChildView(std::make_unique<views::Label>(
+        u"Choose a name that fits your workflow (e.g. Work, Gaming, Dev, Study):",
+        views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+    desc_label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    desc_label->SetEnabledColor(SkColorSetRGB(148, 163, 184));
+
+    // Input text field
+    name_field_ = AddChildView(std::make_unique<views::Textfield>());
+    name_field_->SetText(velox::GetSpaceName(space_index_));
+    name_field_->SetPlaceholderText(u"Enter space name...");
+    name_field_->SetController(this);
+    name_field_->SelectAll(false);
+
+    // Quick suggestion chips
+    auto* chips_label = AddChildView(std::make_unique<views::Label>(
+        u"Quick Presets:", views::style::CONTEXT_LABEL,
+        views::style::STYLE_SECONDARY));
+    chips_label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    chips_label->SetEnabledColor(SkColorSetRGB(100, 116, 139));
+
+    auto* chips_row = AddChildView(std::make_unique<views::View>());
+    auto* chips_layout = chips_row->SetLayoutManager(
+        std::make_unique<views::BoxLayout>(
+            views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 6));
+    chips_layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+
+    const std::vector<std::u16string> presets = {
+        u"Work", u"Personal", u"Gaming", u"Dev", u"Study", u"Focus"};
+    for (const auto& preset : presets) {
+      auto* chip = chips_row->AddChildView(std::make_unique<views::MdTextButton>(
+          base::BindRepeating(&VeloxRenameSpaceBubble::OnPresetClicked,
+                              base::Unretained(this), preset),
+          preset));
+      chip->SetCustomPadding(gfx::Insets::VH(2, 7));
+    }
+
+    // Button row
+    auto* button_row = AddChildView(std::make_unique<views::View>());
+    auto* row_layout = button_row->SetLayoutManager(
+        std::make_unique<views::BoxLayout>(
+            views::BoxLayout::Orientation::kHorizontal,
+            gfx::Insets::TLBR(6, 0, 0, 0), 8));
+    row_layout->set_main_axis_alignment(views::BoxLayout::MainAxisAlignment::kEnd);
+
+    auto* reset_btn = button_row->AddChildView(std::make_unique<views::MdTextButton>(
+        base::BindRepeating(&VeloxRenameSpaceBubble::OnResetDefault,
+                            base::Unretained(this)),
+        u"Default"));
+    reset_btn->SetTooltipText(u"Reset this space back to default name");
+
+    button_row->AddChildView(std::make_unique<views::MdTextButton>(
+        base::BindRepeating(&VeloxRenameSpaceBubble::OnCancel,
+                            base::Unretained(this)),
+        u"Cancel"));
+
+    auto* save_btn = button_row->AddChildView(std::make_unique<views::MdTextButton>(
+        base::BindRepeating(&VeloxRenameSpaceBubble::OnSave,
+                            base::Unretained(this)),
+        u"Save Space"));
+    save_btn->SetStyle(ui::ButtonStyle::kProminent);
+  }
+
+  views::View* GetInitiallyFocusedView() override { return name_field_; }
+
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override {
+    if (key_event.type() == ui::EventType::kKeyPressed &&
+        key_event.key_code() == ui::VKEY_RETURN) {
+      OnSave();
+      return true;
+    }
+    return false;
+  }
+
+ private:
+  void OnPresetClicked(const std::u16string& preset) {
+    if (name_field_) {
+      name_field_->SetText(preset);
+      name_field_->SelectAll(false);
+    }
+  }
+
+  void OnResetDefault() {
+    const std::u16string kDefaults[3] = {u"General", u"Work", u"Focus"};
+    if (name_field_) {
+      name_field_->SetText(kDefaults[space_index_]);
+    }
+    OnSave();
+  }
+
+  void OnCancel() {
+    if (GetWidget()) {
+      GetWidget()->Close();
+    }
+  }
+
+  void OnSave() {
+    std::u16string text = name_field_ ? name_field_->GetText() : u"";
+    base::TrimWhitespace(text, base::TRIM_ALL, &text);
+    if (text.empty()) {
+      const std::u16string kDefaults[3] = {u"General", u"Work", u"Focus"};
+      text = kDefaults[space_index_];
+    }
+    if (text.length() > 14) {
+      text = text.substr(0, 14);
+    }
+    velox::SetSpaceName(space_index_, text,
+                        browser_ ? browser_->profile() : nullptr);
+    if (GetWidget()) {
+      GetWidget()->Close();
+    }
+  }
+
+  raw_ptr<Browser> browser_ = nullptr;
+  int space_index_ = 0;
+  raw_ptr<views::Textfield> name_field_ = nullptr;
+};
