+// Velox Spaces (Workspaces) Infrastructure
+// ============================================================================
+
+class VeloxSpacesControl;
+
+struct TabSpacePersistedEntry {
+  int index = -1;
+  std::string url;
+  int ws = 0;
+};
+
+struct VeloxRuntimeState {
+  std::map<const Tab*, int> tab_workspaces;
+  std::map<const Tab*, TabStrip*> tab_to_tabstrip;
+  std::map<const TabStrip*, int> tabstrip_active_workspace;
+  std::map<const TabStrip*, TabContainer*> tabstrip_containers;
+  std::map<const TabStrip*, int> last_removed_workspace;
+  std::map<std::pair<const TabStrip*, int>, const Tab*> last_active_tab;
+  std::map<std::pair<const TabStrip*, int>, std::vector<const Tab*>> workspace_active_stack;
+  bool switching_workspace = false;
+
+  // Persistence of tab -> space assignments across browser restarts.
+  // Pending entries loaded from disk, consumed as restored tabs are added.
+  std::vector<TabSpacePersistedEntry> pending_restore;
+  bool tab_spaces_loaded = false;
+  base::TimeTicks restore_deadline;
+  base::FilePath tab_spaces_file;
+
+  std::set<VeloxSpacesControl*> spaces_controls;
+  std::u16string space_names[3] = {u"General", u"Work", u"Focus"};
+  bool space_names_loaded = false;
+  raw_ptr<views::Widget> active_rename_bubble_widget = nullptr;
+};
+
+VeloxRuntimeState& GetVeloxState() {
+  static base::NoDestructor<VeloxRuntimeState> state;
+  return *state;
+}
+
+void NotifyVeloxSpacesControls();
+
+namespace velox {
+
+const std::u16string& GetSpaceName(int index) {
+  auto& st = GetVeloxState();
+  if (index >= 0 && index < 3) {
+    return st.space_names[index];
+  }
+  static const base::NoDestructor<std::u16string> kEmpty(u"");
+  return *kEmpty;
+}
+
+void LoadSpaceNames(Profile* profile) {
+  auto& st = GetVeloxState();
+  if (st.space_names_loaded || !profile) {
+    return;
+  }
+  base::FilePath json_file =
+      profile->GetPath().Append(FILE_PATH_LITERAL("velox_spaces.json"));
+  std::string content;
+  if (base::ReadFileToString(json_file, &content)) {
+    auto parsed = base::JSONReader::Read(content);
+    if (parsed && parsed->is_list()) {
+      const auto& list = parsed->GetList();
+      for (size_t i = 0; i < 3 && i < list.size(); ++i) {
+        if (list[i].is_string()) {
+          std::string str = list[i].GetString();
+          if (!str.empty()) {
+            st.space_names[i] = base::UTF8ToUTF16(str);
+          }
+        }
+      }
+    }
+  }
+  st.space_names_loaded = true;
+}
+
+void SaveSpaceNames(Profile* profile) {
+  if (!profile) {
+    return;
+  }
+  auto& st = GetVeloxState();
+  base::Value::List list;
+  for (int i = 0; i < 3; ++i) {
+    list.Append(base::UTF16ToUTF8(st.space_names[i]));
+  }
+  std::string json_str;
+  if (base::JSONWriter::Write(list, &json_str)) {
+    base::FilePath json_file =
+        profile->GetPath().Append(FILE_PATH_LITERAL("velox_spaces.json"));
+    base::WriteFile(json_file, json_str);
+  }
+}
+
+void SetSpaceName(int index, const std::u16string& new_name, Profile* profile) {
+  if (index < 0 || index >= 3) {
+    return;
+  }
+  auto& st = GetVeloxState();
+  st.space_names[index] = new_name;
+  SaveSpaceNames(profile);
+  NotifyVeloxSpacesControls();
+}
+
+void RegisterTabContainer(TabStrip* tab_strip, TabContainer* container) {
+  auto& st = GetVeloxState();
+  st.tabstrip_containers[tab_strip] = container;
+  if (st.tabstrip_active_workspace.find(tab_strip) ==
+      st.tabstrip_active_workspace.end()) {
+    st.tabstrip_active_workspace[tab_strip] = 0;
+  }
+}
+
+void RecordActiveTabInWorkspace(const TabStrip* tab_strip,
+                                int ws,
+                                const Tab* tab) {
+  if (!tab_strip || !tab) {
+    return;
+  }
+  auto& st = GetVeloxState();
+  auto& stack = st.workspace_active_stack[{tab_strip, ws}];
+  auto it = std::find(stack.begin(), stack.end(), tab);
+  if (it != stack.end()) {
+    stack.erase(it);
+  }
+  stack.insert(stack.begin(), tab);
+}
+
+void RemoveTabFromWorkspaceStack(const TabStrip* tab_strip,
+                                 int ws,
+                                 const Tab* tab) {
+  if (!tab_strip || !tab) {
+    return;
+  }
+  auto& st = GetVeloxState();
+  auto& stack = st.workspace_active_stack[{tab_strip, ws}];
+  auto it = std::find(stack.begin(), stack.end(), tab);
+  if (it != stack.end()) {
+    stack.erase(it);
+  }
+}
+
+void OnTabStripDestroyed(TabStrip* tab_strip) {
+  auto& st = GetVeloxState();
+  st.tabstrip_containers.erase(tab_strip);
+  st.tabstrip_active_workspace.erase(tab_strip);
+  st.last_removed_workspace.erase(tab_strip);
+  for (int w = 0; w < 3; ++w) {
+    auto key = std::make_pair(static_cast<const TabStrip*>(tab_strip), w);
+    st.workspace_active_stack.erase(key);
+    st.last_active_tab.erase(key);
+  }
+  for (auto it = st.tab_to_tabstrip.begin(); it != st.tab_to_tabstrip.end();) {
+    if (it->second == tab_strip) {
+      st.tab_workspaces.erase(it->first);
+      it = st.tab_to_tabstrip.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+int GetTabWorkspace(const Tab* tab) {
+  auto& st = GetVeloxState();
+  auto it = st.tab_workspaces.find(tab);
+  return it != st.tab_workspaces.end() ? it->second : 0;
+}
+
+int GetTabStripActiveWorkspace(const TabStrip* tab_strip) {
+  if (!tab_strip) {
+    return 0;
+  }
+  auto& st = GetVeloxState();
+  auto it = st.tabstrip_active_workspace.find(tab_strip);
+  return it != st.tabstrip_active_workspace.end() ? it->second : 0;
+}
+
+bool IsTabInActiveWorkspace(const Tab* tab) {
+  if (!tab || tab->dragging()) {
+    return true;
+  }
+  auto& st = GetVeloxState();
+  auto ts_it = st.tab_to_tabstrip.find(tab);
+  if (ts_it == st.tab_to_tabstrip.end() || !ts_it->second) {
+    return true;
+  }
+  return GetTabWorkspace(tab) == GetTabStripActiveWorkspace(ts_it->second);
+}
+
+void RegisterTabInWorkspace(TabStrip* tab_strip, const Tab* tab) {
+  if (!tab_strip || !tab) {
+    return;
+  }
+  auto& st = GetVeloxState();
+  int active_ws = GetTabStripActiveWorkspace(tab_strip);
+  st.tab_to_tabstrip[tab] = tab_strip;
+  st.tab_workspaces[tab] = active_ws;
+  RecordActiveTabInWorkspace(tab_strip, active_ws, tab);
+}
+
+// ---- Tab space persistence ------------------------------------------------
+
+namespace {
+
+Profile* ProfileForTabStrip(TabStrip* tab_strip) {
+  if (!tab_strip || !tab_strip->GetBrowserWindowInterface()) {
+    return nullptr;
+  }
+  return tab_strip->GetBrowserWindowInterface()->GetProfile();
+}
+
+bool IsTabStripClosingAll(TabStrip* tab_strip) {
+  if (!tab_strip || !tab_strip->GetBrowserWindowInterface()) {
+    return false;
+  }
+  TabStripModel* model =
+      tab_strip->GetBrowserWindowInterface()->GetTabStripModel();
+  return model && model->closing_all();
+}
+
+void EnsureTabSpacesLoaded(TabStrip* tab_strip) {
+  auto& st = GetVeloxState();
+  if (st.tab_spaces_loaded) {
+    return;
+  }
+  Profile* profile = ProfileForTabStrip(tab_strip);
+  if (!profile || profile->IsOffTheRecord()) {
+    return;
+  }
+  st.tab_spaces_loaded = true;
+  st.tab_spaces_file =
+      profile->GetPath().Append(FILE_PATH_LITERAL("velox_tab_spaces.json"));
+  st.restore_deadline = base::TimeTicks::Now() + base::Seconds(45);
+
+  std::string content;
+  if (!base::ReadFileToString(st.tab_spaces_file, &content)) {
+    return;
+  }
+  auto parsed = base::JSONReader::Read(content);
+  if (!parsed || !parsed->is_list()) {
+    return;
+  }
+  for (const auto& item : parsed->GetList()) {
+    if (!item.is_dict()) {
+      continue;
+    }
+    const base::Value::Dict& d = item.GetDict();
+    std::optional<int> ws = d.FindInt("ws");
+    if (!ws || *ws <= 0 || *ws >= 3) {
+      continue;
+    }
+    const std::string* url = d.FindString("url");
+    std::optional<int> idx = d.FindInt("index");
+    TabSpacePersistedEntry entry;
+    entry.index = idx.value_or(-1);
+    entry.url = url ? *url : std::string();
+    entry.ws = *ws;
+    st.pending_restore.push_back(std::move(entry));
+  }
+}
+
+void WriteTabSpacesFile(const std::vector<TabSpacePersistedEntry>& entries) {
+  auto& st = GetVeloxState();
+  if (st.tab_spaces_file.empty()) {
+    return;
+  }
+  base::Value::List list;
+  for (const auto& entry : entries) {
+    base::Value::Dict d;
+    d.Set("index", entry.index);
+    d.Set("url", entry.url);
+    d.Set("ws", entry.ws);
+    list.Append(std::move(d));
+  }
+  std::string json_str;
+  if (base::JSONWriter::Write(list, &json_str)) {
+    base::WriteFile(st.tab_spaces_file, json_str);
+  }
+}
+
+Tab* SafeGetTab(const TabStrip* tab_strip, int index) {
+  if (!tab_strip || index < 0 || index >= tab_strip->GetTabCount()) {
+    return nullptr;
+  }
+  return const_cast<TabStrip*>(tab_strip)->tab_at(index);
+}
+
+void AppendTabStripEntries(const TabStrip* tab_strip,
+                           std::vector<TabSpacePersistedEntry>* out) {
+  if (!tab_strip) {
+    return;
+  }
+  auto* bwi = const_cast<TabStrip*>(tab_strip)->GetBrowserWindowInterface();
+  TabStripModel* model = bwi ? bwi->GetTabStripModel() : nullptr;
+
+  const int count = tab_strip->GetTabCount();
+  for (int i = 0; i < count; ++i) {
+    const Tab* tab = SafeGetTab(tab_strip, i);
+    if (!tab || tab->closing()) {
+      continue;
+    }
+    const int ws = GetTabWorkspace(tab);
+    if (ws <= 0) {
+      continue;
+    }
+    std::string url_spec;
+    if (model && model->ContainsIndex(i)) {
+      if (auto* wc = model->GetWebContentsAt(i)) {
+        const GURL& u = wc->GetVisibleURL();
+        if (u.is_valid() && !u.is_empty()) {
+          url_spec = u.spec();
+        } else if (wc->GetLastCommittedURL().is_valid()) {
+          url_spec = wc->GetLastCommittedURL().spec();
+        }
+      }
+    }
+    if (url_spec.empty() && tab->data().visible_url.is_valid()) {
+      url_spec = tab->data().visible_url.spec();
+    }
+    out->push_back({i, url_spec, ws});
+  }
+}
+
 }  // namespace
 
+void SaveTabSpaces() {
+  auto& st = GetVeloxState();
+  if (st.tab_spaces_file.empty()) {
+    return;
+  }
+  if (browser_shutdown::IsTryingToQuit()) {
+    return;
+  }
+  for (const auto& [tab, ts] : st.tab_to_tabstrip) {
+    if (ts && IsTabStripClosingAll(ts)) {
+      return;
+    }
+  }
+
+  std::set<const TabStrip*> strips;
+  for (const auto& [tab, ts] : st.tab_to_tabstrip) {
+    if (ts) {
+      strips.insert(ts);
+    }
+  }
+  if (strips.empty()) {
+    return;
+  }
+
+  std::vector<TabSpacePersistedEntry> entries;
+  for (const TabStrip* ts : strips) {
+    AppendTabStripEntries(ts, &entries);
+  }
+  WriteTabSpacesFile(entries);
+}
+
+void RefreshTabStripLayoutForSpaces(TabStrip* tab_strip);
+
+void MaybeRestoreTabWorkspace(TabStrip* tab_strip,
+                              Tab* tab,
+                              int model_index,
+                              const GURL& url) {
+  if (!tab_strip || !tab) {
+    return;
+  }
+  EnsureTabSpacesLoaded(tab_strip);
+  auto& st = GetVeloxState();
+  if (st.pending_restore.empty()) {
+    return;
+  }
+  if (base::TimeTicks::Now() > st.restore_deadline) {
+    st.pending_restore.clear();
+    return;
+  }
+
+  const std::string url_spec = url.is_valid() ? url.spec() : std::string();
+
+  auto it = st.pending_restore.end();
+  // 1. Match by index and matching URL
+  for (auto iter = st.pending_restore.begin(); iter != st.pending_restore.end();
+       ++iter) {
+    if (iter->index == model_index) {
+      if (url_spec.empty() || iter->url.empty() || iter->url == url_spec) {
+        it = iter;
+        break;
+      }
+    }
+  }
+  // 2. Match by URL if non-empty
+  if (it == st.pending_restore.end() && !url_spec.empty()) {
+    for (auto iter = st.pending_restore.begin(); iter != st.pending_restore.end();
+         ++iter) {
+      if (iter->url == url_spec) {
+        it = iter;
+        break;
+      }
+    }
+  }
+  // 3. Fallback match by index alone
+  if (it == st.pending_restore.end()) {
+    for (auto iter = st.pending_restore.begin(); iter != st.pending_restore.end();
+         ++iter) {
+      if (iter->index == model_index) {
+        it = iter;
+        break;
+      }
+    }
+  }
+
+  if (it == st.pending_restore.end()) {
+    return;
+  }
+
+  int restored_ws = it->ws;
+  st.pending_restore.erase(it);
+
+  st.tab_workspaces[tab] = restored_ws;
+  RecordActiveTabInWorkspace(tab_strip, restored_ws, tab);
+}
+
+void OnTabDataChanged(TabStrip* tab_strip, const Tab* tab) {
+  if (!tab_strip || !tab) {
+    return;
+  }
+  if (GetTabWorkspace(tab) > 0) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&SaveTabSpaces));
+  }
+}
+
+void UnregisterTabFromWorkspace(TabStrip* tab_strip, const Tab* tab) {
+  if (!tab) {
+    return;
+  }
+  auto& st = GetVeloxState();
+  int ws = GetTabWorkspace(tab);
+  if (tab_strip) {
+    st.last_removed_workspace[tab_strip] = ws;
+    RemoveTabFromWorkspaceStack(tab_strip, ws, tab);
+    for (int w = 0; w < 3; ++w) {
+      auto key = std::make_pair(static_cast<const TabStrip*>(tab_strip), w);
+      if (st.last_active_tab[key] == tab) {
+        st.last_active_tab.erase(key);
+      }
+    }
+  }
+  st.tab_workspaces.erase(tab);
+  st.tab_to_tabstrip.erase(tab);
+
+  if (tab_strip && ws > 0 && !IsTabStripClosingAll(tab_strip) &&
+      !browser_shutdown::IsTryingToQuit()) {
+    SaveTabSpaces();
+  }
+}
+
+void RefreshTabStripLayoutForSpaces(TabStrip* tab_strip) {
+  if (!tab_strip) {
+    return;
+  }
+  tab_strip->InvalidateLayout();
+  tab_strip->SchedulePaint();
+}
+
+void SwitchWorkspace(Browser* browser, int workspace_id) {
+  if (!browser || workspace_id < 0 || workspace_id > 2) {
+    return;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view || !browser_view->tabstrip()) {
+    return;
+  }
+  TabStrip* tab_strip = browser_view->tabstrip();
+  auto& st = GetVeloxState();
+  if (GetTabStripActiveWorkspace(tab_strip) == workspace_id) {
+    return;
+  }
+
+  st.switching_workspace = true;
+  st.tabstrip_active_workspace[tab_strip] = workspace_id;
+
+  TabStripModel* model = browser->tab_strip_model();
+
+  int target_index = -1;
+  // 1. Check workspace active stack
+  auto& stack = st.workspace_active_stack[{tab_strip, workspace_id}];
+  for (auto it = stack.begin(); it != stack.end();) {
+    const Tab* cand = *it;
+    bool found = false;
+    if (cand && !cand->closing() && GetTabWorkspace(cand) == workspace_id) {
+      for (int i = 0; i < tab_strip->GetTabCount(); ++i) {
+        if (SafeGetTab(tab_strip, i) == cand) {
+          target_index = i;
+          found = true;
+          break;
+        }
+      }
+    }
+    if (found) {
+      break;
+    } else {
+      it = stack.erase(it);
+    }
+  }
+
+  // 2. Check last_active_tab
+  if (target_index == -1) {
+    const Tab* preferred_tab = st.last_active_tab[{tab_strip, workspace_id}];
+    if (preferred_tab && !preferred_tab->closing() &&
+        GetTabWorkspace(preferred_tab) == workspace_id) {
+      for (int i = 0; i < tab_strip->GetTabCount(); ++i) {
+        if (SafeGetTab(tab_strip, i) == preferred_tab) {
+          target_index = i;
+          break;
+        }
+      }
+    }
+  }
+
+  // 3. Fall back to MRU via GetLastActiveTimeTicks()
+  if (target_index == -1) {
+    int mru_index = -1;
+    base::TimeTicks mru_time;
+    for (int i = 0; i < tab_strip->GetTabCount(); ++i) {
+      Tab* t = SafeGetTab(tab_strip, i);
+      if (!t || t->closing() || GetTabWorkspace(t) != workspace_id) {
+        continue;
+      }
+      WebContents* wc =
+          (model && model->ContainsIndex(i)) ? model->GetWebContentsAt(i)
+                                             : nullptr;
+      const base::TimeTicks t_active =
+          wc ? wc->GetLastActiveTimeTicks() : base::TimeTicks();
+      if (mru_index == -1 || t_active > mru_time) {
+        mru_index = i;
+        mru_time = t_active;
+      }
+    }
+    target_index = mru_index;
+  }
+
+  if (model && model->IsSplitSelectionActive()) {
+    model->CancelSplitSelection();
+  }
+  if (target_index != -1 && model && model->ContainsIndex(target_index)) {
+    model->ActivateTabAt(target_index);
+  } else {
+    chrome::NewTab(browser);
+  }
+
+  // Freeze inactive workspace background tabs (if not playing audio) to save RAM
+  if (model) {
+    for (int i = 0; i < model->count() && i < tab_strip->GetTabCount(); ++i) {
+      WebContents* wc = model->GetWebContentsAt(i);
+      Tab* t = SafeGetTab(tab_strip, i);
+      if (!wc || !t) {
+        continue;
+      }
+      int w = GetTabWorkspace(t);
+      if (w != workspace_id) {
+        if (wc->GetVisibility() == content::Visibility::HIDDEN &&
+            !wc->IsCurrentlyAudible() && !wc->IsBeingCaptured()) {
+          wc->SetPageFrozen(true);
+        }
+      }
+    }
+  }
+
+  st.switching_workspace = false;
+  RefreshTabStripLayoutForSpaces(tab_strip);
+  NotifyVeloxSpacesControls();
+}
+
+void MoveActiveTabToWorkspace(Browser* browser, int workspace_id) {
+  if (!browser || workspace_id < 0 || workspace_id > 2) {
+    return;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view || !browser_view->tabstrip()) {
+    return;
+  }
+  TabStrip* tab_strip = browser_view->tabstrip();
+  TabStripModel* model = browser->tab_strip_model();
+  int active_idx = model->active_index();
+  if (active_idx >= 0 && active_idx < tab_strip->GetTabCount()) {
+    int partner_idx = model->GetSplitPartnerIndex(active_idx);
+    if (partner_idx != TabStripModel::kNoTab &&
+        partner_idx < tab_strip->GetTabCount()) {
+      if (Tab* partner_tab = SafeGetTab(tab_strip, partner_idx)) {
+        int old_partner_ws = GetTabWorkspace(partner_tab);
+        RemoveTabFromWorkspaceStack(tab_strip, old_partner_ws, partner_tab);
+        GetVeloxState().tab_workspaces[partner_tab] = workspace_id;
+        RecordActiveTabInWorkspace(tab_strip, workspace_id, partner_tab);
+      }
+    }
+    Tab* active_tab = SafeGetTab(tab_strip, active_idx);
+    if (active_tab) {
+      int old_ws = GetTabWorkspace(active_tab);
+      RemoveTabFromWorkspaceStack(tab_strip, old_ws, active_tab);
+      auto old_key =
+          std::make_pair(static_cast<const TabStrip*>(tab_strip), old_ws);
+      if (GetVeloxState().last_active_tab[old_key] == active_tab) {
+        GetVeloxState().last_active_tab.erase(old_key);
+      }
+      GetVeloxState().tab_workspaces[active_tab] = workspace_id;
+      RecordActiveTabInWorkspace(tab_strip, workspace_id, active_tab);
+      auto new_key =
+          std::make_pair(static_cast<const TabStrip*>(tab_strip), workspace_id);
+      GetVeloxState().last_active_tab[new_key] = active_tab;
+    }
+  }
+  SwitchWorkspace(browser, workspace_id);
+  EnsureTabSpacesLoaded(tab_strip);
+  SaveTabSpaces();
+}
+
+void OnTabStripActiveTabChanged(TabStrip* tab_strip, const Tab* new_active_tab) {
+  if (!tab_strip || !new_active_tab) {
+    return;
+  }
+  auto& st = GetVeloxState();
+  int new_ws = GetTabWorkspace(new_active_tab);
+  st.last_active_tab[{tab_strip, new_ws}] = new_active_tab;
+  RecordActiveTabInWorkspace(tab_strip, new_ws, new_active_tab);
+
+  if (st.switching_workspace) {
+    return;
+  }
+
+  int current_ws = GetTabStripActiveWorkspace(tab_strip);
+  int removed_ws = -1;
+  auto rem_it = st.last_removed_workspace.find(tab_strip);
+  if (rem_it != st.last_removed_workspace.end()) {
+    removed_ws = rem_it->second;
+    st.last_removed_workspace.erase(rem_it);
+  }
+
+  if (new_ws != current_ws) {
+    if (removed_ws == current_ws) {
+      // Check if there is still another tab in current_ws.
+      // Prefer the MRU active tab from that workspace's stack instead of index 0.
+      int remaining_in_current = -1;
+      auto& stack = st.workspace_active_stack[{tab_strip, current_ws}];
+      for (auto it = stack.begin(); it != stack.end();) {
+        const Tab* cand = *it;
+        bool found = false;
+        if (cand && !cand->closing() && GetTabWorkspace(cand) == current_ws) {
+          for (int i = 0; i < tab_strip->GetTabCount(); ++i) {
+            if (SafeGetTab(tab_strip, i) == cand) {
+              remaining_in_current = i;
+              found = true;
+              break;
+            }
+          }
+        }
+        if (found) {
+          break;
+        } else {
+          it = stack.erase(it);
+        }
+      }
+      if (remaining_in_current == -1) {
+        for (int i = tab_strip->GetTabCount() - 1; i >= 0; --i) {
+          Tab* t = SafeGetTab(tab_strip, i);
+          if (t && !t->closing() && GetTabWorkspace(t) == current_ws) {
+            remaining_in_current = i;
+            break;
+          }
+        }
+      }
+      if (remaining_in_current != -1 && tab_strip->GetBrowserWindowInterface()) {
+        TabStripModel* model =
+            tab_strip->GetBrowserWindowInterface()->GetTabStripModel();
+        const int target_idx = remaining_in_current;
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE,
+            base::BindOnce(
+                [](TabStrip* ts, TabStripModel* m, int target) {
+                  if (!ts || !m || !m->ContainsIndex(target)) {
+                    return;
+                  }
+                  m->ActivateTabAt(target);
+                  RefreshTabStripLayoutForSpaces(ts);
+                },
+                base::Unretained(tab_strip), base::Unretained(model),
+                target_idx));
+        return;
+      }
+    }
+
+    st.tabstrip_active_workspace[tab_strip] = new_ws;
+    NotifyVeloxSpacesControls();
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&RefreshTabStripLayoutForSpaces,
+                       base::Unretained(tab_strip)));
+  }
+}
