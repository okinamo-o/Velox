+// SplitPaneCard: Opera One-style floating island card enclosing a ContentsWebView.
+class SplitPaneCard : public views::View, public content::WebContentsObserver {
+  METADATA_HEADER(SplitPaneCard, views::View)
+
+ public:
+  SplitPaneCard(bool is_active, base::RepeatingClosure activate_callback)
+      : is_active_(is_active),
+        activate_callback_(std::move(activate_callback)) {
+    auto layout = std::make_unique<views::FlexLayout>();
+    layout->SetOrientation(views::LayoutOrientation::kVertical)
+        .SetCrossAxisAlignment(views::LayoutAlignment::kStretch);
+    SetLayoutManager(std::move(layout));
+  }
+
+  void SetWebContents(content::WebContents* web_contents) {
+    Observe(web_contents);
+  }
+
+  void SetIsActive(bool is_active) {
+    if (is_active_ != is_active) {
+      is_active_ = is_active;
+      SchedulePaint();
+    }
+  }
+  bool is_active() const { return is_active_; }
+
+  void SetIsSplit(bool is_split) {
+    if (is_split_ != is_split) {
+      is_split_ = is_split;
+      SchedulePaint();
+    }
+  }
+
+  void SetAccentColor(std::optional<SkColor> accent_color) {
+    if (accent_color_ != accent_color) {
+      accent_color_ = accent_color;
+      SchedulePaint();
+    }
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    if (!GetBorder()) {
+      views::View::OnPaint(canvas);
+      return;
+    }
+
+    gfx::ScopedCanvas scoped_canvas(canvas);
+    const float scale = canvas->UndoDeviceScaleFactor();
+    SkRect rect =
+        gfx::RectToSkRect(gfx::ScaleToEnclosingRect(GetLocalBounds(), scale));
+    rect.inset(1.0f * scale, 1.0f * scale);
+    if (rect.isEmpty()) {
+      return;
+    }
+
+    const float radius = 12.2f * scale;
+    SkRRect rrect;
+    rrect.setRectXY(rect, radius, radius);
+
+    cc::PaintFlags fill_flags;
+    fill_flags.setAntiAlias(true);
+    fill_flags.setStyle(cc::PaintFlags::kFill_Style);
+    fill_flags.setColor(SkColorSetRGB(12, 16, 27));
+    canvas->sk_canvas()->drawRRect(rrect, fill_flags);
+
+    const SkColor top_accent =
+        accent_color_.value_or(SkColorSetRGB(56, 189, 248));
+    const SkColor bottom_accent =
+        accent_color_.has_value()
+            ? color_utils::AlphaBlend(accent_color_.value(),
+                                      SkColorSetRGB(139, 92, 246), 0.55f)
+            : SkColorSetRGB(139, 92, 246);
+
+    SkPoint pts[2] = {SkPoint::Make(rect.left(), rect.top()),
+                      SkPoint::Make(rect.left(), rect.bottom())};
+
+    // 1. Soft outer neon aura around the active viewport card
+    if (!is_split_ || is_active_) {
+      cc::PaintFlags halo_flags;
+      halo_flags.setAntiAlias(true);
+      halo_flags.setStyle(cc::PaintFlags::kStroke_Style);
+      halo_flags.setStrokeWidth(3.0f * scale);
+      SkColor4f halo_colors[2] = {
+          SkColor4f::FromColor(SkColorSetA(top_accent, 48)),
+          SkColor4f::FromColor(SkColorSetA(bottom_accent, 28))};
+      halo_flags.setShader(cc::PaintShader::MakeLinearGradient(
+          pts, halo_colors, nullptr, 2, SkTileMode::kClamp));
+      canvas->sk_canvas()->drawRRect(rrect, halo_flags);
+    }
+
+    // 2. Crisp glowing border around the rounded web page viewport
+    cc::PaintFlags border_flags;
+    border_flags.setAntiAlias(true);
+    border_flags.setStyle(cc::PaintFlags::kStroke_Style);
+    border_flags.setStrokeWidth((!is_split_ || is_active_ ? 1.6f : 1.2f) *
+                                scale);
+
+    if (!is_split_ || is_active_) {
+      SkColor4f colors[2] = {
+          SkColor4f::FromColor(SkColorSetA(top_accent, 205)),
+          SkColor4f::FromColor(SkColorSetA(bottom_accent, 130))};
+      border_flags.setShader(cc::PaintShader::MakeLinearGradient(
+          pts, colors, nullptr, 2, SkTileMode::kClamp));
+    } else {
+      SkColor4f colors[2] = {
+          SkColor4f::FromColor(SkColorSetARGB(115, 148, 163, 184)),
+          SkColor4f::FromColor(SkColorSetARGB(70, 100, 116, 139))};
+      border_flags.setShader(cc::PaintShader::MakeLinearGradient(
+          pts, colors, nullptr, 2, SkTileMode::kClamp));
+    }
+
+    canvas->sk_canvas()->drawRRect(rrect, border_flags);
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (!is_active_ && activate_callback_) {
+      activate_callback_.Run();
+    }
+    return views::View::OnMousePressed(event);
+  }
+
+  void OnWebContentsFocused(
+      content::RenderWidgetHost* render_widget_host) override {
+    if (!is_active_ && activate_callback_) {
+      activate_callback_.Run();
+    }
+  }
+
+  void WebContentsDestroyed() override {
+    if (destroyed_callback_) {
+      destroyed_callback_.Run();
+    }
+  }
+
+  void SetDestroyedCallback(base::RepeatingClosure callback) {
+    destroyed_callback_ = std::move(callback);
+  }
+
+ private:
+  bool is_active_ = false;
+  bool is_split_ = false;
+  std::optional<SkColor> accent_color_;
+  base::RepeatingClosure activate_callback_;
+  base::RepeatingClosure destroyed_callback_;
+};
