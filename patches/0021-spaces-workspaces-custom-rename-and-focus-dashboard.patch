+              'velox_scratchpad_notes', this.scratchpadText_);
+        } catch (_e) {}
+      }
+    }
+  }
+
+  protected onEvaluateMath_() {
+    const lines = this.scratchpadText_.split('\n');
+    let changed = false;
+    const updated = lines.map(line => {
+      const trimmed = line.trim();
+      const expr = trimmed.endsWith('=') ? trimmed.slice(0, -1).trim() : trimmed;
+      if (!expr || !/^[0-9+\-*/().%\s]+$/.test(expr)) {
+        return line;
+      }
+      const val = this.safeEvalMath_(expr);
+      if (val !== null && !trimmed.includes(`= ${val}`)) {
+        changed = true;
+        return trimmed.endsWith('=') ? `${line} ${val}` : `${line} = ${val}`;
+      }
+      return line;
+    });
+    if (changed) {
+      this.scratchpadText_ = updated.join('\n');
+      this.scratchpadCharCount_ = this.scratchpadText_.length;
+      this.scratchpadStatus_ = '⚡ Math evaluated';
+      try {
+        window.localStorage.setItem(
+            'velox_scratchpad_notes', this.scratchpadText_);
+      } catch (_e) {}
+    }
+  }
+
+  private safeEvalMath_(expr: string): string|null {
+    if (!/^[0-9+\-*/().%\s]+$/.test(expr)) {
+      return null;
+    }
+    const tokens = expr.match(/(\d+\.?\d*|\.\d+|[+\-*/()%])/g);
+    if (!tokens || tokens.length === 0) {
+      return null;
+    }
+    let pos = 0;
+    const parseExpr = (): number => {
+      let left = parseTerm();
+      while (pos < tokens.length &&
+             (tokens[pos] === '+' || tokens[pos] === '-')) {
+        const op = tokens[pos++]!;
+        const right = parseTerm();
+        left = op === '+' ? left + right : left - right;
+      }
+      return left;
+    };
+    const parseTerm = (): number => {
+      let left = parseFactor();
+      while (pos < tokens.length &&
+             (tokens[pos] === '*' || tokens[pos] === '/' ||
+              tokens[pos] === '%')) {
+        const op = tokens[pos++]!;
+        const right = parseFactor();
+        if (op === '*') {
+          left *= right;
+        } else if (op === '/') {
+          left = right !== 0 ? left / right : NaN;
+        } else {
+          left = right !== 0 ? left % right : NaN;
+        }
+      }
+      return left;
+    };
+    const parseFactor = (): number => {
+      if (pos >= tokens.length) {
+        return NaN;
+      }
+      const tok = tokens[pos++]!;
+      if (tok === '+') {
+        return parseFactor();
+      }
+      if (tok === '-') {
+        return -parseFactor();
+      }
+      if (tok === '(') {
+        const val = parseExpr();
+        if (tokens[pos] === ')') {
+          pos++;
+        }
+        return val;
+      }
+      return parseFloat(tok);
+    };
+    const res = parseExpr();
+    if (pos !== tokens.length || !Number.isFinite(res)) {
+      return null;
+    }
+    return Number.isInteger(res) ? String(res) : String(Number(res.toFixed(4)));
+  }
+
+  protected onCopyScratchpad_() {
+    if (!this.scratchpadText_) {
+      return;
+    }
+    navigator.clipboard.writeText(this.scratchpadText_).then(() => {
+      this.scratchpadStatus_ = '📋 Copied to clipboard!';
+    });
+  }
