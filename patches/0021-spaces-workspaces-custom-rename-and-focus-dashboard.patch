+class VeloxNtpTabGroupsHandler : public content::WebUIMessageHandler {
+ public:
+  VeloxNtpTabGroupsHandler() = default;
+  ~VeloxNtpTabGroupsHandler() override = default;
+
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "getVeloxTabGroups",
+        base::BindRepeating(&VeloxNtpTabGroupsHandler::HandleGetVeloxTabGroups,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "activateVeloxTabGroup",
+        base::BindRepeating(
+            &VeloxNtpTabGroupsHandler::HandleActivateVeloxTabGroup,
+            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "getVeloxMostUsedLinks",
+        base::BindRepeating(
+            &VeloxNtpTabGroupsHandler::HandleGetVeloxMostUsedLinks,
+            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "removeVeloxMostUsedLink",
+        base::BindRepeating(
+            &VeloxNtpTabGroupsHandler::HandleRemoveVeloxMostUsedLink,
+            base::Unretained(this)));
+  }
+
+  void HandleRemoveVeloxMostUsedLink(const base::Value::List& args) {
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    GURL url(args[0].GetString());
+    if (!url.is_valid()) {
+      return;
+    }
+    Profile* profile = Profile::FromWebUI(web_ui());
+    if (!profile) {
+      return;
+    }
+    scoped_refptr<history::TopSites> top_sites =
+        TopSitesFactory::GetForProfile(profile);
+    if (top_sites) {
+      top_sites->AddBlockedUrl(url);
+      top_sites->AddBlockedUrl(url.DeprecatedGetOriginAsURL());
+    }
+  }
+
+  void HandleGetVeloxMostUsedLinks(const base::Value::List& args) {
+    AllowJavascript();
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    std::string callback_id = args[0].GetString();
+    Profile* profile = Profile::FromWebUI(web_ui());
+    if (!profile) {
+      ResolveJavascriptCallback(base::Value(callback_id), base::Value::List());
+      return;
+    }
+    history::HistoryService* history_service =
+        HistoryServiceFactory::GetForProfile(
+            profile, ServiceAccessType::EXPLICIT_ACCESS);
+    if (history_service) {
+      history::QueryOptions options;
+      options.SetRecentDayRange(7);  // Query history for the last 7 days (this week)
+      options.max_count = 200;
+      options.duplicate_policy = history::QueryOptions::REMOVE_ALL_DUPLICATES;
+      history_service->QueryHistory(
+          std::u16string(), options,
+          base::BindOnce(&VeloxNtpTabGroupsHandler::OnWeeklyHistoryAvailable,
+                         weak_ptr_factory_.GetWeakPtr(), callback_id),
+          &cancelable_task_tracker_);
+      return;
+    }
+    OnWeeklyHistoryAvailable(callback_id, history::QueryResults());
+  }
+
+  void OnWeeklyHistoryAvailable(std::string callback_id,
+                                history::QueryResults results) {
+    if (!IsJavascriptAllowed()) {
+      return;
+    }
+    Profile* profile = Profile::FromWebUI(web_ui());
+    scoped_refptr<history::TopSites> top_sites =
+        profile ? TopSitesFactory::GetForProfile(profile) : nullptr;
+
+    auto normalize_host = [](std::string host) {
+      if (host.rfind("www.", 0) == 0 && host.size() > 4) {
+        return host.substr(4);
+      }
+      return host;
+    };
+
+    auto is_valid_url = [&](const GURL& u) {
+      if (!u.is_valid() || !u.SchemeIsHTTPOrHTTPS() || u.host().empty()) {
+        return false;
+      }
+      if (top_sites && (top_sites->IsBlocked(u) ||
+                        top_sites->IsBlocked(u.DeprecatedGetOriginAsURL()))) {
+        return false;
+      }
+      return true;
+    };
+
+    struct WeeklySiteInfo {
+      GURL url;
+      std::string title;
+      int visit_count = 0;
+      base::Time latest_visit;
+    };
+
+    std::map<std::string, WeeklySiteInfo> site_map;
+    std::vector<std::string> host_order;
+
+    for (const auto& item : results) {
+      if (!is_valid_url(item.url())) {
+        continue;
+      }
+      std::string norm_host = normalize_host(item.url().host());
+      int count = std::max(1, item.visit_count());
+      auto it = site_map.find(norm_host);
+      if (it == site_map.end()) {
+        std::string title = base::UTF16ToUTF8(item.title());
+        if (title.empty()) {
+          title = norm_host;
+        }
+        site_map[norm_host] = {item.url(), title, count, item.last_visit()};
+        host_order.push_back(norm_host);
+      } else {
+        it->second.visit_count += count;
+        if (item.last_visit() > it->second.latest_visit) {
+          it->second.latest_visit = item.last_visit();
+          it->second.url = item.url();
+        }
+      }
+    }
+
+    // Sort by visit_count descending, then latest_visit descending
+    std::stable_sort(
+        host_order.begin(), host_order.end(),
+        [&](const std::string& a, const std::string& b) {
+          if (site_map[a].visit_count != site_map[b].visit_count) {
+            return site_map[a].visit_count > site_map[b].visit_count;
+          }
+          return site_map[a].latest_visit > site_map[b].latest_visit;
+        });
+
+    base::Value::List links_list;
+    std::set<std::string> seen_hosts;
+
+    for (const std::string& h : host_order) {
+      if (links_list.size() >= 7) {
+        break;
+      }
+      seen_hosts.insert(h);
+      base::Value::Dict dict;
+      dict.Set("title", site_map[h].title);
+      dict.Set("url", site_map[h].url.spec());
+      links_list.Append(std::move(dict));
+    }
+
+    // Supplement from currently open tabs if fewer than 7 links are in weekly history.
+    if (links_list.size() < 7 && web_ui() && web_ui()->GetWebContents()) {
+      Browser* browser = chrome::FindBrowserWithTab(web_ui()->GetWebContents());
+      if (browser && browser->tab_strip_model()) {
+        TabStripModel* model = browser->tab_strip_model();
+        struct OpenSiteInfo {
+          GURL url;
+          std::string title;
+          int count = 0;
+        };
+        std::map<std::string, OpenSiteInfo> open_sites;
+        std::vector<std::string> host_order_tabs;
+        for (int i = 0; i < model->count(); ++i) {
+          content::WebContents* tc = model->GetWebContentsAt(i);
+          if (!tc) {
+            continue;
+          }
+          GURL u = tc->GetVisibleURL();
+          if (!is_valid_url(u)) {
+            continue;
+          }
+          std::string norm_host = normalize_host(u.host());
+          if (seen_hosts.count(norm_host)) {
+            continue;
+          }
+          auto it = open_sites.find(norm_host);
+          if (it == open_sites.end()) {
+            std::string t = base::UTF16ToUTF8(tc->GetTitle());
+            if (t.empty()) {
+              t = norm_host;
+            }
+            open_sites[norm_host] = {u, t, 1};
+            host_order_tabs.push_back(norm_host);
+          } else {
+            it->second.count++;
+          }
+        }
+        std::stable_sort(host_order_tabs.begin(), host_order_tabs.end(),
+                         [&](const std::string& a, const std::string& b) {
+                           return open_sites[a].count > open_sites[b].count;
+                         });
+        for (const std::string& h : host_order_tabs) {
+          if (links_list.size() >= 7) {
+            break;
+          }
+          seen_hosts.insert(h);
+          base::Value::Dict dict;
+          dict.Set("title", open_sites[h].title);
+          dict.Set("url", open_sites[h].url.spec());
+          links_list.Append(std::move(dict));
+        }
+      }
+    }
+
+    ResolveJavascriptCallback(base::Value(callback_id), links_list);
+  }
+
+  void HandleGetVeloxTabGroups(const base::Value::List& args) {
+    AllowJavascript();
+    if (args.empty()) {
+      return;
+    }
+    const base::Value& callback_id = args[0];
+
+    base::Value::List group_list;
+    Browser* browser = chrome::FindBrowserWithTab(web_ui()->GetWebContents());
+    if (browser && browser->tab_strip_model()) {
+      TabStripModel* model = browser->tab_strip_model();
+      if (model->SupportsTabGroups() && model->group_model()) {
+        TabGroupModel* group_model = model->group_model();
+        for (const tab_groups::TabGroupId& group_id :
+             group_model->ListTabGroups()) {
+          TabGroup* group = group_model->GetTabGroup(group_id);
+          if (!group) {
+            continue;
+          }
+
+          base::Value::Dict dict;
+          dict.Set("id", group_id.ToString());
+          std::u16string title = group->visual_data()->title();
+          if (title.empty()) {
+            title = group->GetContentString();
+          }
+          dict.Set("title", base::UTF16ToUTF8(title));
+          dict.Set("color", static_cast<int>(group->visual_data()->color()));
+          dict.Set("tabCount", group->tab_count());
+          dict.Set("isCollapsed", group->visual_data()->is_collapsed());
+
+          std::optional<int> first_tab = group->GetFirstTab();
+          if (first_tab.has_value()) {
+            content::WebContents* tab_contents =
+                model->GetWebContentsAt(first_tab.value());
+            if (tab_contents) {
+              dict.Set("firstTabUrl", tab_contents->GetVisibleURL().spec());
+              dict.Set("firstTabTitle",
+                       base::UTF16ToUTF8(tab_contents->GetTitle()));
+            }
+          }
+
+          base::Value::List tab_previews;
+          gfx::Range tab_range = group->ListTabs();
+          if (!tab_range.is_empty()) {
+            for (uint32_t i = tab_range.start();
+                 i < tab_range.end() && tab_previews.size() < 4; ++i) {
+              if (static_cast<int>(i) < model->count()) {
+                content::WebContents* tc = model->GetWebContentsAt(i);
+                if (tc) {
+                  base::Value::Dict tab_dict;
+                  std::u16string t_title = tc->GetTitle();
+                  if (t_title.empty()) {
+                    t_title = base::UTF8ToUTF16(tc->GetVisibleURL().host());
+                  }
+                  tab_dict.Set("title", base::UTF16ToUTF8(t_title));
+                  tab_dict.Set("url", tc->GetVisibleURL().spec());
+                  tab_previews.Append(std::move(tab_dict));
+                }
+              }
+            }
+          }
+          dict.Set("tabs", std::move(tab_previews));
+          group_list.Append(std::move(dict));
+        }
+      }
+    }
+    ResolveJavascriptCallback(callback_id, group_list);
+  }
+
+  void HandleActivateVeloxTabGroup(const base::Value::List& args) {
+    if (args.empty()) {
+      return;
+    }
+    std::string group_id_str;
+    if (args[0].is_string()) {
+      group_id_str = args[0].GetString();
+    }
+    Browser* browser = chrome::FindBrowserWithTab(web_ui()->GetWebContents());
+    if (browser && browser->tab_strip_model()) {
+      TabStripModel* model = browser->tab_strip_model();
+      if (model->SupportsTabGroups() && model->group_model()) {
+        TabGroupModel* group_model = model->group_model();
+        for (const tab_groups::TabGroupId& group_id :
+             group_model->ListTabGroups()) {
+          if (group_id.ToString() == group_id_str) {
+            TabGroup* group = group_model->GetTabGroup(group_id);
+            if (group) {
+              std::optional<int> first_tab = group->GetFirstTab();
+              if (first_tab.has_value()) {
+                if (group->visual_data()->is_collapsed()) {
+                  group->SetVisualData(
+                      tab_groups::TabGroupVisualData(
+                          group->visual_data()->title(),
+                          group->visual_data()->color(),
+                          /*is_collapsed=*/false),
+                      true);
+                }
+                model->ActivateTabAt(first_tab.value());
+                browser->window()->Activate();
+              }
+            }
+            break;
+          }
+        }
+      }
+    }
+  }
+
+ private:
+  base::CancelableTaskTracker cancelable_task_tracker_;
+  base::WeakPtrFactory<VeloxNtpTabGroupsHandler> weak_ptr_factory_{this};
+};
