+
+  protected onAddTask_() {
+    const text = this.newTaskText_.trim();
+    if (!text) {
+      return;
+    }
+    this.focusTasks_ = [...this.focusTasks_, {text, done: false}];
+    this.newTaskText_ = '';
+    this.saveFocusTasks_();
+  }
+
+  protected onToggleTask_(e: Event) {
+    const idxStr = (e.currentTarget as HTMLElement).dataset['index'];
+    if (idxStr === undefined) {
+      return;
+    }
+    const idx = parseInt(idxStr, 10);
+    if (idx >= 0 && idx < this.focusTasks_.length) {
+      this.focusTasks_ = this.focusTasks_.map(
+          (t, i) => (i === idx ? {text: t.text, done: !t.done} : t));
+      this.saveFocusTasks_();
+    }
+  }
+
+  protected onDeleteTask_(e: Event) {
+    const idxStr = (e.currentTarget as HTMLElement).dataset['index'];
+    if (idxStr === undefined) {
+      return;
+    }
+    const idx = parseInt(idxStr, 10);
+    if (idx >= 0 && idx < this.focusTasks_.length) {
+      this.focusTasks_ = this.focusTasks_.filter((_, i) => i !== idx);
+      this.saveFocusTasks_();
+    }
+  }
+
+  private saveFocusTasks_() {
+    try {
+      window.localStorage.setItem(
+          'velox_focus_tasks', JSON.stringify(this.focusTasks_));
+    } catch (_e) {}
+  }
