+/* Velox dashboard layout: centered search, full-width shortcuts, balanced work area. */
+:host {
+  height: 100vh;
+  max-height: none;
+  overflow-x: hidden !important;
+  overflow-y: auto !important;
+  --ntp-search-box-width: min(100%, 760px);
+  --ntp-module-layout-width: 100%;
+  --ntp-module-width: 100%;
+}
+
+#content {
+  height: auto;
+  max-height: none;
+  min-height: 100vh;
+  overflow: visible !important;
+}
+
+#veloxLayoutContainer {
+  align-content: start !important;
+  align-items: start !important;
+  box-sizing: border-box !important;
+  display: grid !important;
+  grid-template-areas:
+      "hero time"
+      "search time"
+      "shortcuts shortcuts"
+      "spaces spaces"
+      "focus recent"
+      "focus mostused"
+      "footer footer";
+  grid-template-columns: minmax(0, 1.8fr) minmax(280px, 0.85fr) !important;
+  gap: 16px 24px !important;
+  height: auto !important;
+  margin: 0 auto !important;
+  max-height: none !important;
+  max-width: 1480px !important;
+  min-height: 100vh;
+  overflow: visible !important;
+  padding: 40px clamp(24px, 4vw, 56px) 96px !important;
+  width: 100% !important;
+}
+
+#veloxMainColumn,
+#veloxSidebarColumn {
+  display: contents !important;
+}
+
+#veloxHero {
+  grid-area: hero;
+  align-self: center;
+  margin: 0;
+}
+
+.velox-hero-greeting {
+  color: #a8b5c9;
+  font-size: 14px;
+  margin-bottom: 5px;
+}
+
+.velox-hero-headline {
+  font-size: clamp(32px, 3.2vw, 42px);
+  letter-spacing: -1.2px;
+}
+
+.velox-hero-motto {
+  font-size: 10px;
+  letter-spacing: 1.8px;
+  margin-top: 8px;
+}
+
+.velox-time-widget {
+  align-self: center;
+  grid-area: time;
+  justify-self: end;
+  max-width: 360px;
+}
+
+.velox-clock-text {
+  font-size: clamp(28px, 3vw, 38px);
+  margin: 3px 0 6px;
+}
+
+.velox-time-widget .velox-quote-divider {
+  margin: 10px 0 9px;
+}
+
+#searchboxContainer {
+  grid-area: search;
+  justify-self: start !important;
+  margin: 6px 0 8px 0 !important;
+  max-width: 100%;
+  width: fit-content;
+}
+
+#mostVisited {
+  align-self: start;
+  grid-area: shortcuts;
+  justify-self: center;
+  margin: 0;
+  max-width: 100%;
+  overflow: visible;
+  width: 100%;
+}
+
+#veloxQuickAccess {
+  grid-area: spaces;
+  margin: 0;
+  max-width: none;
+  padding: 14px 16px 16px;
+  width: 100%;
+}
+
+.velox-qa-header {
+  margin-bottom: 12px;
+}
+
+.velox-qa-title {
+  font-size: 14px;
+}
+
+.velox-qa-grid {
+  gap: 10px;
+  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
+}
+
+.velox-space-card {
+  min-height: 54px;
+}
+
+.velox-space-name {
+  font-size: 13px;
+}
+
+.velox-space-desc {
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+#veloxFocusDashboard {
+  align-self: start;
+  grid-area: focus;
+  margin: 0;
+  max-width: none;
+  min-height: 280px;
+  padding: 16px 20px !important;
+  width: 100%;
+}
+
+.velox-focus-title-group {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+
+.velox-focus-subtitle {
+  font-size: 11px;
+  color: #64748b;
+  font-weight: normal;
+}
+
+.velox-stats-bar {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+
+.velox-stat-pill {
+  min-width: 0;
+}
+
+.velox-recent-widget {
+  align-self: start;
+  grid-area: recent;
+  margin: 0;
+  padding: 10px 12px !important;
+}
+
+.velox-recent-widget .velox-widget-header {
+  font-size: 11.5px;
+  margin-bottom: 6px;
+}
+
+.velox-mostused-widget {
+  align-self: start;
+  grid-area: mostused;
+  margin: 0;
+  padding: 10px 12px !important;
+}
+
+.velox-mostused-widget .velox-widget-header {
+  font-size: 11.5px;
+  margin-bottom: 6px;
+}
+
+.velox-mostused-widget .velox-widget-list {
+  display: flex;
+  flex-direction: column;
+  gap: 5px;
+}
+
+.velox-mostused-widget .velox-widget-item {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 5px 4px 5px 8px;
+  min-height: 32px;
+  border-radius: 7px;
+  background: rgba(18, 28, 52, 0.38);
+  border: 1px solid rgba(255, 255, 255, 0.04);
+  transition: all 0.15s ease;
+}
+
+.velox-mostused-widget .velox-widget-item:hover {
+  background: rgba(30, 41, 75, 0.55);
+  border-color: rgba(56, 189, 248, 0.3);
+}
+
+.velox-item-favicon {
+  width: 16px;
+  height: 16px;
+  border-radius: 3px;
+  flex-shrink: 0;
+}
+
+.velox-history-link {
+  align-items: center;
+  background: rgba(18, 28, 52, 0.45);
+  border: 1px solid rgba(255, 255, 255, 0.05);
+  border-radius: 9px;
+  color: inherit;
+  display: flex;
+  gap: 10px;
+  min-height: 38px;
+  padding: 6px 10px;
+  text-decoration: none;
+  transition: all 0.15s ease;
+}
+
+.velox-history-link:hover {
+  background: rgba(30, 41, 75, 0.6);
+  border-color: rgba(56, 189, 248, 0.4);
+}
+
+.velox-history-icon {
+  align-items: center;
+  background: rgba(56, 189, 248, 0.14);
+  border-radius: 7px;
+  color: #7dd3fc;
+  display: flex;
+  flex: 0 0 24px;
+  font-size: 13px;
+  height: 24px;
+  justify-content: center;
+}
+
+.velox-history-arrow {
+  color: #7dd3fc;
+  font-size: 13px;
+  margin-left: auto;
+}
+
+.velox-pinned-link {
+  align-items: center;
+  color: inherit;
+  display: flex;
+  flex: 1;
+  gap: 8px;
+  min-width: 0;
+  text-decoration: none;
+}
+
+.velox-qa-badge {
+  font-size: 10.5px;
+  padding: 2px 7px;
+  border-radius: 10px;
+  background: rgba(56, 189, 248, 0.15);
+  color: #38bdf8;
+  font-weight: 600;
+}
+
+.velox-group-dot {
+  width: 9px;
+  height: 9px;
+  border-radius: 50%;
+  display: inline-block;
+}
+
+.velox-group-arrow {
+  margin-left: auto;
+  color: #64748b;
+  font-size: 12px;
+  transition: transform 0.15s ease, color 0.15s ease;
+}
+
+.velox-space-card:hover .velox-group-arrow {
+  transform: translateX(2px);
+  color: #38bdf8;
+}
+
+.velox-qa-empty {
+  grid-column: 1 / -1;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 14px 18px;
+  border-radius: 10px;
+  background: rgba(18, 28, 52, 0.35);
+  border: 1px dashed rgba(56, 189, 248, 0.25);
+  color: #94a3b8;
+  font-size: 12px;
+}
+
+.velox-qa-empty-icon {
+  font-size: 20px;
+  color: #38bdf8;
+}
+
+.velox-qa-empty-text b {
+  color: #f1f5f9;
+}
+
+.velox-empty-state {
+  color: #94a3b8;
+  font-size: 12px;
+  line-height: 1.5;
+  padding: 10px 4px;
+}
+
+.velox-footer-brand {
+  grid-area: footer;
+  margin-top: 2px;
+}
+
+#customizeButtons {
+  z-index: 20;
+}
+
+@media (max-width: 900px) {
+  #veloxLayoutContainer {
+    grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.9fr) !important;
+    gap: 14px 18px !important;
+    padding-top: 28px !important;
+  }
+
+  .velox-qa-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 680px) {
+  #veloxLayoutContainer {
+    grid-template-areas:
+        "hero"
+        "time"
+        "search"
+        "shortcuts"
+        "spaces"
+        "focus"
+        "recent"
+        "mostused"
+        "footer";
+    grid-template-columns: minmax(0, 1fr) !important;
+    padding: 24px 16px 88px !important;
+  }
+
+  .velox-time-widget {
+    justify-self: stretch;
+    max-width: none;
+  }
+
+  .velox-time-widget .velox-quote-divider,
+  .velox-time-widget .velox-quote-text,
+  .velox-time-widget .velox-quote-author {
+    display: none;
+  }
+
+  .velox-time-widget {
+    align-items: baseline;
+    column-gap: 10px;
+    display: flex;
+    flex-wrap: wrap;
+  }
+
+  .velox-date-label {
+    flex-basis: 100%;
+  }
+
+  .velox-clock-text {
+    margin: 0;
+  }
+
+  .velox-qa-grid {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .velox-stats-bar {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
