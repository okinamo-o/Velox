+      const lines = target.value.split('\n');
+      let changed = false;
+      const updated = lines.map(line => {
+        const trimmed = line.trim();
+        if (trimmed.endsWith('=') && trimmed.length > 1) {
+          const expr = trimmed.slice(0, -1).trim();
+          const val = this.safeEvalMath_(expr);
+          if (val !== null) {
+            changed = true;
+            return `${line} ${val}`;
+          }
+        }
+        return line;
+      });
+      if (changed) {
+        e.preventDefault();
+        this.scratchpadText_ = updated.join('\n') + '\n';
+        this.scratchpadCharCount_ = this.scratchpadText_.length;
+        target.value = this.scratchpadText_;
+        this.scratchpadStatus_ = '⚡ Calculated & saved';
+        try {
