+// ============================================================================
+// Velox Spaces (Workspaces) Infrastructure
+// ============================================================================
+
+class VeloxSpacesControl;
+
+struct VeloxRuntimeState {
+  std::map<const Tab*, int> tab_workspaces;
+  std::map<const Tab*, TabStrip*> tab_to_tabstrip;
+  std::map<const TabStrip*, int> tabstrip_active_workspace;
+  std::map<const TabStrip*, TabContainer*> tabstrip_containers;
+  std::map<const TabStrip*, int> last_removed_workspace;
+  std::map<std::pair<const TabStrip*, int>, const Tab*> last_active_tab;
+  bool switching_workspace = false;
+
+  std::set<VeloxSpacesControl*> spaces_controls;
+  std::u16string space_names[3] = {u"General", u"Work", u"Focus"};
+  bool space_names_loaded = false;
+  raw_ptr<views::Widget> active_rename_bubble_widget = nullptr;
+};
+
+VeloxRuntimeState& GetVeloxState() {
+  static base::NoDestructor<VeloxRuntimeState> state;
+  return *state;
+}
+
+void NotifyVeloxSpacesControls();
+
+namespace velox {
+
+const std::u16string& GetSpaceName(int index) {
+  auto& st = GetVeloxState();
+  if (index >= 0 && index < 3) {
+    return st.space_names[index];
+  }
+  static const base::NoDestructor<std::u16string> kEmpty(u"");
+  return *kEmpty;
+}
+
+void LoadSpaceNames(Profile* profile) {
+  auto& st = GetVeloxState();
+  if (st.space_names_loaded || !profile) {
+    return;
+  }
+  base::FilePath json_file =
+      profile->GetPath().Append(FILE_PATH_LITERAL("velox_spaces.json"));
+  std::string content;
+  if (base::ReadFileToString(json_file, &content)) {
+    auto parsed = base::JSONReader::Read(content);
+    if (parsed && parsed->is_list()) {
+      const auto& list = parsed->GetList();
+      for (size_t i = 0; i < 3 && i < list.size(); ++i) {
+        if (list[i].is_string()) {
+          std::string str = list[i].GetString();
+          if (!str.empty()) {
+            st.space_names[i] = base::UTF8ToUTF16(str);
+          }
+        }
+      }
+    }
+  }
+  st.space_names_loaded = true;
+}
+
+void SaveSpaceNames(Profile* profile) {
+  if (!profile) {
+    return;
+  }
+  auto& st = GetVeloxState();
+  base::Value::List list;
+  for (int i = 0; i < 3; ++i) {
+    list.Append(base::UTF16ToUTF8(st.space_names[i]));
+  }
+  std::string json_str;
+  if (base::JSONWriter::Write(list, &json_str)) {
+    base::FilePath json_file =
+        profile->GetPath().Append(FILE_PATH_LITERAL("velox_spaces.json"));
+    base::WriteFile(json_file, json_str);
+  }
+}
+
+void SetSpaceName(int index, const std::u16string& new_name, Profile* profile) {
+  if (index < 0 || index >= 3) {
+    return;
+  }
+  auto& st = GetVeloxState();
+  st.space_names[index] = new_name;
+  SaveSpaceNames(profile);
+  NotifyVeloxSpacesControls();
+}
+
+void RegisterTabContainer(TabStrip* tab_strip, TabContainer* container) {
+  auto& st = GetVeloxState();
+  st.tabstrip_containers[tab_strip] = container;
+  if (st.tabstrip_active_workspace.find(tab_strip) ==
+      st.tabstrip_active_workspace.end()) {
+    st.tabstrip_active_workspace[tab_strip] = 0;
+  }
+}
+
+void OnTabStripDestroyed(TabStrip* tab_strip) {
+  auto& st = GetVeloxState();
+  st.tabstrip_containers.erase(tab_strip);
+  st.tabstrip_active_workspace.erase(tab_strip);
+  st.last_removed_workspace.erase(tab_strip);
+  for (auto it = st.tab_to_tabstrip.begin(); it != st.tab_to_tabstrip.end();) {
+    if (it->second == tab_strip) {
+      st.tab_workspaces.erase(it->first);
+      it = st.tab_to_tabstrip.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  for (int w = 0; w < 3; ++w) {
+    st.last_active_tab.erase({tab_strip, w});
+  }
+}
+
+int GetTabWorkspace(const Tab* tab) {
+  auto& st = GetVeloxState();
+  auto it = st.tab_workspaces.find(tab);
+  return it != st.tab_workspaces.end() ? it->second : 0;
+}
+
+int GetTabStripActiveWorkspace(const TabStrip* tab_strip) {
+  if (!tab_strip) {
+    return 0;
+  }
+  auto& st = GetVeloxState();
+  auto it = st.tabstrip_active_workspace.find(tab_strip);
+  return it != st.tabstrip_active_workspace.end() ? it->second : 0;
+}
+
+bool IsTabInActiveWorkspace(const Tab* tab) {
+  if (!tab) {
+    return true;
+  }
+  auto& st = GetVeloxState();
+  auto ts_it = st.tab_to_tabstrip.find(tab);
+  if (ts_it == st.tab_to_tabstrip.end() || !ts_it->second) {
+    return true;
+  }
+  return GetTabWorkspace(tab) == GetTabStripActiveWorkspace(ts_it->second);
+}
+
+void RegisterTabInWorkspace(TabStrip* tab_strip, const Tab* tab) {
+  if (!tab_strip || !tab) {
+    return;
+  }
+  auto& st = GetVeloxState();
+  int active_ws = GetTabStripActiveWorkspace(tab_strip);
+  st.tab_to_tabstrip[tab] = tab_strip;
+  st.tab_workspaces[tab] = active_ws;
+}
+
+void UnregisterTabFromWorkspace(TabStrip* tab_strip, const Tab* tab) {
+  if (!tab) {
+    return;
+  }
+  auto& st = GetVeloxState();
+  int ws = GetTabWorkspace(tab);
+  if (tab_strip) {
+    st.last_removed_workspace[tab_strip] = ws;
+    for (int w = 0; w < 3; ++w) {
+      auto key = std::make_pair(static_cast<const TabStrip*>(tab_strip), w);
+      if (st.last_active_tab[key] == tab) {
+        st.last_active_tab.erase(key);
+      }
+    }
+  }
+  st.tab_workspaces.erase(tab);
+  st.tab_to_tabstrip.erase(tab);
+}
+
+void RefreshTabStripLayoutForSpaces(TabStrip* tab_strip) {
+  if (!tab_strip) {
+    return;
+  }
+  auto& st = GetVeloxState();
+  auto it = st.tabstrip_containers.find(tab_strip);
+  if (it != st.tabstrip_containers.end() && it->second) {
+    it->second->CompleteAnimationAndLayout();
+  }
+  tab_strip->InvalidateLayout();
+  tab_strip->SchedulePaint();
+}
+
+void SwitchWorkspace(Browser* browser, int workspace_id) {
+  if (!browser || workspace_id < 0 || workspace_id > 2) {
+    return;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view || !browser_view->tabstrip()) {
+    return;
+  }
+  TabStrip* tab_strip = browser_view->tabstrip();
+  auto& st = GetVeloxState();
+  if (GetTabStripActiveWorkspace(tab_strip) == workspace_id) {
+    return;
+  }
+
+  st.switching_workspace = true;
+  st.tabstrip_active_workspace[tab_strip] = workspace_id;
+
+  int target_index = -1;
+  const Tab* preferred_tab = st.last_active_tab[{tab_strip, workspace_id}];
+  for (int i = 0; i < tab_strip->GetTabCount(); ++i) {
+    Tab* t = tab_strip->tab_at(i);
+    if (!t || t->closing()) {
+      continue;
+    }
+    if (GetTabWorkspace(t) == workspace_id) {
+      if (t == preferred_tab) {
+        target_index = i;
+        break;
+      }
+      if (target_index == -1) {
+        target_index = i;
+      }
+    }
+  }
+
+  TabStripModel* model = browser->tab_strip_model();
+  if (target_index != -1 && model && model->ContainsIndex(target_index)) {
+    model->ActivateTabAt(target_index);
+  } else {
+    chrome::NewTab(browser);
+  }
+
+  // Freeze inactive workspace background tabs (if not playing audio) to save RAM
+  if (model) {
+    for (int i = 0; i < model->count() && i < tab_strip->GetTabCount(); ++i) {
+      WebContents* wc = model->GetWebContentsAt(i);
+      Tab* t = tab_strip->tab_at(i);
+      if (!wc || !t) {
+        continue;
+      }
+      int w = GetTabWorkspace(t);
+      if (w != workspace_id) {
+        if (wc->GetVisibility() == content::Visibility::HIDDEN &&
+            !wc->IsCurrentlyAudible() && !wc->IsBeingCaptured()) {
+          wc->SetPageFrozen(true);
+        }
+      }
+    }
+  }
+
+  st.switching_workspace = false;
+  RefreshTabStripLayoutForSpaces(tab_strip);
+  NotifyVeloxSpacesControls();
+}
+
+void MoveActiveTabToWorkspace(Browser* browser, int workspace_id) {
+  if (!browser || workspace_id < 0 || workspace_id > 2) {
+    return;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view || !browser_view->tabstrip()) {
+    return;
+  }
+  TabStrip* tab_strip = browser_view->tabstrip();
+  int active_idx = browser->tab_strip_model()->active_index();
+  if (active_idx >= 0 && active_idx < tab_strip->GetTabCount()) {
+    Tab* active_tab = tab_strip->tab_at(active_idx);
+    if (active_tab) {
+      GetVeloxState().tab_workspaces[active_tab] = workspace_id;
+      GetVeloxState().last_active_tab[{tab_strip, workspace_id}] = active_tab;
+    }
+  }
+  SwitchWorkspace(browser, workspace_id);
+}
+
+void OnTabStripActiveTabChanged(TabStrip* tab_strip, const Tab* new_active_tab) {
+  if (!tab_strip || !new_active_tab) {
+    return;
+  }
+  auto& st = GetVeloxState();
+  int new_ws = GetTabWorkspace(new_active_tab);
+  st.last_active_tab[{tab_strip, new_ws}] = new_active_tab;
+
+  if (st.switching_workspace) {
+    return;
+  }
+
+  int current_ws = GetTabStripActiveWorkspace(tab_strip);
+  int removed_ws = -1;
+  auto rem_it = st.last_removed_workspace.find(tab_strip);
+  if (rem_it != st.last_removed_workspace.end()) {
+    removed_ws = rem_it->second;
+    st.last_removed_workspace.erase(rem_it);
+  }
+
+  if (new_ws != current_ws) {
+    if (removed_ws == current_ws) {
+      // Check if there is still another tab in current_ws
+      int remaining_in_current = -1;
+      for (int i = 0; i < tab_strip->GetTabCount(); ++i) {
+        Tab* t = tab_strip->tab_at(i);
+        if (t && !t->closing() && GetTabWorkspace(t) == current_ws) {
+          remaining_in_current = i;
+          break;
+        }
+      }
+      if (remaining_in_current != -1 && tab_strip->GetBrowserWindowInterface()) {
+        TabStripModel* model =
+            tab_strip->GetBrowserWindowInterface()->GetTabStripModel();
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE,
+            base::BindOnce(
+                [](TabStrip* ts, TabStripModel* m, int ws) {
+                  if (!ts || !m) {
+                    return;
+                  }
+                  for (int idx = 0; idx < ts->GetTabCount() && idx < m->count();
+                       ++idx) {
+                    Tab* tab = ts->tab_at(idx);
+                    if (tab && !tab->closing() && GetTabWorkspace(tab) == ws) {
+                      m->ActivateTabAt(idx);
+                      RefreshTabStripLayoutForSpaces(ts);
+                      return;
+                    }
+                  }
+                },
+                base::Unretained(tab_strip), base::Unretained(model),
+                current_ws));
+        return;
+      }
+    }
+
+    st.tabstrip_active_workspace[tab_strip] = new_ws;
+    NotifyVeloxSpacesControls();
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&RefreshTabStripLayoutForSpaces,
+                       base::Unretained(tab_strip)));
+  }
+}
+
