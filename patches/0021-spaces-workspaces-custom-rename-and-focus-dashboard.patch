+  int active_index = browser->tab_strip_model()->active_index();
+  if (active_index < 0 || active_index >= browser->tab_strip_model()->count()) {
+    return;
+  }
+  if (browser->tab_strip_model()->IsTabSplit(active_index)) {
+    browser->tab_strip_model()->ExecuteContextMenuCommand(
+        active_index,
+        TabStripModel::ContextMenuCommand::CommandSeparateSplit);
+  } else {
+    // Only allow split screen if there are at least 2 tabs in the window.
+    if (browser->tab_strip_model()->count() < 2) {
+      return;
+    }
+    browser->tab_strip_model()->ExecuteContextMenuCommand(
+        active_index,
